{
  "id": "climate",
  "name": "Climate & Catastrophe Risk",
  "status": "live",
  "tagline": "The same engine, re-targeted at hazard data for insurers and resilience planners.",
  "blurb": "Second live instance. Reuses the NOAA/NDBC/NHC watchers, routed to climate roles.",
  "dispatch_output": "outbox/climate_desk.json",
  "packager": "packagers/climate_dispatch.py",
  "geography": { "scope": "Hazard-exposed regions (Caribbean basin first)" },
  "pipeline": {
    "watch": "NOAA, NDBC, NHC & hazard feeds — storms, surge, marine conditions in real time.",
    "reason": "Scores exposure and escalates as an event develops toward a threshold.",
    "distribute": "Briefs insurers, reinsurers & resilience planners before impact."
  },
  "sources": [
    { "id": "noaa", "label": "NOAA Weather Alerts", "kind": "hazard", "watcher": "watchers/noaa_nws_poller.py",  "config": "config/noaa_sources.json", "reuses": "caribbean" },
    { "id": "ndbc", "label": "NDBC Marine Buoys",   "kind": "marine", "watcher": "watchers/ndbc_buoy_poller.py", "config": "config/ndbc_sources.json", "reuses": "caribbean" },
    { "id": "nhc",  "label": "NHC Storm Tracks",    "kind": "hazard", "watcher": "watchers/nhc_storm_poller.py", "config": "config/noaa_sources.json", "reuses": "caribbean" },
    { "id": "ccrif", "label": "CCRIF SPC parametric risk data", "kind": "insurance", "watcher": null, "config": null, "note": "candidate public source — not yet wired" }
  ],
  "signals": {
    "config": "config/composite_rules.json",
    "kinds": ["cyclone_risk", "tropical_development", "maritime_hazard"]
  },
  "recipients": {
    "personas": [
      { "id": "insurer",          "label": "Insurer / Reinsurer",   "channel": "Email + alert" },
      { "id": "resilience_planner","label": "Resilience Planner",    "channel": "Telegram/SMS alert" },
      { "id": "operator_resilience","label": "Operations/Resilience", "channel": "Telegram/SMS alert", "reuses": "caribbean" }
    ]
  }
}
