.agents-head p { color: rgba(244,235,221,.66); font-size: 14px; max-width: 560px; margin-bottom: 22px; }
.agents-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
.agents-card { border: 1px solid rgba(244,235,221,.16); border-radius: 8px; padding: 16px; }
.agents-card h4 { font-family: var(--serif); font-size: 16px; margin-bottom: 10px; }
.agents-card pre { font: 11px var(--mono); color: var(--lime); white-space: pre-wrap; overflow-wrap: anywhere; background: rgba(244,235,221,.06); border-radius: 5px; padding: 10px 12px; margin-bottom: 8px; }
.agents-card span { font-size: 11px; color: rgba(244,235,221,.5); }
.agents-foot { margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(244,235,221,.12); font-size: 12px; color: rgba(244,235,221,.6); }
.agents-foot a { color: var(--lime); }
.hw { display: inline-block; opacity: 0; transform: translateY(.55em); animation: word-rise .75s cubic-bezier(.22,1,.36,1) forwards; animation-delay: var(--wd, 0s); }
@keyframes word-rise { to { opacity: 1; transform: translateY(0); } }
.front-lede .sec-label { opacity: 0; animation: word-rise .6s cubic-bezier(.22,1,.36,1) .05s forwards; }
.front-standfirst, .front-cta, .front-pointers, .map-foot { opacity: 0; animation: word-rise .7s cubic-bezier(.22,1,.36,1) .6s forwards; }
.map-shell { opacity: 0; transform: translateY(16px) scale(.992); animation: shell-in .9s cubic-bezier(.22,1,.36,1) .35s forwards; }
@keyframes shell-in { to { opacity: 1; transform: none; } }
.reveal { opacity: 0; transform: translateY(20px); transition: opacity .6s cubic-bezier(.22,1,.36,1), transform .6s cubic-bezier(.22,1,.36,1); }
.reveal.in { opacity: 1; transform: none; }
.stagger-child { opacity: 0; transform: translateY(14px); transition: opacity .55s cubic-bezier(.22,1,.36,1), transform .55s cubic-bezier(.22,1,.36,1); transition-delay: var(--sd, 0s); }
.reveal.in .stagger-child { opacity: 1; transform: none; }
.sec-label::after { content: ""; display: inline-block; width: 0; height: 1px; background: var(--gold); margin-left: 10px; vertical-align: middle; transition: width .7s ease .25s; }
.reveal.in .sec-label::after { width: 36px; }
.out, .aud, .cluster-card { box-shadow: var(--shadow-rest); transition: transform .18s ease, box-shadow .18s ease; }
.out:hover, .cluster-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-raised); }
.vpack { transition: box-shadow .18s ease; }
.vpack:hover { box-shadow: 0 14px 40px rgba(24,37,31,.08); }
.btn { transition: transform .12s ease, box-shadow .15s ease; }
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0) scale(.98); }
.btn-p:hover { box-shadow: 0 8px 24px rgba(24,37,31,.3); }
.ans-sweep { position: relative; overflow: hidden; }
.ans-sweep::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(105deg, transparent 32%, rgba(181,122,34,.12) 46%, transparent 62%); transform: translateX(-130%); animation: ans-sheen 1.15s ease .2s 1 forwards; }
@keyframes ans-sheen { to { transform: translateX(130%); } }
@keyframes theater-in { from { opacity: 0; transform: translateX(-10px); background: rgba(182,199,78,.07); } to { opacity: 1; transform: none; background: transparent; } }
.theater-event { animation: theater-in .4s cubic-bezier(.22,1,.36,1); }
.sig-marker .sig-dot { animation: marker-pop .5s cubic-bezier(.34,1.56,.64,1) both; animation-delay: var(--delay, 0s); }
@keyframes marker-pop { from { transform: scale(0); } to { transform: scale(1); } }
.proof-cell .proof-k { font-variant-numeric: tabular-nums; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal, .stagger-child, .hw, .front-lede .sec-label,
  .front-standfirst, .front-cta, .front-pointers, .map-foot, .map-shell { opacity: 1; transform: none; transition: none; animation: none; }
  .sig-marker .sig-dot, .sig-marker .sig-ring, .ans-sweep::after { animation: none !important; }
}
@media(max-width:768px) {
  .out-grid, .lead-details, .coordination-inner, .decision-shell, .vpack-grid, .market-grid, .market-chart-grid, .news-grid, .map-finance-strip, .map-market-panel, .source-registry-group { grid-template-columns: 1fr; }
  .news-card.lead { grid-column:span 1; }
  .candle-chart-caption { grid-template-columns: 1fr; }
  .candle-chart-meta { justify-items: start; text-align: left; }
  .vpack-col + .vpack-col { border-left: none; }
  .mast-edition { display: none; }
  .mast-inner { align-items: center; flex-wrap: nowrap; gap: 12px; }
  .mast-name { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .mast-links { gap: 12px; flex-wrap: nowrap; flex-shrink: 0; }
  .mast-links a:last-child { display: none; }
  .sig-row { align-items: flex-start; flex-direction: column; }
  .decision-facts { grid-template-columns: 1fr; }
  .decision-fact + .decision-fact { border-left: none; border-top: 1px solid var(--border); padding-left: 0; }
  .coord-arrow { display: none; }
  .proof-line { grid-template-columns: repeat(2, 1fr); }
  .proof-cell { border-bottom: 1px solid var(--border); }
  .map-hero { padding: 26px 0 20px; }
  .front-grid, .live-grid { grid-template-columns: minmax(0, 1fr); }
  .front-grid > *, .live-grid > * { min-width: 0; }
  .theater-head { flex-wrap: wrap; row-gap: 6px; }
  .lw-label { padding: 8px 10px; }
  .front-lede { padding: 0 18px 18px; border-right: none; border-bottom: 3px double var(--border-dark); margin-bottom: 16px; }
  .front-map, .map-foot { padding: 0 12px; }
  .sec-pane { padding: 0 18px; margin-bottom: 24px; }
  .map-legend { justify-content: flex-start; margin-top: 10px; }
  .map-shell, .map-drill { border-radius: 0; border-left: none; border-right: none; }
  #leaflet-map { height: 430px; }
  .theater { padding: 0 0 30px; }
  .theater-shell { border-radius: 0; }
  .theater-event { grid-template-columns: 58px 1fr; }
  .verdict-filter { flex-wrap: wrap; }
  .desknav-inner { padding: 0 12px; }
  .dateline .dl-when { margin-left: 0; width: 100%; }
  .agents-block { border-radius: 0; }
  .receipt-row { grid-template-columns: 1fr; gap: 6px; }
  .receipt-resp { justify-content: flex-start; }
}
.cycle-clock { display: flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 12px; color: var(--sub); margin-left: auto; }
.cycle-clock .clock-item { display: flex; align-items: center; gap: 6px; }
.cycle-clock .clock-label { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
.cycle-clock .clock-value { font-weight: 600; color: var(--text); }
.verdict-filter { display: flex; align-items: center; gap: 8px; padding: 12px 0 8px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.verdict-filter label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); font-weight: 600; margin-right: 4px; }
.verdict-btn { padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid var(--border); background: var(--card); color: var(--text); font-family: var(--sans); transition: all 0.15s; white-space: nowrap; }
.verdict-btn:hover { border-color: var(--teal); color: var(--teal); }
.verdict-btn.active { background: var(--teal); border-color: var(--teal); color: var(--bg); }
.verdict-btn.verified { border-color: var(--teal); color: var(--teal); }
.verdict-btn.verified.active { background: var(--teal); color: var(--bg); }
.verdict-btn.mixed { border-color: var(--gold); color: var(--gold); }
.verdict-btn.mixed.active { background: var(--gold); color: var(--bg); }
.verdict-btn.unverified { border-color: var(--coral); color: var(--coral); }
.verdict-btn.unverified.active { background: var(--coral); color: var(--bg); }
.verdict-count { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-left: 4px; }
.sig-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); gap: 12px; cursor: pointer; transition: background 0.15s; }
.sig-row:hover { background: var(--card-alt); }
.sig-row:last-child { border-bottom: none; }
.sig-main { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
.sig-main strong { display: block; font-size: 14px; font-weight: 600; margin-bottom: 2px; }
.sig-loc { font-size: 12px; color: var(--muted); }
.sig-expand { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid var(--border); border-radius: 50%; background: var(--card); color: var(--muted); font-size: 12px; cursor: pointer; transition: all 0.15s; flex-shrink: 0; }
.sig-expand:hover { border-color: var(--teal); color: var(--teal); transform: rotate(180deg); }
.sig-row.expanded .sig-expand { transform: rotate(180deg); border-color: var(--teal); color: var(--teal); }
.sig-validation { display: none; padding: 16px 0 0; border-top: 1px solid var(--border); margin-top: 8px; animation: expand-in 0.2s ease-out; }
.sig-row.expanded .sig-validation { display: block; }
@keyframes expand-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
.sig-validation-inner { background: var(--card-alt); border: 1px solid var(--border); border-radius: var(--r); padding: 14px; }
.sig-validation-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
.sig-validation-head span { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; color: var(--gold); }
.sig-validation-head h4 { font-family: var(--serif); font-size: 16px; }
.sig-validation-verdict { font-family: var(--mono); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; padding: 4px 10px; border-radius: 4px; }
.sig-validation-verdict.advance { color: var(--teal); background: rgba(31,122,110,0.1); }
.sig-validation-verdict.hold { color: var(--gold); background: rgba(176,137,52,0.12); }
.sig-validation-verdict.reject { color: var(--coral); background: rgba(201,76,76,0.1); }
.sig-validation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.sig-validation-col { min-width: 0; }
.sig-validation-col h5 { font-size: 9px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
.sig-validation-col ul { list-style: none; display: grid; gap: 5px; font-size: 11px; line-height: 1.4; color: var(--sub); }
.sig-validation-col li { overflow-wrap: anywhere; }
.sig-validation-col li strong { color: var(--text); font-weight: 600; }
.sig-validation-col li em { display: block; font-style: normal; font-size: 9.5px; color: var(--muted); margin-top: 2px; }
.sig-freshness { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin-bottom: 10px; }
@media(max-width:768px) { .sig-validation-grid { grid-template-columns: 1fr; } }
/* Legibility floor for micro mono labels */
.lw-label, .lw-kicker, .fp-head, .fp-kicker, .decision-call label, .decision-fact label,
.vpack-head div span, .freshness-pill, .map-finance-chip span, .map-market-panel span,
.map-drill-grid span, .receipt-when span, .route-state, .vpack-tag, .sig-validation-head span,
.sig-validation-verdict, .sig-validation-col h5, .decision-id, .source-registry-head span,
.side-head span, .vpack-questions h4, .vpack-col h4 { font-size: 10.5px; }
.hyp-status { font-size: 9.5px; }

/* Ask desk + map drill components (plain CSS, formerly Tailwind Play utilities) */
@keyframes rise-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.rise-in { animation: rise-in .35s cubic-bezier(.22,1,.36,1) both; }
@keyframes dot-bounce { 0%, 80%, 100% { transform: translateY(0); opacity: .45; } 40% { transform: translateY(-4px); opacity: 1; } }
.drill-card { transition: background .2s ease, transform .2s ease; }
.drill-card:hover { background: var(--card); transform: translateY(-2px); }
.conf-row { margin-top: 8px; display: flex; align-items: center; gap: 8px; }
.conf-track { height: 4px; flex: 1; border-radius: 999px; background: color-mix(in srgb, var(--border) 60%, transparent); overflow: hidden; }
.conf-fill { height: 100%; border-radius: 999px; transition: width .7s ease-out; }
.conf-num { font-family: var(--mono); font-size: 10px; color: var(--muted); }
.ask-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.ask-chip { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--ink); font: 400 12px var(--sans); cursor: pointer; transition: all .15s ease; }
.ask-chip:hover { border-color: var(--teal); color: var(--teal); transform: translateY(-1px); }
.ask-chip:active { transform: translateY(0); }
.ask-chip:disabled { opacity: .4; cursor: default; }
.ask-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-bottom: 12px; }
.ask-input { background: var(--card); border: 1px solid var(--border); color: var(--ink); padding: 8px 12px; border-radius: 4px; font: 400 13px var(--sans); outline: none; transition: border-color .15s ease, box-shadow .15s ease; }
.ask-input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,118,110,.12); }
.ask-send:active { transform: scale(.97); }
.ask-send:disabled { opacity: .6; }
.ask-busy { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: 12px; color: var(--muted); }
.ask-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); animation: dot-bounce 1s ease-in-out infinite; }
.ask-dot:nth-child(2) { animation-delay: .15s; }
.ask-dot:nth-child(3) { animation-delay: .3s; }
.ask-offline { margin-top: 8px; padding: 12px 16px; background: #EAF2EC; border: 1px solid var(--border); border-radius: 4px; font-size: 13px; color: var(--muted); }
.ask-answer { margin-top: 12px; background: var(--card); border-left: 3px solid var(--gold); border-radius: 0 4px 4px 0; padding: 16px; }
.ask-answer.older { opacity: .6; }
.ask-q { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); margin-bottom: 4px; }
.ask-a { font-size: 13px; line-height: 1.65; color: var(--sub); white-space: pre-wrap; max-height: 230px; overflow: auto; }
.ask-note { margin-top: 8px; padding: 12px 16px; font-size: 12px; color: var(--muted); }
@keyframes caret-blink { 50% { opacity: 0; } }
.type-caret { display: inline-block; width: 7px; height: 14px; background: var(--gold); vertical-align: middle; margin-left: 1px; animation: caret-blink 1s step-end infinite; }
.type-caret.done { display: none; }
</style>

<Base title="Signal Fabric — see where the region is moving">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script is:inline src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/htm@3/dist/htm.js"></script>
  </Fragment>

<div id="scroll-progress" aria-hidden="true"></div>

<div class="masthead">
  <div class="mast-edition"><span>Vol. I · Caribbean Edition</span><span>Cycle {d.cycleId} · {d.nowStr}</span></div>
  <div class="mast-inner">
    <div class="mast-name">CARIBBEAN <em>OPPORTUNITY</em> DISPATCH</div>
    <div class="mast-links">
      <a href="#decision-workspace"><span style="color:var(--teal)">●</span> Cycle {d.cycleId}</a>
      <a href="/build">Build your feed</a>
      <a href="/regional-connections">Regional Connections</a>
      <a href="javascript:void(0)" onclick="toggleDeep();return false;">Under the hood</a>
    </div>
  </div>
</div>

<div class="livewire" role="marquee" aria-label="Latest signals from this cycle">
  <span class="lw-label">Live wire</span>
  <div class="lw-track">
    <div class="lw-rail" id="lw-rail"><Fragment set:html={d.tickerHtml} /></div>
    <div class="lw-rail" aria-hidden="true"><Fragment set:html={d.tickerHtml} /></div>
  </div>
</div>

<nav class="desknav" aria-label="Desks">
