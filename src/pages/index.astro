            <div>Markets: {d.nCountries}</div>
          </div>
          <h4 style="font-size:13px;margin:16px 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">Source health states</h4>
          <table class="src-tbl"><tbody>
            {d.srcRows.map(r => (
              <tr class={r.cls}>
                <td><span class="dot">{r.dot}</span>{r.label}</td>
                <td><small>{r.desc}</small></td>
                <td>{r.a} — {r.status}</td>
              </tr>
            ))}
          </tbody></table>
          <h4 style="font-size:13px;margin:16px 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">All responses</h4>
          <div><Fragment set:html={d.fbActionPills} /></div>
        </div>
      </div>
    </div>
  </div>
</div>


<Fragment set:html={`<script>
const D = ${d.analystData};
const MAP_DISPATCHES = ${d.mapDispatchesJson};
const MAP_MARKERS = ${d.mapMarkersJson};
const MAP_MARKER_BY_COUNTRY = Object.fromEntries(MAP_MARKERS.map(m => [m.country, m]));
const NEWS_BY_COUNTRY = ${d.newsByCountryJson};
const THEATER_EVENTS = ${d.theaterEventsJson};
const HUMANIZE_RULES = ${d.humanizeRulesJson}.map(([p, r]) => { try { return [new RegExp(p), r]; } catch (e) { return null; } }).filter(Boolean);
function humanizeJs(t) {
  if (!t) return t;
  let out = String(t);
  HUMANIZE_RULES.forEach(([rx, r]) => { out = out.replace(rx, r); });
  return out;
}
const MAP_COLORS = { investment:'#2676A8', climate:'#0D766E', procurement:'#B57A22', market:'#6F5FA8', none:'#7F8C83' };
const REPLAY_JSONL_URL = ${JSON.stringify(d.replayJsonlUrl)};
const VERDICT_COUNTS = ${d.verdictCountsJson};
const risks = ${d.lRisksJson};
<\/script>`} />

<script is:inline>
let theaterSource = null;
let theaterPaused = false;
let theaterReplayAttempted = false;
let theaterReplayMode = false;
let theaterBuffer = [];

function theaterTime(ts) {
  return new Date((ts || Date.now() / 1000) * 1000).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});
}

function renderTheaterEvent(type, data) {
  if (theaterPaused) {
    theaterBuffer.push([type, data]);
    return;
  }
  const feed = document.getElementById('theater-feed');
  const row = document.createElement('div');
  const eventClass = {source_check:'source', signal_found:'signal', dispatch_routed:'dispatch', cycle_complete:'cycle'}[type] || 'source';
  row.className = 'theater-event event-' + eventClass;
  const time = '<span class="theater-time">' + theaterTime(data.ts) + '</span>';
  if (type === 'source_check') {
    row.innerHTML = time + '<p><span>' + escapeMapText(data.source) + ' ↻</span> ' + escapeMapText(data.status) + '</p>';
  } else if (type === 'signal_found') {
    const color = MAP_COLORS[data.kind] || MAP_COLORS.none;
    row.innerHTML = time + '<p><span style="background:' + color + '">' + escapeMapText(data.kind) + '</span><strong>' + escapeMapText(data.country) + '</strong> · ' + escapeMapText(data.confidence) + '% · ' + escapeMapText(humanizeJs(data.summary)) + '</p>';
  } else if (type === 'dispatch_routed') {
    row.innerHTML = time + '<p><strong>' + escapeMapText(data.recipient) + '</strong> · ' + escapeMapText(data.country) + ' <code>' + escapeMapText(data.dispatch_id) + '</code></p>';
  } else {
    row.innerHTML = '<p>Cycle ' + escapeMapText(data.cycle) + ' complete — ' + escapeMapText(data.signals) + ' signals</p>';
  }
  feed.appendChild(row);
  while (feed.children.length > 50) feed.firstElementChild.remove();
  feed.scrollTop = feed.scrollHeight;
}

function setTheaterMode(mode) {
  const badge = document.getElementById('stream-mode');
  badge.textContent = mode;
  badge.className = 'stream-mode ' + mode.toLowerCase();
}

async function runReplayFromJsonl(jsonlUrl) {
  setTheaterMode('Replay (recorded cycle)');
  theaterReplayMode = true;
  try {
    const res = await fetch(jsonlUrl);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const text = await res.text();
    const lines = text.trim().split('\n').filter(l => l);
    const events = lines.map(l => JSON.parse(l));
    if (!events.length) {
      setTheaterMode('PAUSED');
      return;
    }
    const firstTs = events[0].data?.ts * 1000;
    const startWall = Date.now();
    for (const ev of events) {
      if (theaterPaused) break;
      const evTs = ev.data?.ts * 1000;
      const targetWall = startWall + (evTs - firstTs) / 10;
      const delay = Math.max(0, targetWall - Date.now());
      if (delay > 0) await new Promise(r => setTimeout(r, delay));
      if (theaterPaused) break;
      renderTheaterEvent(ev.event, ev.data);
    }
    setTheaterMode('Replay (recorded cycle)');
  } catch (e) {
    console.warn('Replay failed:', e);
    runReplayFromEmbeddedEvents();
  }
}

async function runReplayFromEmbeddedEvents() {
  if (!Array.isArray(THEATER_EVENTS) || !THEATER_EVENTS.length) {
    setTheaterMode('PAUSED');
    return;
  }
  theaterReplayMode = true;
  setTheaterMode('Replay (recorded cycle)');
  const feed = document.getElementById('theater-feed');
  if (feed) feed.innerHTML = '';
  for (let i = 0; i < THEATER_EVENTS.length; i++) {
    if (theaterPaused) break;
    const ev = THEATER_EVENTS[i];
    renderTheaterEvent(ev.event, ev.data || {});
    await new Promise(r => setTimeout(r, i < 6 ? 420 : 650));
  }
  if (!theaterPaused) setTheaterMode('Replay (recorded cycle)');
}

function connectTheater(replay) {
  if (theaterSource) theaterSource.close();
  const hasLocalApi = ['localhost', '127.0.0.1', '::1'].includes(location.hostname) && location.port !== '4321';
  if (!hasLocalApi) {
    runReplayFromEmbeddedEvents();
    return;
  }
  setTheaterMode(replay ? 'REPLAY' : 'LIVE');
  theaterSource = new EventSource('/api/pipeline/stream' + (replay ? '?replay=1' : ''));
  ['source_check','signal_found','dispatch_routed','cycle_complete'].forEach(type => {
    theaterSource.addEventListener(type, event => {
      try { renderTheaterEvent(type, JSON.parse(event.data)); } catch (_) {}
    });
  });
  theaterSource.onerror = () => {
    theaterSource.close();
    if (!replay && !theaterReplayAttempted) {
      theaterReplayAttempted = true;
      connectTheater(true);
      return;
    }
    if (REPLAY_JSONL_URL && REPLAY_JSONL_URL !== "") {
      runReplayFromJsonl(REPLAY_JSONL_URL);
    } else {
      fetch('/data/history/index.json')
        .then(r => r.ok ? r.json() : null)
        .then(idx => {
          if (idx?.cycles?.length) {
            const latest = idx.cycles[0];
            const dateStr = latest.cycleId.replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3');
            runReplayFromJsonl('/data/history/' + dateStr + '.jsonl');
          } else {
            runReplayFromEmbeddedEvents();
          }
        })
        .catch(() => runReplayFromEmbeddedEvents());
    }
  };
}

document.getElementById('theater-toggle').addEventListener('click', event => {
  theaterPaused = !theaterPaused;
  event.currentTarget.textContent = theaterPaused ? 'Resume' : 'Pause';
  if (theaterPaused) {
    setTheaterMode(theaterReplayMode ? 'Replay (recorded cycle)' : 'PAUSED');
  } else {
    if (theaterReplayMode) {
      setTheaterMode('Replay (recorded cycle)');
      if (REPLAY_JSONL_URL && REPLAY_JSONL_URL !== "") {
        runReplayFromJsonl(REPLAY_JSONL_URL);
      }
    } else {
      setTheaterMode(theaterReplayAttempted ? 'REPLAY' : 'LIVE');
      const pending = theaterBuffer.splice(0);
      pending.forEach(([type, data]) => renderTheaterEvent(type, data));
    }
  }
});
connectTheater(false);

document.querySelectorAll('[data-news-filter]').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('[data-news-filter]').forEach(b => b.classList.toggle('active', b === button));
  const filter = button.dataset.newsFilter || 'all';
  document.querySelectorAll('.news-card').forEach(card => {
    const [kind, value] = filter.split(':');
    card.hidden = filter !== 'all' && !(kind === 'topic' ? (card.dataset.newsTopics || '').split('|').includes(value) : (card.dataset.newsCountries || '').split('|').includes(value));
  });
}));

// Several destinations are collapsed accordions now. An anchor that lands on a
// closed panel looks like a dead link, so opening the target is part of going
// there — for nav clicks, for the desk guide, and for a pasted #hash on load.
function revealTarget(id) {
  const target = id && document.getElementById(id);
  if (!target) return null;
  const panel = target.closest('details') || (target.tagName === 'DETAILS' ? target : target.querySelector('details'));
  if (panel) panel.open = true;
  return target;
}

document.addEventListener('click', event => {
  const link = event.target.closest('a[href^="#"]');
  if (!link) return;
  revealTarget(decodeURIComponent(link.getAttribute('href').slice(1)));
});

if (location.hash) {
  const landed = revealTarget(decodeURIComponent(location.hash.slice(1)));
  if (landed) setTimeout(() => landed.scrollIntoView({ block: 'start' }), 60);
}

// ── Desk guide ────────────────────────────────────────────────────────────
// A navigator first, a Q&A second. Navigation intents resolve here and act on
// the page immediately; anything else goes to /api/ask, the same deterministic
// endpoint the inline "Ask the desk" panel uses. No model runs in the browser.
const GUIDE_PLACES = [
  { id: 'regional-news',      label: 'Regional news desk', terms: ['news', 'headlines', 'stories', 'press', 'wire'] },
  { id: 'decision-workspace', label: "Today's call",       terms: ["today's call", 'todays call', 'the call', 'briefing', 'lead call', 'decision'] },
  { id: 'market-watch',       label: 'Market watch',       terms: ['market', 'markets', 'exchange', 'stocks', 'chart', 'fx'] },
  { id: 'receipts',           label: "The desk's receipts", terms: ['receipts', 'track record', 'accuracy', 'past calls', 'history'] },
  { id: 'map-hero',           label: 'The map',            terms: ['map', 'top', 'start', 'home', 'front page'] },
  { id: 'theater',            label: 'Watch the desk work', terms: ['theater', 'watch the desk', 'live feed', 'stream'] },
  { id: 'about-abeng',       label: 'What is Abeng', terms: ['what is this', 'about', 'how it works', 'explain the site'] },
  { id: 'for-agents',         label: 'Machine-readable edition', terms: ['api', 'agent', 'machine readable', 'json', 'mcp', 'developer'] },
];

const guideEls = {};
let guideBusy = false;

function guideKnownCountries() {
  const fromMap = (typeof MAP_MARKERS !== 'undefined' ? MAP_MARKERS : []).map(m => m.country);
  const fromNews = typeof NEWS_BY_COUNTRY !== 'undefined' ? Object.keys(NEWS_BY_COUNTRY) : [];
  return [...new Set([...fromMap, ...fromNews])].filter(Boolean);
}

function guideMatchCountry(text) {
  const q = text.toLowerCase();
  // Longest name first so "St Kitts & Nevis" is not shadowed by a shorter match.
  return guideKnownCountries()
    .sort((a, b) => b.length - a.length)
    .find(c => q.includes(c.toLowerCase())) || '';
}

function guideSay(role, text, actions) {
  const thread = guideEls.thread;
  if (!thread) return;
  const msg = document.createElement('div');
  msg.className = `guide-msg ${role}`;
  msg.textContent = text;
  if (actions && actions.length) {
    const row = document.createElement('div');
    row.className = 'guide-act';
    for (const action of actions) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = action.label;
      button.addEventListener('click', action.run);
      row.appendChild(button);
    }
    msg.appendChild(row);
  }
  thread.appendChild(msg);
  thread.scrollTop = thread.scrollHeight;
}

function guideGoto(id, label) {
  const target = revealTarget(id);
  if (!target) return false;
  target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  guideSay('desk', `Taking you to ${label}.`);
  return true;
}

function guideOpenCountry(country) {
  openCountryDrill(country);
  document.getElementById('map-drill')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  const stories = (typeof NEWS_BY_COUNTRY !== 'undefined' && NEWS_BY_COUNTRY[country] || []).length;
  const briefings = (typeof MAP_DISPATCHES !== 'undefined' && MAP_DISPATCHES[country] || []).length;
  const parts = [];
  if (briefings) parts.push(`${briefings} briefing${briefings === 1 ? '' : 's'}`);
  if (stories) parts.push(`${stories} ${stories === 1 ? 'story' : 'stories'}`);
  guideSay('desk', `${country} is open on the map — ${parts.length ? parts.join(' and ') + ' this cycle.' : 'watchlist only this cycle.'}`,
    [
      stories ? { label: `${country} news`, run: () => showCountryInNewsDesk(country) } : null,
      { label: isFollowed(country) ? `Unfollow ${country}` : `Follow ${country}`, run: () => { toggleFollow(country); guideSay('desk', isFollowed(country) ? `Following ${country}.` : `No longer following ${country}.`); } },
    ].filter(Boolean));
}

async function guideAskApi(question) {
  guideBusy = true;
  if (guideEls.send) guideEls.send.disabled = true;
  guideSay('desk', 'Checking this cycle’s files…');
  const pending = guideEls.thread?.lastElementChild;
  try {
    const res = await fetch('/api/ask', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question }),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    pending?.remove();
    guideSay('desk', humanizeJs(data.answer) || 'No answer came back for that.');
  } catch {
    pending?.remove();
    guideSay('desk', 'The desk API is not reachable from this copy of the page. Navigation still works — try "show me Guyana" or "take me to market watch".');
  }
  guideBusy = false;
  if (guideEls.send) guideEls.send.disabled = false;
}

function guideHandle(rawInput) {
  const input = (rawInput || '').trim();
  if (!input || guideBusy) return;
  guideSay('you', input);
  const q = input.toLowerCase();

  if (/^(help|what can you do|options)\b/.test(q)) {
    guideSay('desk', 'I can move you around the page and answer questions about this cycle.\nTry: "show me Guyana", "news about Jamaica", "take me to market watch", "follow Belize", "read as investor", or "explain the lead".');
    return;
  }

  const country = guideMatchCountry(q);

  // "news about X" is a different destination from "show me X".
  if (country && /\b(news|headlines|stories|press)\b/.test(q)) {
    showCountryInNewsDesk(country);
    guideSay('desk', `Filtered the news desk to ${country}.`);
    return;
  }
  if (country && /\b(follow|watch|track)\b/.test(q)) {
    if (!isFollowed(country)) toggleFollow(country);
    guideSay('desk', `Following ${country}. It is in your desk bar now.`);
    return;
  }
  if (/\bread(ing)? as\b|\blens\b|\bpersona\b/.test(q)) {
    const select = document.getElementById('lens-select');
    // Match on any distinctive word of the option, so "read as investor" finds
    // "Diaspora Investor" and "operator" finds "Regional Founder/Operator".
    const option = [...(select?.options || [])]
      .filter(o => o.value)
      .map(o => ({
        o,
        hits: o.value.toLowerCase().split(/[^a-z]+/).filter(w => w.length > 3 && q.includes(w)).length,
      }))
      .filter(x => x.hits > 0)
      .sort((a, b) => b.hits - a.hits)[0]?.o;
    if (select && option) {
      select.value = option.value;
      select.dispatchEvent(new Event('change'));
      document.getElementById('deskbar')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      guideSay('desk', `Reading as ${option.value}. Briefings routed to you now lead the map drill.`);
      return;
    }
    guideSay('desk', 'Pick a lens in the desk bar: Diaspora Investor, Ecosystem Builder, Founder / Operator, Procurement Watcher, Policy / Media, or Operations / Resilience.',
      [{ label: 'Open desk bar', run: () => document.getElementById('deskbar')?.scrollIntoView({ behavior: 'smooth', block: 'center' }) }]);
    return;
  }
  // A bare country name, or "show me X", is a map drill.
  if (country && (/\b(show|open|go to|take me|drill|look at)\b/.test(q) || q.split(/\s+/).length <= 3)) {
    guideOpenCountry(country);
    return;
  }
  const place = GUIDE_PLACES.find(p => p.terms.some(t => q.includes(t)));
  if (place && /\b(show|open|go|take me|jump|scroll|where)\b/.test(q)) {
    if (guideGoto(place.id, place.label)) return;
  }
  if (country) { guideOpenCountry(country); return; }
  if (place && guideGoto(place.id, place.label)) return;

  guideAskApi(input);
}

function setupGuide() {
  guideEls.fab = document.getElementById('guide-fab');
  guideEls.panel = document.getElementById('guide-panel');
  guideEls.thread = document.getElementById('guide-thread');
  guideEls.form = document.getElementById('guide-form');
  guideEls.input = document.getElementById('guide-input');
  guideEls.send = document.getElementById('guide-send');
  guideEls.chips = document.getElementById('guide-chips');
  if (!guideEls.fab || !guideEls.panel) return;

  const open = () => {
    guideEls.panel.hidden = false;
    guideEls.fab.setAttribute('aria-expanded', 'true');
    guideEls.input?.focus();
    if (!guideEls.thread.childElementCount) {
      guideSay('desk', 'Ask me about this cycle, or tell me where to go. Say "help" for what I can do.');
    }
  };
  const close = () => {
    guideEls.panel.hidden = true;
    guideEls.fab.setAttribute('aria-expanded', 'false');
    guideEls.fab.focus();
  };

  guideEls.fab.addEventListener('click', open);
  document.getElementById('guide-close')?.addEventListener('click', close);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !guideEls.panel.hidden) close();
  });
  guideEls.form?.addEventListener('submit', e => {
    e.preventDefault();
    const value = guideEls.input.value;
    guideEls.input.value = '';
    guideHandle(value);
  });

  for (const chip of ['Show me Guyana', 'Take me to market watch', 'Explain the lead', 'What changed this cycle?']) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = chip;
    button.addEventListener('click', () => guideHandle(chip));
    guideEls.chips?.appendChild(button);
  }
}

// The guide markup sits at the end of the document, below this script, so wait
// for the parser before wiring it up.
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupGuide);
} else {
  setupGuide();
}

// ── Reader preferences ────────────────────────────────────────────────────
// Persona and followed markets, kept in localStorage. The desk already routes
// one signal to several personas; this lets the reader claim one and have the
// page lead with their lane instead of broadcasting the same order to everyone.
const PREFS_KEY = 'future-caribbean:prefs';
const prefs = (() => {
  try {
    const raw = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}');
    return { lens: raw.lens || '', follows: Array.isArray(raw.follows) ? raw.follows : [] };
  } catch { return { lens: '', follows: [] }; }
})();
function savePrefs() {
  try { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); } catch {}
}
function isFollowed(country) { return prefs.follows.includes(country); }
function toggleFollow(country) {
  const i = prefs.follows.indexOf(country);
  if (i >= 0) prefs.follows.splice(i, 1); else prefs.follows.push(country);
  savePrefs();
  paintFollows();
  renderDrill();
}

function countForLens(lens) {
  if (!lens) return 0;
  return Object.values(MAP_DISPATCHES).flat()
    .filter(d => (d.persona_label || '') === lens).length;
}

function paintLens() {
  const select = document.getElementById('lens-select');
  const hint = document.getElementById('lens-hint');
  if (select) select.value = prefs.lens;
  if (hint) {
    const n = countForLens(prefs.lens);
    hint.textContent = prefs.lens
      ? `${n} briefing${n === 1 ? '' : 's'} routed to you this cycle`
      : 'Pick a lens and the desk leads with your briefings';
  }
}

function paintFollows() {
  const wrap = document.getElementById('follow-chips');
  if (!wrap) return;
  if (!prefs.follows.length) {
    wrap.innerHTML = '<span class="deskbar-none">Tap a country on the map, then Follow.</span>';
    return;
  }
  wrap.textContent = '';
  for (const country of prefs.follows) {
    const stories = (typeof NEWS_BY_COUNTRY !== 'undefined' && NEWS_BY_COUNTRY[country] || []).length;
    const chip = document.createElement('button');
    chip.type = 'button';
    chip.className = 'follow-chip';
    chip.title = `Open ${country}`;
    const name = document.createElement('b');
    name.textContent = country;
    chip.appendChild(name);
    if (stories) {
      const count = document.createElement('i');
      count.textContent = String(stories);
      chip.appendChild(count);
    }
    chip.addEventListener('click', () => {
      openCountryDrill(country);
      document.getElementById('map-drill')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    wrap.appendChild(chip);
  }
}

document.getElementById('lens-select')?.addEventListener('change', event => {
  prefs.lens = event.target.value;
  savePrefs();
  paintLens();
  renderDrill();
});

// Bridge from the map drill to the news desk: apply the country filter, open
// the country chip row if it is collapsed, and scroll the reader to the board.
function showCountryInNewsDesk(country) {
  const button = document.querySelector(`[data-news-filter="country:${CSS.escape(country)}"]`);
  const wrap = document.getElementById('news-countries');
  const toggle = document.getElementById('news-country-toggle');
  if (wrap && wrap.hasAttribute('hidden')) {
    wrap.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  }
  if (button) button.click();
  document.getElementById('regional-news')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Regional movement strip: tapping a country chip opens the same map-drill
// that the leaflet marker click does. We scroll into view so the user lands
// on the relevant triage panel.
document.querySelectorAll('.rmv-chip').forEach(chip => {
  chip.addEventListener('click', () => {
    const country = chip.dataset.country;
    if (!country) return;
    openCountryDrill(country);
    document.getElementById('map-drill')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
});

// Track filter: show only chips matching the selected Opportunity vs
// Dislocation/Risk track. The track is a pure function of the signal kind,
// carried on each chip as data-track, so filtering never reclassifies.
const trackBtns = document.querySelectorAll('.track-btn');
trackBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.trackFilter || 'all';
    trackBtns.forEach(b => b.classList.toggle('is-active', b === btn));
    document.querySelectorAll('.rmv-chip').forEach(chip => {
      const t = chip.dataset.track || 'unclassified';
      chip.hidden = !(filter === 'all' || t === filter);
    });
  });
});

function escapeMapText(value) {
  const node = document.createElement('span');
  node.textContent = value == null ? '' : String(value);
  return node.innerHTML;
}

const drillReact = (function () {
  if (typeof React === 'undefined' || typeof ReactDOM === 'undefined' || typeof htm === 'undefined') return null;
  const html = htm.bind(React.createElement);

  function safeExternalUrl(value) {
    try {
      const url = new URL(String(value || ''), window.location.origin);
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch {
      return '';
    }
  }

  function FollowButton({ country }) {
    const on = typeof isFollowed === 'function' && isFollowed(country);
    return html`
      <button
        type="button"
        class=${`drill-follow${on ? ' on' : ''}`}
        aria-pressed=${on ? 'true' : 'false'}
        onClick=${() => toggleFollow(country)}>
        ${on ? '\u2713 Following' : 'Follow'}
      </button>`;
  }

  // The drill used to show three bare links from the marker payload. It now
  // serves the news desk's own stories for the country, so tapping the map is a
  // way to read a country — news beside data — not just a signal readout.
  function CountryNews({ country, marker }) {
    const desk = (typeof NEWS_BY_COUNTRY !== 'undefined' && NEWS_BY_COUNTRY[country]) || [];
    const fallback = (marker.news || []).map(item => ({
      title: item.title, url: item.url, source: item.source, age: '', topic: '', tier: '',
    }));
    const stories = (desk.length ? desk : fallback)
      .map((item, index) => ({ ...item, href: safeExternalUrl(item.url), key: item.url || `${item.title}-${index}` }))
      .filter(item => item.href);

    if (!stories.length) {
      return html`
        <div class="drill-news">
          <div class="drill-news-head"><strong>In the news</strong></div>
          <p class="drill-news-empty">No ${country} coverage in this cycle. The desk keeps watching.</p>
        </div>`;
    }
    return html`
      <div class="drill-news">
        <div class="drill-news-head">
          <strong>In the news</strong>
          <span>${stories.length} ${stories.length === 1 ? 'story' : 'stories'}</span>
        </div>
        <ul class="drill-news-list">
          ${stories.slice(0, 5).map(item => html`
            <li key=${item.key}>
              <a href=${item.href} target="_blank" rel="noopener noreferrer">${item.title || 'Open coverage'}</a>
              <span>${[item.source, item.age].filter(Boolean).join(' · ')}</span>
            </li>`)}
        </ul>
        ${desk.length > 5
          ? html`<button type="button" class="drill-news-more" onClick=${() => showCountryInNewsDesk(country)}>
              All ${desk.length} ${country} stories →
            </button>`
          : null}
      </div>`;
  }

  function LifecyclePanel({ marker }) {
    const evidence = marker.evidence_mix || { wb: 0, idb: 0, noaa: 0, ndbc: 0, caricom: 0, cdb: 0 };
    const sourceKeys = ['wb', 'idb', 'noaa', 'ndbc', 'caricom', 'cdb'];
    const sourceLabels = { wb: 'World Bank', idb: 'IDB', noaa: 'NOAA', ndbc: 'NDBC', caricom: 'CARICOM', cdb: 'CDB' };
    const sourceColors = { wb: 'sea', idb: 'reef', noaa: 'storm', ndbc: 'sun', caricom: 'sand', cdb: 'reef' };
    const evidenceTotal = sourceKeys.reduce((sum, key) => sum + (Number(evidence[key]) || 0), 0);
    const evidencePct = key => evidenceTotal > 0
      ? Math.round(100 * (Number(evidence[key]) || 0) / evidenceTotal)
      : 0;
    const lifecycle = marker.lifecycle || { last_seen: 'unknown', cadence: 'Cadence not supplied', scope: 'Source status', freshness: 'stale' };
    const freshnessClass = marker.freshness_state === 'current'
      ? 'fresh'
      : marker.freshness_state === 'delayed'
        ? 'aging'
        : 'stale';
    return html`
      <div class="drill-lifecycle" data-freshness=${freshnessClass}>
        <div class="drill-lifecycle-head">
          <span class="drill-lifecycle-label">${lifecycle.scope || 'Source status'}</span>
          <span class="drill-lifecycle-state drill-lifecycle-state--${freshnessClass}">${lifecycle.freshness || freshnessClass}</span>
        </div>
        <div class="drill-lifecycle-fields">
          <span class="drill-lifecycle-key">${lifecycle.time_label || 'Observed'}</span>
          <span class="drill-lifecycle-val">${lifecycle.last_seen || 'unknown'}</span>
          <span class="drill-lifecycle-key">Update cadence</span>
          <span class="drill-lifecycle-val">${lifecycle.cadence || 'Scheduled every 4h'}</span>
        </div>
        <div class="drill-evidence">
          <span class="drill-lifecycle-key">
            ${evidenceTotal > 0
              ? `Confirmed source groups (${evidenceTotal})`
              : 'No corroborating signal sources yet'}
          </span>
          ${evidenceTotal > 0
            ? html`
                <div class="drill-evidence-bar" role="img" aria-label=${`${evidenceTotal} confirmed source group${evidenceTotal === 1 ? '' : 's'}`}>
                  ${sourceKeys.filter(key => Number(evidence[key]) > 0).map(key => html`
                    <span
                      key=${key}
                      class="drill-evidence-seg"
                      data-key=${key}
                      style=${{ width: evidencePct(key) + '%', background: `var(--caribbean-${sourceColors[key]})` }}
                      title=${`${sourceLabels[key]}: ${evidence[key] || 0}`}
                    ></span>`)}
                </div>`
            : html`<p class="drill-evidence-empty">Watchlist context only; no source family is being claimed as corroboration.</p>`}
        </div>
      </div>`;
  }

  function DrillPanel({ country }) {
    if (!country) return html`<p class="map-drill-empty">Tap a country to see what the desk found.</p>`;
    const items = MAP_DISPATCHES[country] || [];
    const marker = MAP_MARKER_BY_COUNTRY[country] || {};
    const fx = marker.fx || {};
    const market = marker.market || {};
    const snapshot = market.snapshot || {};
    const marketLabel = market.code ? `${market.code} · ${snapshot.headline || market.name || 'Market watch'}` : 'No domestic exchange / watchlist';
    if (!items.length) {
      return html`
        <div class="rise-in">
          <div class="map-drill-head"><strong>${country}</strong><${FollowButton} country=${country} /></div>
          <div class="map-market-panel">
            <div><span>FX indicator</span><strong>${fx.pair || '—'}</strong><p>${fx.rate_label || 'Watch'} · ${fx.indicator || 'FX watch'}</p></div>
            <div><span>Market layer</span><strong>${marketLabel}</strong><p>${snapshot.data_status || market.status || 'source watch'} </p></div>
            <div><span>Finance signal</span><strong>${snapshot.focus || fx.signal || 'Signals, official notices, and local context'}</strong><p>${marker.finance_signal || marker.ranking_rationale || 'Ranking appears when a live signal is active.'}</p></div>
          </div>
          <${LifecyclePanel} marker=${marker} />
          <${CountryNews} country=${country} marker=${marker} />
          <div class="map-drill-grid">
            <article>
              <span>WATCHLIST · ${marker.confidence || 0}/100</span>
              <h3>${marker.summary || 'Regional market watch'}</h3>
              <p>${marker.ranking_rationale || 'Nothing confirmed yet. We watch official notices, currency pressure, and market sources on this island, and a briefing goes out the moment two sources agree.'}</p>
            </article>
          </div>
        </div>`;
    }
    return html`
      <div class="rise-in">
        <div class="map-drill-head">
          <strong>${country}</strong>
          <${FollowButton} country=${country} />
        </div>
        <div class="map-market-panel">
          <div><span>FX indicator</span><strong>${fx.pair || '—'}</strong><p>${fx.rate_label || 'Watch'} · ${fx.indicator || 'FX watch'}</p></div>
          <div><span>Market layer</span><strong>${marketLabel}</strong><p>${snapshot.data_status || market.status || 'source watch'} </p></div>
          <div><span>Finance signal</span><strong>${snapshot.focus || fx.signal || 'Signals, official notices, and local context'}</strong><p>${marker.finance_signal || marker.ranking_rationale || 'Ranking appears when a live signal is active.'}</p></div>
        </div>
        <${LifecyclePanel} marker=${marker} />
        <${CountryNews} country=${country} marker=${marker} />
        <div class="map-drill-grid">
          ${(() => {
            // A reader with a lens sees their own lane first; everyone else
            // keeps the desk's order.
            const lens = (typeof prefs !== 'undefined' && prefs.lens) || '';
            const ordered = lens
              ? [...items].sort((a, b) =>
                  ((b.persona_label || '') === lens ? 1 : 0) - ((a.persona_label || '') === lens ? 1 : 0))
              : items;
            // One signal routed to six personas rendered as six identical cards.
            // Keep the first, and carry the other recipients on it, so the panel
            // says "also routed to" instead of repeating itself.
            const byTitle = new Map();
            for (const d of ordered) {
              const key = (d.title || '').trim().toLowerCase();
              if (!byTitle.has(key)) byTitle.set(key, { ...d, alsoRouted: [] });
              else {
                const seen = byTitle.get(key);
                const who = d.persona_label || '';
                if (who && who !== seen.persona_label && !seen.alsoRouted.includes(who)) seen.alsoRouted.push(who);
              }
            }
            return [...byTitle.values()].slice(0, 6);
          })().map((d, index) => {
            const rawConfidence = Number(d.confidence_score);
            const conf = Number.isFinite(rawConfidence) ? Math.max(0, Math.min(100, rawConfidence)) : 0;
            const mine = !!((typeof prefs !== 'undefined' && prefs.lens) && (d.persona_label || '') === prefs.lens);
            const color = MAP_COLORS[(d.signal_kind || '').includes('invest') ? 'investment' : (d.signal_kind || '').includes('climate') ? 'climate' : (d.signal_kind || '').includes('procure') ? 'procurement' : 'none'];
            return html`
              <article key=${d.dispatch_id || index} class=${`rise-in drill-card${mine ? ' for-you' : ''}`} style=${{ animationDelay: `${index * 70}ms` }}>
                <span>
                  ${d.dispatch_id || 'Dispatch'} · ${d.persona_label || 'Desk recipient'}
                  ${mine ? html`<span class="for-you-tag">For you</span>` : null}
                </span>
                <h3>${d.title || 'Opportunity briefing'}</h3>
                <p>${d.recommended_action || 'Open the supporting evidence before acting.'}</p>
                ${d.alsoRouted && d.alsoRouted.length
                  ? html`<p class="drill-also">Also routed to ${d.alsoRouted.join(', ')}</p>`
                  : null}
                <div class="conf-row">
                  <div class="conf-track" role="img" aria-label=${`Confidence: ${conf} of 100`}>
                    <div class="conf-fill" style=${{ width: `${conf}%`, background: color }}></div>
                  </div>
                  <span class="conf-num">${conf}/100</span>
                </div>
              </article>`;
          })}
        </div>
      </div>`;
  }

  const node = document.getElementById('map-drill');
  if (!node) return null;
  const root = ReactDOM.createRoot(node);
  root.render(html`<${DrillPanel} country=${null} />`);
  return { render: c => root.render(html`<${DrillPanel} country=${c} />`) };
})();

// Current drill selection, so a preference change can repaint the open panel
// without the reader having to tap the country again.
let drillCountry = null;
function renderDrill() {
  if (drillReact) drillReact.render(drillCountry);
}

function openCountryDrill(country) {
  drillCountry = country;
  document.querySelectorAll('.sig-marker').forEach(x => x.classList.toggle('selected', x.dataset.country === country));
  if (drillReact) { drillReact.render(country); return; }
  const items = MAP_DISPATCHES[country] || [];
  const marker = MAP_MARKER_BY_COUNTRY[country] || {};
  const drill = document.getElementById('map-drill');
  drill.innerHTML = '<div class="map-drill-head"><strong>' + escapeMapText(country) + '</strong><span>' + items.length + ' dispatches</span></div>' +
    (items.length ? '<div class="map-drill-grid">' + items.slice(0, 6).map(d => '<article><span>' + escapeMapText(d.dispatch_id) + ' · ' + escapeMapText(d.persona_label) + '</span><h3>' + escapeMapText(d.title) + '</h3><p>' + escapeMapText(d.recommended_action) + '</p></article>').join('') + '</div>'
                 : '<div class="map-drill-grid"><article><span>WATCHLIST · ' + escapeMapText(marker.confidence || 0) + '/100</span><h3>' + escapeMapText(marker.summary || 'Regional market watch') + '</h3><p>' + escapeMapText(marker.ranking_rationale || 'Nothing confirmed yet — we watch official notices, currency pressure, and market sources here.') + '</p></article></div>');
}

const mapMarkerRefs = {};

function sigIcon(entry, idx) {
  const conf = Math.max(0, Math.min(100, entry.confidence || 0));
  const d = Math.round(14 + conf / 100 * 14);
  const color = MAP_COLORS[entry.kind] || MAP_COLORS.none;
  const quiet = entry.kind === 'none' || conf === 0 ? ' quiet' : '';
  return L.divIcon({
    className: '',
    iconSize: [d, d],
    iconAnchor: [d / 2, d / 2],
    html: '<div class="sig-marker' + quiet + '" data-country="' + escapeMapText(entry.country) + '"' +
          ' style="--c:' + color + ';--delay:' + (idx % 3) * 0.85 + 's;width:' + d + 'px;height:' + d + 'px">' +
          '<span class="sig-ring"></span><span class="sig-dot"></span></div>'
  });
}

function sigTip(entry) {
  const fx = entry.fx || {};
  const market = entry.market || {};
  const marketLine = market.code ? '<br><em>' + escapeMapText(market.code) + ' · ' + escapeMapText((market.snapshot || {}).headline || market.name || 'market watch') + '</em>' : '';
  const fxLine = fx.pair ? '<br><em>FX ' + escapeMapText(fx.pair) + ' · ' + escapeMapText(fx.rate_label || 'watch') + '</em>' : '';
  return '<strong>' + escapeMapText(entry.country) + '</strong>' +
         escapeMapText(entry.summary || entry.top_signal_summary || 'On the watchlist — no current signal') + fxLine + marketLine;
}

function renderMapFallback() {
  const shell = document.querySelector('.map-shell');
  // The expand control lives inside the shell, so lift it out before the
  // fallback overwrites the shell's contents and put it back after.
  const expand = shell.querySelector('.map-expand');
  shell.innerHTML = '<div class="map-fallback">' + MAP_MARKERS.map(m =>
    '<button data-country="' + escapeMapText(m.country) + '" style="--c:' + (MAP_COLORS[m.kind] || MAP_COLORS.none) + '"><i></i>' + escapeMapText(m.country) + '</button>'
  ).join('') + '</div>';
  shell.querySelectorAll('button').forEach(b => b.addEventListener('click', () => openCountryDrill(b.dataset.country)));
  if (expand) shell.appendChild(expand);
}

// Expanded map. Rather than building a second Leaflet instance, the live
// .map-shell and #map-drill are moved into the overlay and returned to
// placeholder comments on close — markers, zoom and the current selection all
// survive because it is the same map the whole time.
let leafletMap = null;

function setupMapOverlay() {
  const overlay = document.getElementById('map-overlay');
  const stage = document.getElementById('map-overlay-stage');
  const openBtn = document.getElementById('map-expand');
  const closeBtn = document.getElementById('map-overlay-close');
  const shell = document.querySelector('.map-shell');
  const drill = document.getElementById('map-drill');
  if (!overlay || !stage || !openBtn || !closeBtn || !shell || !drill) return;

  const shellHome = document.createComment('map-shell');
  const drillHome = document.createComment('map-drill');
  let lastFocus = null;

  // Reframe rather than just resize. invalidateSize alone keeps the old zoom,
  // so expanding just revealed more ocean around the same-sized islands
  // instead of showing the region larger.
  function reframe() {
    if (!leafletMap) return;
    leafletMap.invalidateSize();
    const points = (typeof MAP_MARKERS !== 'undefined' ? MAP_MARKERS : []).map(m => [m.lat, m.lng]);
    if (points.length) leafletMap.fitBounds(L.latLngBounds(points).pad(0.18), { animate: false });
  }

  function openOverlay() {
    if (!overlay.hidden) return;
    lastFocus = document.activeElement;
    shell.before(shellHome);
    drill.before(drillHome);
    stage.append(shell, drill);
    overlay.hidden = false;
    document.body.classList.add('map-overlay-open');
    openBtn.setAttribute('aria-expanded', 'true');
    // The page behind is locked, so the wheel belongs to the map now.
    if (leafletMap) leafletMap.scrollWheelZoom.enable();
    requestAnimationFrame(() => { reframe(); closeBtn.focus(); });
  }

  function closeOverlay() {
    if (overlay.hidden) return;
    shellHome.replaceWith(shell);
    drillHome.replaceWith(drill);
    overlay.hidden = true;
    document.body.classList.remove('map-overlay-open');
    openBtn.setAttribute('aria-expanded', 'false');
    if (leafletMap) leafletMap.scrollWheelZoom.disable();
    requestAnimationFrame(reframe);
    (lastFocus instanceof HTMLElement ? lastFocus : openBtn).focus();
  }

  openBtn.addEventListener('click', openOverlay);
  closeBtn.addEventListener('click', closeOverlay);
  overlay.addEventListener('mousedown', event => { if (event.target === overlay) closeOverlay(); });
  addEventListener('resize', () => { if (!overlay.hidden) reframe(); });
  document.addEventListener('keydown', event => {
    if (overlay.hidden) return;
    if (event.key === 'Escape') { event.preventDefault(); closeOverlay(); return; }
    if (event.key !== 'Tab') return;
    const focusable = [...overlay.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')]
      .filter(el => el.offsetWidth || el.offsetHeight || el === document.activeElement);
    if (!focusable.length) return;
    const first = focusable[0], last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
}

if (typeof L !== 'undefined') {
  const map = L.map('leaflet-map', {
    minZoom: 4, maxZoom: 9,
    scrollWheelZoom: false,
    maxBounds: [[-2, -98], [32, -42]], maxBoundsViscosity: 0.8,
    attributionControl: true
  });
  map.fitBounds(L.latLngBounds(MAP_MARKERS.map(m => [m.lat, m.lng])).pad(0.18));
  // CARTO's keyless raster tiles now return an "API KEY REQUIRED" watermark
  // instead of map imagery, which stamped that text across the homepage map.
  // Esri's World Light Gray Canvas is keyless and muted, so the signal pulses
  // stay the loudest thing on the map.
  L.tileLayer('https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
    attribution: 'Tiles &copy; <a href="https://www.esri.com/">Esri</a> &mdash; Esri, DeLorme, NAVTEQ',
    maxZoom: 9
  }).addTo(map);
  leafletMap = map;

  MAP_MARKERS.forEach((entry, idx) => {
    const m = L.marker([entry.lat, entry.lng], { icon: sigIcon(entry, idx), keyboard: true, title: entry.country });
    m.bindTooltip(sigTip(entry), { className: 'sig-tip', direction: 'top', offset: [0, -10], opacity: 1 });
    m.on('click', () => {
      openCountryDrill(entry.country);
      map.flyTo([entry.lat, entry.lng], Math.max(map.getZoom(), 6), { duration: 0.7 });
      if (innerWidth < 800) {
        const drill = document.getElementById('map-drill');
        if (drill) setTimeout(() => drill.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 350);
      }
    });
    m.addTo(map);
    mapMarkerRefs[entry.country] = { marker: m, idx };
  });

  fetch('/api/map-data').then(r => r.ok ? r.json() : null).then(entries => {
    if (!entries) return;
    entries.forEach(entry => {
      const ref = mapMarkerRefs[entry.country];
      if (!ref) return;
      const current = MAP_MARKER_BY_COUNTRY[entry.country] || {};
      const merged = { ...current, country: entry.country, confidence: entry.confidence, kind: entry.kind, summary: entry.top_signal_summary || current.summary, ranking_rationale: entry.ranking_rationale || current.ranking_rationale };
      ref.marker.setIcon(sigIcon(merged, ref.idx));
      ref.marker.setTooltipContent(sigTip(merged));
    });
  }).catch(() => {});
} else {
  renderMapFallback();
}

setupMapOverlay();

if (risks.length) {
  document.getElementById('risk-area').innerHTML = '<div class="lead-risk">⚠️ ' + risks[0] + '</div>';
}

// Keyed by market, not by cycle: diligence on Guyana is still diligence on
// Guyana next cycle, so progress should survive the desk moving on.
const checklistCountry = (D.lead && D.lead.country) || 'region';
const checklistKey = 'future-caribbean:checks:' + checklistCountry;
const savedChecks = JSON.parse(localStorage.getItem(checklistKey) || '[]');
const checkItems = [...document.querySelectorAll('#lead-checklist .check-item')];
const checkProgress = document.getElementById('check-progress');

function paintChecklist() {
  const done = checkItems.filter(x => x.classList.contains('done'));
  if (checkProgress) checkProgress.textContent = done.length + ' of ' + checkItems.length + ' done for ' + checklistCountry;
  return done.map(x => x.dataset.check);
}

checkItems.forEach(item => {
  const on = savedChecks.includes(item.dataset.check);
  item.classList.toggle('done', on);
  item.setAttribute('aria-checked', String(on));
  const toggle = () => {
    const next = !item.classList.contains('done');
    item.classList.toggle('done', next);
    item.setAttribute('aria-checked', String(next));
    localStorage.setItem(checklistKey, JSON.stringify(paintChecklist()));
  };
  item.addEventListener('click', toggle);
  item.addEventListener('keydown', e => {
    if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
  });
});
paintChecklist();

paintLens();
paintFollows();

// Chart bars carry their reading in an SVG <title>, which touch devices never
// surface. Mirror it into a live readout under the chart.
document.querySelectorAll('.market-chart-card').forEach(card => {
  const readout = card.querySelector('.activity-readout');
  const cols = [...card.querySelectorAll('.activity-col')];
  if (!readout || !cols.length) return;
  const show = col => {
    cols.forEach(c => c.classList.toggle('picked', c === col));
    // The card already carries the "not a price" disclosure; no need to repeat it here.
    readout.textContent = (col.querySelector('title')?.textContent || '').replace(/\s*Not a price\.\s*$/, '');
    readout.classList.add('on');
  };
  cols.forEach(col => {
    col.addEventListener('click', () => show(col));
    col.addEventListener('focus', () => show(col));
  });
});

const countryToggle = document.getElementById('news-country-toggle');
const countryWrap = document.getElementById('news-countries');
if (countryToggle && countryWrap) {
  countryToggle.addEventListener('click', () => {
    const open = countryWrap.hasAttribute('hidden');
    if (open) countryWrap.removeAttribute('hidden'); else countryWrap.setAttribute('hidden', '');
    countryToggle.setAttribute('aria-expanded', String(open));
  });
}

const outTabs = [...document.querySelectorAll('.out-tab')];
const outPanels = [...document.querySelectorAll('.out-panel')];
const outCopy = document.getElementById('out-copy');

function selectOut(name, focus) {
  outTabs.forEach(t => {
    const on = t.dataset.out === name;
    t.classList.toggle('active', on);
    t.setAttribute('aria-selected', String(on));
    t.tabIndex = on ? 0 : -1;
    if (on && focus) t.focus();
  });
  outPanels.forEach(p => { p.hidden = p.dataset.out !== name; });
  if (outCopy) outCopy.textContent = 'Copy to clipboard';
}

outTabs.forEach((tab, i) => {
  tab.addEventListener('click', () => selectOut(tab.dataset.out));
  tab.addEventListener('keydown', e => {
    const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (!step) return;
    e.preventDefault();
    selectOut(outTabs[(i + step + outTabs.length) % outTabs.length].dataset.out, true);
  });
});

if (outCopy) {
  outCopy.addEventListener('click', async () => {
    const panel = outPanels.find(p => !p.hidden);
    if (!panel) return;
    try {
      await navigator.clipboard.writeText(panel.querySelector('.out-body').textContent.trim());
      outCopy.textContent = 'Copied';
    } catch {
      outCopy.textContent = 'Selected — copy it';
      const r = document.createRange();
      r.selectNodeContents(panel.querySelector('.out-body'));
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
    }
    setTimeout(() => { outCopy.textContent = 'Copy to clipboard'; }, 2000);
  });
}

function toggleDeep() {
  const c = document.getElementById('dc'); const b = document.getElementById('db');
  if (c.classList.contains('open')) { c.classList.remove('open'); b.textContent = '▸ System audit'; }
  else { c.classList.add('open'); b.textContent = '▾ System audit'; c.scrollIntoView({behavior:'smooth'}); }
}

window.ask = function(q) {
  const box = document.getElementById('da');
  if (!q) { box.textContent = 'Select a prompt or ask a question.'; return; }
  const d = D.lead; const l = q.toLowerCase();
  if (l === 'explain' || l.includes('lead') || l.includes('first')) {
    box.textContent = 'Lead: ' + d.title + '\n\n' + D.thesis + '\n\nEvidence: ' + d.evidence + '\nAudiences:\n' + d.personas.slice(0,3).map(p => '• ' + p.persona + ': ' + p.action.substring(0,80) + '…').join('\n');
  } else if (l.includes('investor')) {
    box.textContent = 'Investor receives:\n\n"' + d.title + '.\n\n' + (D.thesis.length > 120 ? D.thesis.substring(0,120) + '…' : D.thesis) + '\n\nNext: Validate ' + d.country + '. Screen sector fit, partners, timing.\n\nScreening signal, not investment advice."';
  } else if (l.includes('what changed') || l.includes('changed')) {
    box.textContent = 'Cycle ' + D.cycle + ':\n\n• ' + D.signals + ' regional signals\n• ' + D.dispatches + ' dispatches routed\n\n' + D.thesis;
  } else if (l.includes('guyana') || l.includes('lead country') || l.includes('why')) {
    box.textContent = d.country + ' leads (High confidence).\n\n' + d.evidence + (d.pct ? ' (' + d.pct + ')' : '') + '\n\nCompare against secondary signals before committing.';
  } else if (l.includes('draft') || l.includes('note')) {
    box.textContent = 'Draft:\n\nSubject: ' + d.country + ' signal worth reviewing\n\n' + d.title + '.\n' + d.evidence + (d.pct ? ' (' + d.pct + ')' : '') + '\n\nNext: Validate sector fit, local partners, timing.\n\nScreening signal, not investment advice.';
  } else {
    box.textContent = 'Try: explain lead · investor view · what changed · why ' + d.country + ' · draft a note';
  }
  box.scrollTop = 0;
};

(function () {
  if (typeof React === 'undefined' || typeof ReactDOM === 'undefined' || typeof htm === 'undefined') return;
  const html = htm.bind(React.createElement);
  const { useState, useRef, useEffect } = React;
  const CHIPS = [
    'Explain the lead signal', 'What changed this cycle?',
    'Routes for diaspora investor', 'Draft a note for Guyana',
  ];

  function Typewriter({ text }) {
    const [shown, setShown] = useState(0);
    useEffect(() => {
      setShown(0);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { setShown(text.length); return; }
      const step = Math.max(2, Math.round(text.length / 90));
      const t = setInterval(() => setShown(s => {
        if (s >= text.length) { clearInterval(t); return s; }
        return s + step;
      }), 13);
      return () => clearInterval(t);
    }, [text]);
    return html`<span>${text.slice(0, shown)}<span class="type-caret ${shown < text.length ? '' : 'done'}"></span></span>`;
  }

  function AskDesk() {
    const [q, setQ] = useState('');
    const [thread, setThread] = useState([]);
    const [busy, setBusy] = useState(false);
    const [offline, setOffline] = useState(false);
    const inputRef = useRef(null);

    async function ask(question) {
      const query = (question || '').trim();
      if (!query || busy) return;
      setBusy(true); setOffline(false); setQ('');
      try {
        const res = await fetch('/api/ask', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: query }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        setThread(t => [{ q: query, a: humanizeJs(data.answer) || 'No answer returned.', at: data.generated_at }, ...t].slice(0, 3));
      } catch (e) {
        setOffline(true);
      }
      setBusy(false);
    }

    return html`
      <div>
        <div class="ask-chips">
          ${CHIPS.map(c => html`
            <button key=${c} onClick=${() => ask(c)} disabled=${busy} class="ask-chip">
              ${c}
            </button>`)}
        </div>
        <div class="ask-row">
          <input ref=${inputRef} value=${q}
            onInput=${e => setQ(e.target.value)}
            onKeyDown=${e => { if (e.key === 'Enter') ask(q); }}
            placeholder="Ask about a country, a signal, or what to do next…"
            class="ask-input" />
          <button onClick=${() => ask(q)} disabled=${busy} class="btn btn-p ask-send">
            ${busy ? 'Asking…' : 'Ask'}
          </button>
        </div>
        ${busy && html`
          <div class="ask-busy rise-in">
            <span class="ask-dot"></span>
            <span class="ask-dot"></span>
            <span class="ask-dot"></span>
            pulling today's files
          </div>`}
        ${offline && html`
          <div class="ask-offline rise-in">
            The desk can't be reached from this copy of the page — try the live site at abeng.vercel.app.
          </div>`}
        ${thread.map((m, i) => html`
          <div key=${m.at + m.q} class="ask-answer rise-in ${i > 0 ? 'older' : 'ans-sweep'}">
            <div class="ask-q">You asked · ${m.q}</div>
            <div class="ask-a">
              ${i === 0 ? html`<${Typewriter} text=${m.a} />` : m.a}
            </div>
          </div>`)}
        ${!thread.length && !busy && !offline && html`
          <div class="ask-note">Every answer is pulled word-for-word from this cycle's files — so you can always check the receipts.</div>`}
      </div>`;
  }

  const askRoot = document.getElementById('ask-desk-root');
  if (askRoot) ReactDOM.createRoot(askRoot).render(html`<${AskDesk} />`);
})();

