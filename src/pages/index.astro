/* Ask desk + map drill components (plain CSS, formerly Tailwind Play utilities) */
@keyframes rise-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.rise-in { animation: rise-in .35s cubic-bezier(.22,1,.36,1) both; }
@keyframes dot-bounce { 0%, 80%, 100% { transform: translateY(0); opacity: .45; } 40% { transform: translateY(-4px); opacity: 1; } }
.drill-card { transition: background .2s ease, transform .2s ease; }
.drill-card:hover { background: var(--card); }
.conf-row { margin-top: 8px; display: flex; align-items: center; gap: 8px; }
.conf-track { height: 4px; flex: 1; border-radius: 999px; background: color-mix(in srgb, var(--border) 60%, transparent); overflow: hidden; }
.conf-fill { height: 100%; border-radius: 999px; transition: width .7s ease-out; }
.conf-num { font-family: var(--mono); font-size: 10px; color: var(--muted); }
.ask-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.ask-chip { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--ink); font: 400 12px var(--sans); cursor: pointer; transition: all .15s ease; }
.ask-chip:hover { border-color: var(--teal); color: var(--teal); }
.ask-chip:active { transform: translateY(0); }
.ask-chip:disabled { opacity: .4; cursor: default; }
.ask-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-bottom: 12px; }
.ask-input { background: var(--card); border: 1px solid var(--border); color: var(--ink); padding: 8px 12px; border-radius: 4px; font: 400 13px var(--sans); outline: none; transition: border-color .15s ease, box-shadow .15s ease; }
.ask-input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,82,87,.12); }
.ask-send:active { transform: scale(.97); }
.ask-send:disabled { opacity: .6; }
.ask-busy { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: 12px; color: var(--muted); }
.ask-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); animation: dot-bounce 1s ease-in-out infinite; }
.ask-dot:nth-child(2) { animation-delay: .15s; }
.ask-dot:nth-child(3) { animation-delay: .3s; }
.ask-offline { margin-top: 8px; padding: 12px 16px; background: #EAF2EC; border: 1px solid var(--border); border-radius: 4px; font-size: 13px; color: var(--muted); }
.ask-answer { margin-top: 12px; background: var(--card); border-left: 3px solid var(--gold); border-radius: 0 4px 4px 0; padding: 16px; }
.ask-answer.older { opacity: .6; }
.ask-q { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); margin-bottom: 4px; }
.ask-a { font-size: 13px; line-height: 1.65; color: var(--sub); white-space: pre-wrap; max-height: 230px; overflow: auto; }
.ask-note { margin-top: 8px; padding: 12px 16px; font-size: 12px; color: var(--muted); }
@keyframes caret-blink { 50% { opacity: 0; } }
.type-caret { display: inline-block; width: 7px; height: 14px; background: var(--gold); vertical-align: middle; margin-left: 1px; animation: caret-blink 1s step-end infinite; }
.type-caret.done { display: none; }

/* ── Tonal sectioning pass ────────────────────────────────────────────
   Diagnosis: the front page ran 9,213px (77% of its height) as one
   unbroken cream field, so every desk read at identical weight and the
   page felt static regardless of how much motion sat on top of it.
   Fix is compositional, not more animation: full-bleed tonal bands that
   break the run into readable movements, plus a section-weight scale so
   a major desk outranks a minor list.

   Bands are pure presentation. They re-map existing design tokens inside
   their own scope, which is why the market charts, status pills, and
   registry chips invert correctly without touching data.ts or any of the
   set:html fragments. No data semantics, freshness labels, source links,
   or evidence grades are affected. ── */

/* Full-bleed ground without touching layout: the ::before breaks out to
   the viewport edges while the section keeps its 1140px measure.
   html{overflow-x:clip} (global.css) contains the 100vw breakout. */
.band { position: relative; }
.band::before {
  content: '';
  position: absolute;
  z-index: -1;
  top: 0;
  bottom: 0;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  background: var(--band-bg);
}

/* ── Ink band: the terminal register. Used for Market Watch, the section
   whose subject (listed markets, exchange data) earns Bloomberg-dark. ── */
.band-ink {
  --band-bg: var(--ink-ground);
  /* Re-map the palette inside this scope. Everything downstream —
     including server-rendered fragments — follows automatically. */
  --ink: var(--ink-fg);
  --text: var(--ink-fg);
  --sub: rgba(244,235,221,.74);
  --muted: rgba(244,235,221,.52);
  --border: rgba(244,235,221,.16);
  --border-dark: rgba(244,235,221,.34);
  --card: rgba(244,235,221,.045);
  --card-alt: rgba(244,235,221,.08);
  /* Accents lifted to hold contrast on ink; same hue family, higher value. */
  --teal: var(--teal-on-ink);
  --gold: var(--gold-on-ink);
  --coral: var(--coral-on-ink);
  --sky: var(--sky-on-ink);
  /* Chart tokens derive from --caribbean-fg and --teal, so the activity
     charts re-key themselves from these two lines. */
  --caribbean-fg: var(--ink-fg);
  --chart-surface: rgba(244,235,221,.05);
  --chart-annotate: var(--gold-on-ink);
  /* --chart-grid/axis/tick are declared at :root as color-mix() over
     var(--caribbean-fg). Custom properties substitute where they are
     DECLARED, not where they are used, so those three froze to the dark
     :root value and inherited into the band as near-black on near-black —
     the axis labels, grid lines and baseline went invisible. Re-declaring
     them here re-resolves the var against this scope. */
  /* --chart-series is declared at :root as var(--teal) and froze to the
     dark #0D5257 there, so the series bars kept stroking dark teal on the
     near-black chart surface — measured 1.78:1, below the 3.0 UI floor,
     with the fill at 20% opacity on top of that. Same substitution-timing
     trap as the three tokens below. Caught by Codex on PR #39. */
  --chart-series: var(--teal);
  --chart-grid: color-mix(in oklab, var(--ink-fg) 14%, transparent);
  --chart-axis: color-mix(in oklab, var(--ink-fg) 55%, transparent);
  --chart-tick: color-mix(in oklab, var(--ink-fg) 72%, transparent);
  color: var(--text);
  padding-top: 58px;
  padding-bottom: 62px;
  margin-top: 44px;
  margin-bottom: 44px;
}
/* Hairline rules top and bottom read as an edition break rather than a
   block of colour dropped on the page. */
.band-ink::before { box-shadow: inset 0 1px 0 rgba(244,235,221,.18), inset 0 -1px 0 rgba(244,235,221,.18); }

/* Hardcoded rgba() values predating the token system need explicit
   inversion; the tokenised rules above already handle the rest. */
.band-ink .market-status { color: var(--teal); background: rgba(95,168,173,.12); border-color: rgba(95,168,173,.28); }
.band-ink .market-card.proxy .market-status { color: var(--gold); background: rgba(208,160,63,.13); border-color: rgba(208,160,63,.3); }
.band-ink .market-card.proxy, .band-ink .market-chart-card.proxy { border-top-color: rgba(208,160,63,.5); }
.band-ink .market-note { background: rgba(208,160,63,.09); border-left-color: var(--gold); color: var(--sub); }
.band-ink .source-registry-group a,
.band-ink .source-registry-group span { background: rgba(244,235,221,.05); border-color: var(--border); color: var(--sub); }
.band-ink .source-registry-group a:hover { border-color: var(--teal); color: var(--teal); background: rgba(95,168,173,.1); }
.band-ink a { color: var(--teal); }

/* data.ts emits an empty .market-code span to hold the flex slot when an
   exchange has no ticker code, which left the ::after caret blinking on its
   own. Near-invisible on cream; obvious once the band went to ink. */
.market-code:empty::after { content: none; }

@media (hover: hover) and (pointer: fine) {
  .band-ink .market-chart-card:hover .activity-chart-shell { box-shadow: 0 4px 16px rgba(0,0,0,.5); }
  .band-ink tbody tr:hover { background: rgba(244,235,221,.05); }
}

/* ── Paper band: the deeper stock. A second tonal step that is not a
   second black slab — avoids zebra-striping the page. Cards keyed to
   --card now sit above their ground instead of dissolving into it. ── */
.band-paper {
  --band-bg: var(--paper-deep);
  --border: rgba(26,23,20,.22);
  padding-top: 48px;
  padding-bottom: 52px;
  margin-top: 40px;
  margin-bottom: 40px;
}
.band-paper::before { box-shadow: inset 0 1px 0 rgba(26,23,20,.14), inset 0 -1px 0 rgba(26,23,20,.14); }

/* ── Section weight scale ──────────────────────────────────────────
   Previously every section opened identically (mono label + 2px rule),
   so nothing distinguished a lead desk from a supporting list. ── */
.sec-major .st, .sec-major .sec-title { font-size: clamp(32px, 4.6vw, 51px); letter-spacing: -.018em; line-height: 1.02; }
.sec-major .ss, .sec-major .sec-sub { font-size: 15px; max-width: 620px; }
.sec-major .sec-label { border-top-width: 3px; letter-spacing: 1.9px; }

.sec-minor { padding-bottom: 26px; }
.sec-minor .sec-label { border-top-width: 1px; color: var(--muted); margin-bottom: 14px; }
.sec-minor .st, .sec-minor .sec-title { font-size: clamp(18px, 1.9vw, 22px); }

@media (max-width: 768px) {
  .band-ink { padding-top: 38px; padding-bottom: 40px; margin-top: 28px; margin-bottom: 28px; }
  .band-paper { padding-top: 32px; padding-bottom: 34px; margin-top: 26px; margin-bottom: 26px; }
}

@media (prefers-reduced-motion: reduce) {
  .band-ink .market-chart-card:hover .activity-chart-shell { box-shadow: none; }
}

/* ── Hover motion: pointer-gated and reduced-motion safe ──────────────
   Eight hover rules moved transform out of their base declarations and
   into this block. Previously they fired on touch (sticky hover states
   after a tap) and three of them — .btn, .sig-expand, .ask-chip —
   kept animating under prefers-reduced-motion, verified in a real
   browser with reducedMotion:'reduce'.

   Colour and background feedback stays ungated above: it is not motion,
   and it is the half that still reads correctly on a touch device.
   .sig-marker.selected keeps its scale unconditionally — that one is a
   selected-state indicator, not hover, and removing it would leave the
   state carried by colour alone. ── */
@media (hover: hover) and (pointer: fine) {
  .news-card:hover .news-media img { transform: scale(1.05); filter: saturate(1.06); }
  .front-cta:hover::after { transform: translateY(3px); }
  .sig-marker:hover .sig-dot { transform: scale(1.22); }
  .cluster-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-raised); }
  .btn:hover { transform: translateY(-1px); }
  .sig-expand:hover { transform: rotate(180deg); }
  .drill-card:hover { transform: translateY(-2px); }
  .ask-chip:hover { transform: translateY(-1px); }
}
@media (prefers-reduced-motion: reduce) {
  .btn, .sig-expand, .ask-chip, .drill-card { transition: none !important; }
