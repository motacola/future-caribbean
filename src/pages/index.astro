<Fragment set:html={`<script>
const D = ${d.analystData};
const MAP_DISPATCHES = ${d.mapDispatchesJson};
const MAP_MARKERS = ${d.mapMarkersJson};
const MAP_MARKER_BY_COUNTRY = Object.fromEntries(MAP_MARKERS.map(m => [m.country, m]));
const THEATER_EVENTS = ${d.theaterEventsJson};
const HUMANIZE_RULES = ${d.humanizeRulesJson}.map(([p, r]) => { try { return [new RegExp(p), r]; } catch (e) { return null; } }).filter(Boolean);
function humanizeJs(t) {
  if (!t) return t;
  let out = String(t);
  HUMANIZE_RULES.forEach(([rx, r]) => { out = out.replace(rx, r); });
  return out;
}
const MAP_COLORS = { investment:'#2676A8', climate:'#0D766E', procurement:'#B57A22', market:'#6F5FA8', none:'#7F8C83' };
const REPLAY_JSONL_URL = ${JSON.stringify(d.replayJsonlUrl)};
const VERDICT_COUNTS = ${d.verdictCountsJson};
const risks = ${d.lRisksJson};
<\/script>`} />

<script is:inline>
let theaterSource = null;
let theaterPaused = false;
let theaterReplayAttempted = false;
let theaterReplayMode = false;
let theaterBuffer = [];

function theaterTime(ts) {
  return new Date((ts || Date.now() / 1000) * 1000).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});
}

function renderTheaterEvent(type, data) {
  if (theaterPaused) {
    theaterBuffer.push([type, data]);
    return;
  }
  const feed = document.getElementById('theater-feed');
  const row = document.createElement('div');
  const eventClass = {source_check:'source', signal_found:'signal', dispatch_routed:'dispatch', cycle_complete:'cycle'}[type] || 'source';
  row.className = 'theater-event event-' + eventClass;
  const time = '<span class="theater-time">' + theaterTime(data.ts) + '</span>';
  if (type === 'source_check') {
    row.innerHTML = time + '<p><span>' + escapeMapText(data.source) + ' ↻</span> ' + escapeMapText(data.status) + '</p>';
  } else if (type === 'signal_found') {
    const color = MAP_COLORS[data.kind] || MAP_COLORS.none;
    row.innerHTML = time + '<p><span style="background:' + color + '">' + escapeMapText(data.kind) + '</span><strong>' + escapeMapText(data.country) + '</strong> · ' + escapeMapText(data.confidence) + '% · ' + escapeMapText(humanizeJs(data.summary)) + '</p>';
  } else if (type === 'dispatch_routed') {
    row.innerHTML = time + '<p><strong>' + escapeMapText(data.recipient) + '</strong> · ' + escapeMapText(data.country) + ' <code>' + escapeMapText(data.dispatch_id) + '</code></p>';
  } else {
    row.innerHTML = '<p>Cycle ' + escapeMapText(data.cycle) + ' complete — ' + escapeMapText(data.signals) + ' signals</p>';
  }
  feed.appendChild(row);
  while (feed.children.length > 50) feed.firstElementChild.remove();
  feed.scrollTop = feed.scrollHeight;
}

function setTheaterMode(mode) {
  const badge = document.getElementById('stream-mode');
  badge.textContent = mode;
  badge.className = 'stream-mode ' + mode.toLowerCase();
}

async function runReplayFromJsonl(jsonlUrl) {
  setTheaterMode('Replay (recorded cycle)');
  theaterReplayMode = true;
  try {
    const res = await fetch(jsonlUrl);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const text = await res.text();
    const lines = text.trim().split('\n').filter(l => l);
    const events = lines.map(l => JSON.parse(l));
    if (!events.length) {
      setTheaterMode('PAUSED');
      return;
    }
    const firstTs = events[0].data?.ts * 1000;
    const startWall = Date.now();
    for (const ev of events) {
      if (theaterPaused) break;
      const evTs = ev.data?.ts * 1000;
      const targetWall = startWall + (evTs - firstTs) / 10;
      const delay = Math.max(0, targetWall - Date.now());
      if (delay > 0) await new Promise(r => setTimeout(r, delay));
      if (theaterPaused) break;
      renderTheaterEvent(ev.event, ev.data);
    }
    setTheaterMode('Replay (recorded cycle)');
  } catch (e) {
    console.warn('Replay failed:', e);
    runReplayFromEmbeddedEvents();
  }
}

async function runReplayFromEmbeddedEvents() {
  if (!Array.isArray(THEATER_EVENTS) || !THEATER_EVENTS.length) {
    setTheaterMode('PAUSED');
    return;
  }
  theaterReplayMode = true;
  setTheaterMode('Replay (recorded cycle)');
  const feed = document.getElementById('theater-feed');
  if (feed) feed.innerHTML = '';
  for (let i = 0; i < THEATER_EVENTS.length; i++) {
    if (theaterPaused) break;
    const ev = THEATER_EVENTS[i];
    renderTheaterEvent(ev.event, ev.data || {});
    await new Promise(r => setTimeout(r, i < 6 ? 420 : 650));
  }
  if (!theaterPaused) setTheaterMode('Replay (recorded cycle)');
}

function connectTheater(replay) {
  if (theaterSource) theaterSource.close();
  setTheaterMode(replay ? 'REPLAY' : 'LIVE');
  theaterSource = new EventSource('/api/pipeline/stream' + (replay ? '?replay=1' : ''));
  ['source_check','signal_found','dispatch_routed','cycle_complete'].forEach(type => {
    theaterSource.addEventListener(type, event => {
      try { renderTheaterEvent(type, JSON.parse(event.data)); } catch (_) {}
    });
  });
  theaterSource.onerror = () => {
    theaterSource.close();
    if (!replay && !theaterReplayAttempted) {
      theaterReplayAttempted = true;
      connectTheater(true);
      return;
    }
    if (REPLAY_JSONL_URL && REPLAY_JSONL_URL !== "") {
      runReplayFromJsonl(REPLAY_JSONL_URL);
    } else {
      fetch('/data/history/index.json')
        .then(r => r.ok ? r.json() : null)
        .then(idx => {
          if (idx?.cycles?.length) {
            const latest = idx.cycles[0];
            const dateStr = latest.cycleId.replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3');
            runReplayFromJsonl('/data/history/' + dateStr + '.jsonl');
          } else {
            runReplayFromEmbeddedEvents();
          }
        })
        .catch(() => runReplayFromEmbeddedEvents());
    }
  };
}

document.getElementById('theater-toggle').addEventListener('click', event => {
  theaterPaused = !theaterPaused;
  event.currentTarget.textContent = theaterPaused ? 'Resume' : 'Pause';
  if (theaterPaused) {
    setTheaterMode(theaterReplayMode ? 'Replay (recorded cycle)' : 'PAUSED');
  } else {
    if (theaterReplayMode) {
      setTheaterMode('Replay (recorded cycle)');
      if (REPLAY_JSONL_URL && REPLAY_JSONL_URL !== "") {
        runReplayFromJsonl(REPLAY_JSONL_URL);
      }
    } else {
      setTheaterMode(theaterReplayAttempted ? 'REPLAY' : 'LIVE');
      const pending = theaterBuffer.splice(0);
      pending.forEach(([type, data]) => renderTheaterEvent(type, data));
    }
  }
});
connectTheater(false);

document.querySelectorAll('[data-news-filter]').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('[data-news-filter]').forEach(b => b.classList.toggle('active', b === button));
  const filter = button.dataset.newsFilter || 'all';
  document.querySelectorAll('.news-card').forEach(card => {
    const [kind, value] = filter.split(':');
    card.hidden = filter !== 'all' && !(kind === 'topic' ? (card.dataset.newsTopics || '').split('|').includes(value) : (card.dataset.newsCountries || '').split('|').includes(value));
  });
}));

function escapeMapText(value) {
  const node = document.createElement('span');
  node.textContent = value == null ? '' : String(value);
  return node.innerHTML;
}

const drillReact = (function () {
  if (typeof React === 'undefined' || typeof ReactDOM === 'undefined' || typeof htm === 'undefined') return null;
  const html = htm.bind(React.createElement);

  function DrillPanel({ country }) {
    if (!country) return html`<p class="map-drill-empty">Tap a country to see what the desk found.</p>`;
    const items = MAP_DISPATCHES[country] || [];
    const marker = MAP_MARKER_BY_COUNTRY[country] || {};
    const fx = marker.fx || {};
    const market = marker.market || {};
    const snapshot = market.snapshot || {};
    const marketLabel = market.code ? `${market.code} · ${snapshot.headline || market.name || 'Market watch'}` : 'No domestic exchange / watchlist';
    const panel = html`
      <div class="map-market-panel">
        <div><span>FX indicator</span><strong>${fx.pair || '—'}</strong><p>${fx.rate_label || 'Watch'} · ${fx.indicator || 'FX watch'}</p></div>
        <div><span>Market layer</span><strong>${marketLabel}</strong><p>${snapshot.data_status || market.status || 'source watch'} </p></div>
        <div><span>Finance signal</span><strong>${snapshot.focus || fx.signal || 'Signals, official notices, and local context'}</strong><p>${marker.finance_signal || marker.ranking_rationale || 'Ranking appears when a live signal is active.'}</p></div>
        <div class="map-news-list"><span>${marker.news_coverage || 'Regional news context'}</span>${(marker.news || []).slice(0,3).map(n => html`<a href=${n.url} target="_blank" rel="noopener">${n.title} · ${n.source}</a>`)}</div>
      </div>`;
    if (!items.length) {
      return html`
        <div class="rise-in">
          <div class="map-drill-head"><strong>${country}</strong><span>Watchlist signal</span></div>
          ${panel}
          <div class="map-drill-grid">
            <article>
              <span>WATCHLIST · ${marker.confidence || 0}/100</span>
              <h3>${marker.summary || 'Regional market watch signal'}</h3>
              <p>${marker.ranking_rationale || 'The desk is monitoring this island for official notices, FX pressure, market-source updates, and local context. It becomes a routed briefing when corroborated movement appears.'}</p>
            </article>
          </div>
        </div>`;
    }
    return html`
      <div class="rise-in">
        <div class="map-drill-head">
          <strong>${country}</strong>
          <span>${items.length} briefing${items.length === 1 ? '' : 's'} this cycle</span>
        </div>
        ${panel}
        <div class="map-drill-grid">
          ${items.slice(0, 6).map((d, i) => {
            const conf = Math.max(0, Math.min(100, d.confidence_score || 0));
            const color = MAP_COLORS[(d.signal_kind || '').includes('invest') ? 'investment' : (d.signal_kind || '').includes('climate') ? 'climate' : (d.signal_kind || '').includes('procure') ? 'procurement' : 'none'];
            return html`
              <article key=${d.dispatch_id} class="rise-in drill-card"
                       style=${{ animationDelay: (i * 70) + 'ms' }}>
                <span>${d.dispatch_id} · ${d.persona_label}</span>
                <h3>${d.title}</h3>
                <p>${d.recommended_action}</p>
                <div class="conf-row">
                  <div class="conf-track">
                    <div class="conf-fill" style=${{ width: conf + '%', background: color }}></div>
                  </div>
                  <span class="conf-num">${conf}/100</span>
                </div>
              </article>`;
          })}
        </div>
      </div>`;
  }

  const node = document.getElementById('map-drill');
  if (!node) return null;
  const root = ReactDOM.createRoot(node);
  root.render(html`<${DrillPanel} country=${null} />`);
  return { render: c => root.render(html`<${DrillPanel} country=${c} />`) };
})();

function openCountryDrill(country) {
  document.querySelectorAll('.sig-marker').forEach(x => x.classList.toggle('selected', x.dataset.country === country));
  if (drillReact) { drillReact.render(country); return; }
  const items = MAP_DISPATCHES[country] || [];
  const marker = MAP_MARKER_BY_COUNTRY[country] || {};
  const drill = document.getElementById('map-drill');
  drill.innerHTML = '<div class="map-drill-head"><strong>' + escapeMapText(country) + '</strong><span>' + items.length + ' dispatches</span></div>' +
    (items.length ? '<div class="map-drill-grid">' + items.slice(0, 6).map(d => '<article><span>' + escapeMapText(d.dispatch_id) + ' · ' + escapeMapText(d.persona_label) + '</span><h3>' + escapeMapText(d.title) + '</h3><p>' + escapeMapText(d.recommended_action) + '</p></article>').join('') + '</div>'
                 : '<div class="map-drill-grid"><article><span>WATCHLIST · ' + escapeMapText(marker.confidence || 0) + '/100</span><h3>' + escapeMapText(marker.summary || 'Regional market watch signal') + '</h3><p>' + escapeMapText(marker.ranking_rationale || 'The desk is monitoring this island for official notices, FX pressure, market-source updates, and local context.') + '</p></article></div>');
}

const mapMarkerRefs = {};

function sigIcon(entry, idx) {
  const conf = Math.max(0, Math.min(100, entry.confidence || 0));
  const d = Math.round(14 + conf / 100 * 14);
  const color = MAP_COLORS[entry.kind] || MAP_COLORS.none;
  const quiet = entry.kind === 'none' || conf === 0 ? ' quiet' : '';
  return L.divIcon({
    className: '',
    iconSize: [d, d],
    iconAnchor: [d / 2, d / 2],
    html: '<div class="sig-marker' + quiet + '" data-country="' + escapeMapText(entry.country) + '"' +
          ' style="--c:' + color + ';--delay:' + (idx % 3) * 0.85 + 's;width:' + d + 'px;height:' + d + 'px">' +
          '<span class="sig-ring"></span><span class="sig-dot"></span></div>'
  });
}

function sigTip(entry) {
  const fx = entry.fx || {};
  const market = entry.market || {};
  const marketLine = market.code ? '<br><em>' + escapeMapText(market.code) + ' · ' + escapeMapText((market.snapshot || {}).headline || market.name || 'market watch') + '</em>' : '';
  const fxLine = fx.pair ? '<br><em>FX ' + escapeMapText(fx.pair) + ' · ' + escapeMapText(fx.rate_label || 'watch') + '</em>' : '';
  return '<strong>' + escapeMapText(entry.country) + '</strong>' +
         escapeMapText(entry.summary || entry.top_signal_summary || 'On the watchlist — no current signal') + fxLine + marketLine;
}

function renderMapFallback() {
  const shell = document.querySelector('.map-shell');
  shell.innerHTML = '<div class="map-fallback">' + MAP_MARKERS.map(m =>
    '<button data-country="' + escapeMapText(m.country) + '" style="--c:' + (MAP_COLORS[m.kind] || MAP_COLORS.none) + '"><i></i>' + escapeMapText(m.country) + '</button>'
  ).join('') + '</div>';
