@keyframes rule-draw { from { background-size: 0% 2px; } to { background-size: 100% 2px; } }
.reveal .sec-label { animation: rule-draw .7s var(--fe-ease-out) both .1s; }

.aud, .cluster-card { box-shadow: var(--shadow-rest); transition: transform .18s ease, box-shadow .18s ease; }

