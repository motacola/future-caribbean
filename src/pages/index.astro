---
// Morning brief. One page, read top to bottom: the lead, five moves, what
// people on the ground are posting, and the country index. Everything the
// homepage used to stack (wire, news grid, market watch, receipts, outputs)
// lives on /desk unchanged. See docs/design/2026-10-18-morning-brief-redesign.md.
import Base from '../layouts/Base.astro';
import { loadDashboardData } from '../lib/data.ts';
const d = loadDashboardData();

// interior.dev Text Reveal, ported: words split at build time, so the reveal
// needs no JS. Same cadence: 0.055s stagger, whole reveal capped at 1.6s.
const leadWords = String(d.lTitle || '').trim().split(/\s+/).filter(Boolean);
const REVEAL_DURATION = 0.6;
const revealStep = leadWords.length > 1
  ? Math.min(0.055, (1.6 - REVEAL_DURATION) / (leadWords.length - 1))
  : 0;

const pad = (n: number) => String(n).padStart(2, '0');
const half = Math.ceil(d.briefCountries.length / 2);
const countryCols = [d.briefCountries.slice(0, half), d.briefCountries.slice(half)];
const hasGround = d.groundPosts.length > 0;
// Ticker links that fall back to the desk's own map anchor must leave this page.
const wireHtml = d.tickerHtml.replaceAll('href="#front-page"', 'href="/desk#front-page"');
const NUM = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];
const movesTitle = `${NUM[d.briefMoves.length] ?? d.briefMoves.length} ${d.briefMoves.length === 1 ? 'move' : 'moves'} this cycle`;
const spy = [
  ['brief-lead', 'The lead'],
  ['brief-moves', 'This cycle'],
  ...(hasGround ? [['brief-ground', 'From the ground']] : []),
  ['brief-index', 'Countries'],
];
---
<Base title="Abeng — the Caribbean morning brief" description={`Where Caribbean capital is moving this cycle: ${d.lTitle}`}>

<header class="bm-mast" id="bm-mast">
  <div class="bm-mast-inner">
    <a class="bm-wordmark" href="/" aria-label="Abeng, morning brief">Abeng</a>
    <nav class="bm-links" aria-label="Sections">
      <a href="/desk" class="bm-link">Full desk</a>
      <a href="/desk#regional-news" class="bm-link">News wire</a>
      <a href="/market-momentum" class="bm-link">Markets</a>
      <a href="/regional-connections" class="bm-link">Connections</a>
    </nav>
    <button type="button" class="bm-ask-btn" id="bm-palette-open" aria-haspopup="dialog">
      Ask or jump <kbd>⌘K</kbd>
    </button>
    <span class="bm-edition" title={`Cycle ${d.cycleId}`}>{d.nowStr}</span>
  </div>
  <div class="bm-progress" aria-hidden="true"><span id="bm-progress-bar"></span></div>
</header>

<div class="bm-wire" role="marquee" aria-label="Latest signals from this cycle" style={`--lw-dur:${Math.max(30, d.tickerItemCount * 7)}s`}>
  <span class="bm-wire-label">The wire</span>
  <div class="bm-wire-track">
    <div class="bm-wire-rail"><Fragment set:html={wireHtml} /></div>
    <div class="bm-wire-rail" aria-hidden="true" inert><Fragment set:html={wireHtml} /></div>
  </div>
</div>

<main class="bm-page" id="main-content">
  <div class="bm-column">

    <article class="bm-lead" id="brief-lead" aria-labelledby="bm-lead-title">
      <p class="bm-kicker"><span>The lead</span><span>{d.lCountry}</span><span>Briefing {d.cycleLabel}</span></p>
      <h1 class="bm-headline" id="bm-lead-title">
        <span class="sr-only">{d.lTitle}</span>
        <span aria-hidden="true">{leadWords.map((w, i) => (
          <><span class="bm-word" style={`--d:${(i * revealStep).toFixed(3)}s`}>{w}</span>{i < leadWords.length - 1 ? ' ' : ''}</>
        ))}</span>
      </h1>
      <p class="bm-standfirst">{d.lRankingBasis}</p>

      <div class="bm-trio">
        <section class="bm-block">
          <h2 class="bm-label">Why it matters</h2>
          <p>{d.leadRationale}</p>
        </section>
        <section class="bm-block">
          <h2 class="bm-label">The move · next {d.leadWindow}</h2>
          <p class="bm-move">{d.leadAction}</p>
          <p class="bm-fine">Best placed to act: <b>{d.leadOwner}</b></p>
        </section>
        <section class="bm-block">
          <h2 class="bm-label">Evidence</h2>
          <div class="bm-more" data-show-more>
            <p class="bm-more-body">{d.lEvidence}</p>
            <button type="button" class="bm-more-btn" hidden aria-expanded="false">Show the full evidence</button>
          </div>
          <p class="bm-fine">How solid: <b>{d.lGrade}</b></p>
        </section>
      </div>

      <p class="bm-source">
        <span>A signal, not advice. Every claim is cited on the desk.</span>
        <a class="bm-go" href={d.leadHref}>Read the full briefing <span aria-hidden="true">›</span></a>
      </p>
    </article>

    <section class="bm-section" id="brief-moves" aria-labelledby="bm-moves-title">
      <div class="bm-section-head">
        <h2 class="bm-section-title" id="bm-moves-title">{movesTitle}</h2>
        <a class="bm-section-link" href="/desk#more-wire">The whole wire <span aria-hidden="true">›</span></a>
      </div>
      <ol class="bm-moves">
        {d.briefMoves.map((m, i) => (
          <li>
            <a class="bm-move-row" href={m.href}>
              <span class="bm-num" aria-hidden="true">{pad(i + 1)}</span>
              <span class="bm-move-text">
                <span class="bm-country">{m.country}</span>
                <span class="bm-move-title">{m.title}</span>
              </span>
              <span class="bm-chev" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ol>
      {d.briefWatchCount > 0 && <p class="bm-fine bm-watchnote">Plus {d.briefWatchCount} markets with an early signal and no detail yet. <a href="/desk#more-wire">See them on the wire</a></p>}
    </section>

    {hasGround && (
      <section class="bm-section" id="brief-ground" aria-labelledby="bm-ground-title">
        <div class="bm-section-head">
          <h2 class="bm-section-title" id="bm-ground-title">From the ground</h2>
          <span class="bm-section-note">Instagram, regional accounts</span>
        </div>
        <ul class="bm-ground">
          {d.groundPosts.map((p) => (
            <li class="bm-post">
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.image && (
                  <span class="bm-post-media">
                    <img src={p.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-blur-up />
                  </span>
                )}
                <span class="bm-post-handle">{p.handle}{p.country && ` · ${p.country}`}</span>
                <span class="bm-post-caption">{p.caption}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="bm-section" id="brief-index" aria-labelledby="bm-index-title">
      <div class="bm-section-head">
        <h2 class="bm-section-title" id="bm-index-title">Where things stand</h2>
        <span class="bm-section-note">{d.briefCountries.length} markets and territories</span>
      </div>
      <div class="bm-index">
        {countryCols.map((col) => (
          <ul>
            {col.map((c) => (
              <li>
                <a class="bm-index-row" href={c.href} title={`${c.country}: ${c.status}, source ${c.freshness}`}>
                  <span class="bm-index-name">{c.country}</span>
                  <span class:list={['bm-status', { 'is-risk': c.risk, 'is-quiet': c.quiet }]}>{c.status}</span>
                  <span class="bm-chev" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  </div>

  <aside class="bm-rail" aria-label="Brief tools">
    <div class="bm-rail-inner">
      <nav class="bm-spy" aria-label="On this page">
        {spy.map(([id, label]) => <a href={`#${id}`} data-spy={id}>{label}</a>)}
      </nav>
      <form class="bm-askbox" id="bm-askbox">
        <label class="bm-label" for="bm-ask-input">Ask the desk</label>
        <div class="bm-ask-row">
          <input id="bm-ask-input" name="q" type="text" autocomplete="off" placeholder="What changed in Guyana?" />
          <button type="submit" aria-label="Ask">›</button>
        </div>
        <p class="bm-fine">Answers come from this cycle's files, with sources.</p>
        <div class="bm-answer" id="bm-answer" aria-live="polite"></div>
      </form>
    </div>
  </aside>
</main>

<footer class="bm-foot">
  <div class="bm-foot-inner">
    <span>Abeng reads what Caribbean governments, development banks, central banks, tender portals, exchanges and storm services publish, every four hours. {d.nCountries} markets. No reporters, no opinions.</span>
    <nav aria-label="More">
      <a href="/desk">Full desk</a>
      <a href="/accuracy">Track record</a>
      <a href="/desk#for-agents">For agents</a>
    </nav>
  </div>
</footer>

<dialog class="bm-palette" id="bm-palette" aria-label="Ask the desk or jump to a country">
  <form method="dialog" class="bm-palette-form" id="bm-palette-form">
    <input id="bm-palette-input" type="text" autocomplete="off" placeholder="Type a country, or ask a question" aria-controls="bm-palette-list" />
    <ul id="bm-palette-list" role="listbox"></ul>
    <p class="bm-fine">Enter to open · Esc to close</p>
  </form>
</dialog>

<script is:inline define:vars={{ countries: d.briefCountries.map((c) => ({ name: c.country, href: c.href, status: c.status })) }}>
(() => {
  // Reading progress + mobile hide-on-scroll. Layout state, so not gated on
  // reduced motion; only the transition is.
  const mast = document.getElementById('bm-mast');
  const bar = document.getElementById('bm-progress-bar');
  const column = document.querySelector('.bm-column');
  let lastY = scrollY;
  const onScroll = () => {
    const r = column.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
    bar.style.transform = `scaleX(${p})`;
    const y = scrollY;
    mast.classList.toggle('is-hidden', innerWidth < 760 && y > lastY && y > 120);
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scroll spy.
  const links = [...document.querySelectorAll('[data-spy]')];
  const spyIO = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.spy === e.target.id));
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  links.forEach((a) => { const el = document.getElementById(a.dataset.spy); if (el) spyIO.observe(el); });

  // Show more: only when the text actually overflows its clamp.
  document.querySelectorAll('[data-show-more]').forEach((box) => {
    const body = box.querySelector('.bm-more-body');
    const btn = box.querySelector('.bm-more-btn');
    if (body.scrollHeight <= body.clientHeight + 2) { box.classList.add('is-open'); return; }
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = box.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show less' : 'Show the full evidence';
    });
  });

  // Blur-up images; a broken image leaves the post text-first.
  document.querySelectorAll('img[data-blur-up]').forEach((img) => {
    const done = () => img.classList.add('is-loaded');
    const fail = () => img.closest('.bm-post-media')?.remove();
    if (img.complete) (img.naturalWidth ? done() : fail());
    else { img.addEventListener('load', done); img.addEventListener('error', fail); }
  });

  // Ask the desk. Answers are deterministic; streaming is pacing only, and
  // the "Sources:" line lands last as its own line.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const answer = document.getElementById('bm-answer');
  let busy = false;
  const streamInto = (el, text) => {
    const [body, sources] = text.split(/\n\s*Sources:/);
    el.textContent = '';
    const p = document.createElement('p');
    el.append(p);
    const words = body.trim().split(/(\s+)/);
    const finish = () => {
      if (sources) { const s = document.createElement('p'); s.className = 'bm-fine'; s.textContent = 'Sources:' + sources; el.append(s); }
    };
    if (reduced) { p.textContent = body.trim(); finish(); return; }
    const step = Math.min(28, 1600 / Math.max(1, words.length));
    let i = 0;
    const tick = () => {
      p.textContent += words.slice(i, i + 2).join('');
      i += 2;
      if (i < words.length) setTimeout(tick, step); else finish();
    };
    tick();
  };
  const ask = async (q) => {
    if (!q || busy) return;
    busy = true;
    answer.classList.add('is-busy');
    answer.textContent = 'Checking this cycle’s files…';
    try {
      const res = await fetch('/api/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question: q }) });
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      streamInto(answer, String(data.answer || 'No answer came back for that.'));
    } catch {
      answer.textContent = 'The desk is not reachable from this copy of the page. The full desk has every country and source.';
    }
    answer.classList.remove('is-busy');
    busy = false;
  };
  document.getElementById('bm-askbox').addEventListener('submit', (e) => {
    e.preventDefault();
    ask(e.target.q.value.trim());
  });

  // ⌘K palette: jump to a country, or hand the text to Ask.
  const dlg = document.getElementById('bm-palette');
  const input = document.getElementById('bm-palette-input');
  const list = document.getElementById('bm-palette-list');
  let active = 0;
  const items = () => {
    const q = input.value.trim().toLowerCase();
    const hits = countries.filter((c) => !q || c.name.toLowerCase().includes(q)).slice(0, 7)
      .map((c) => ({ label: c.name, hint: c.status, run: () => { location.href = c.href; } }));
    if (q) hits.push({ label: `Ask the desk: “${input.value.trim()}”`, hint: 'answer', run: () => {
      dlg.close();
      document.getElementById('bm-ask-input').value = input.value.trim();
      document.getElementById('brief-lead').scrollIntoView();
      ask(input.value.trim());
    } });
    return hits;
  };
  let current = [];
  const render = () => {
    current = items();
    active = Math.min(active, Math.max(0, current.length - 1));
    list.innerHTML = '';
    current.forEach((it, i) => {
      const li = document.createElement('li');
      li.role = 'option';
      li.setAttribute('aria-selected', String(i === active));
      li.innerHTML = '<span></span><small></small>';
      li.firstChild.textContent = it.label;
      li.lastChild.textContent = it.hint;
      li.addEventListener('click', it.run);
      list.append(li);
    });
  };
  const open = () => { input.value = ''; active = 0; render(); dlg.showModal(); input.focus(); };
  document.getElementById('bm-palette-open').addEventListener('click', open);
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); }
  });
  input.addEventListener('input', () => { active = 0; render(); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % Math.max(1, current.length); render(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + current.length) % Math.max(1, current.length); render(); }
    if (e.key === 'Enter') { e.preventDefault(); current[active]?.run(); }
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
})();
</script>

<style>
  /* Tokens come from global.css. --gold measures 4.47:1 on paper, just under
     the 4.5 floor for small labels, so text uses a slightly deeper mix. */
  :global(:root) { --gold-text: #8F6313; } /* 5.06:1 on paper */
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ── Masthead: one row ─────────────────────────────── */
  .bm-mast { position: sticky; top: 0; z-index: 20; background: var(--bg); border-top: 3px solid var(--ink); border-bottom: 1px solid var(--border); transition: transform .3s var(--fe-ease-out); }
  .bm-mast.is-hidden { transform: translateY(-100%); }
  .bm-mast-inner { max-width: 1180px; margin: 0 auto; padding: 12px clamp(16px, 4vw, 40px); display: flex; align-items: baseline; gap: 28px; }
  .bm-wordmark { font-family: var(--serif); font-weight: 700; font-size: 26px; letter-spacing: 3px; text-transform: uppercase; color: var(--ink); }
  .bm-wordmark:hover { text-decoration: none; color: var(--teal); }
  .bm-links { display: flex; gap: 22px; }
  .bm-link { font-size: 14px; color: var(--sub); text-underline-offset: 4px; }
  .bm-link:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold-text); }
  .bm-ask-btn { margin-left: auto; font: 500 13px var(--sans); color: var(--ink); background: transparent; border: 1px solid var(--border-dark); border-radius: var(--r); padding: 6px 10px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .bm-ask-btn:hover { border-color: var(--ink); background: var(--card-alt); }
  .bm-ask-btn kbd { font: 11px var(--mono); color: var(--sub); }
  .bm-edition { font: 12px var(--mono); color: var(--sub); white-space: nowrap; }
  .bm-progress { height: 2px; }
  .bm-progress span { display: block; height: 100%; background: var(--teal); transform-origin: 0 50%; transform: scaleX(0); }

  /* ── The wire: ticker, set as a ruled line ─────────── */
  .bm-wire { display: flex; align-items: center; border-bottom: 1px solid var(--border); background: var(--card); overflow: hidden; }
  .bm-wire-label { flex: none; font: 600 11px var(--mono); letter-spacing: 1.2px; text-transform: uppercase; color: var(--bg); background: var(--ink); padding: 10px 14px; }
  .bm-wire-track { display: flex; flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent); }
  .bm-wire-rail { display: flex; flex: none; animation: bm-wire var(--lw-dur, 60s) linear infinite; }
  .bm-wire:hover .bm-wire-rail, .bm-wire:focus-within .bm-wire-rail { animation-play-state: paused; }
  @keyframes bm-wire { to { transform: translateX(-100%); } }
  .bm-wire :global(.lw-item) { display: inline-flex; align-items: baseline; gap: 8px; padding: 9px 22px; white-space: nowrap; font-size: 14px; color: var(--ink); border-right: 1px solid var(--border); }
  .bm-wire :global(.lw-item:hover) { text-decoration: none; background: var(--card-alt); }
  .bm-wire :global(.lw-item:hover span:last-child) { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }
  .bm-wire :global(.lw-item i) { width: 7px; height: 7px; border-radius: 50%; flex: none; align-self: center; }
  .bm-wire :global(.lw-kicker) { font: 600 11px var(--sans); letter-spacing: 1px; text-transform: uppercase; color: var(--gold-text); }
  .bm-wire :global(.lw-tag) { font: 11px var(--mono); text-transform: uppercase; color: var(--sub); }
  .bm-wire :global(.lw-watch) { color: var(--sub); }

  /* ── Page grid: reading column + rail ──────────────── */
  .bm-page { max-width: 1180px; margin: 0 auto; padding: clamp(32px, 6vw, 72px) clamp(16px, 4vw, 40px) 64px; display: grid; grid-template-columns: minmax(0, 680px) minmax(240px, 300px); justify-content: space-between; gap: 64px; }

  /* ── Lead ──────────────────────────────────────────── */
  .bm-kicker { display: flex; flex-wrap: wrap; gap: 0 14px; font: 500 12px var(--mono); letter-spacing: 1.2px; text-transform: uppercase; color: var(--gold-text); margin-bottom: 18px; }
  .bm-kicker span + span::before { content: '·'; margin-right: 14px; color: var(--sub); }
  .bm-headline { font-family: var(--serif); font-weight: 700; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.04; letter-spacing: -.5px; color: var(--ink); animation: none; text-wrap: balance; }
  .bm-word { display: inline-block; animation: bm-word .6s var(--fe-ease-out) both; animation-delay: var(--d); }
  @keyframes bm-word { from { opacity: 0; transform: translateY(10px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  .bm-standfirst { font-size: 20px; line-height: 1.55; color: var(--sub); margin-top: 22px; max-width: 60ch; animation: fe-rise .7s .5s var(--fe-ease-out) both; }

  .bm-trio { margin-top: 36px; border-top: 2px solid var(--ink); }
  .bm-block { display: grid; grid-template-columns: 150px 1fr; gap: 4px 24px; align-content: start; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .bm-block > :not(.bm-label) { grid-column: 2; }
  .bm-label { font: 500 12px var(--mono); letter-spacing: 1px; text-transform: uppercase; color: var(--gold-text); line-height: 1.6; }
  .bm-block .bm-label { grid-row: 1 / span 3; }
  .bm-block p { font-size: 16px; line-height: 1.6; }
  .bm-move { font-family: var(--serif); font-size: 21px !important; line-height: 1.35 !important; font-weight: 600; }
  .bm-fine { font-size: 13px !important; color: var(--sub); margin-top: 6px; }
  .bm-fine b { color: var(--ink); font-weight: 600; }
  .bm-more-body { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
  .bm-more.is-open .bm-more-body { display: block; }
  .bm-more-btn { margin-top: 6px; font: 500 13px var(--sans); color: var(--teal); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .bm-source { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-top: 18px; font-size: 13px; color: var(--sub); }
  .bm-go { font-weight: 600; font-size: 15px; color: var(--teal); text-decoration: underline; text-decoration-color: rgba(13,82,87,.35); text-underline-offset: 4px; }
  .bm-go:hover { text-decoration-color: var(--teal); }

  /* ── Sections ──────────────────────────────────────── */
  .bm-section { margin-top: clamp(56px, 8vw, 88px); scroll-margin-top: 80px; }
  .bm-lead { scroll-margin-top: 80px; }
  .bm-section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; border-bottom: 2px solid var(--ink); padding-bottom: 10px; }
  .bm-section-title { font-family: var(--serif); font-weight: 600; font-size: clamp(26px, 3vw, 32px); line-height: 1.15; animation: none; }
  .bm-section-link { font-size: 14px; font-weight: 500; color: var(--teal); white-space: nowrap; }
  .bm-section-note { font: 12px var(--mono); color: var(--sub); letter-spacing: .5px; }

  /* Rows answer hover with a gold rule, underline and chevron (DESIGN.md r2). */
  .bm-moves { list-style: none; }
