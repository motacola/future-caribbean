---
// Morning brief. One page, read top to bottom: the lead, five moves, what
// people on the ground are posting, and the country index. Everything the
// homepage used to stack (wire, news grid, market watch, receipts, outputs)
// lives on /desk unchanged. See docs/design/2026-10-18-morning-brief-redesign.md.
import Base from '../layouts/Base.astro';
import '../styles/interior.css';
import { EvidenceMore, AskDesk, Palette } from '../components/brief/BriefIslands';
import { loadDashboardData } from '../lib/data.ts';
const d = loadDashboardData();

// Lead reveal, plain CSS: words split at build time, staggered 0.055s, whole
// reveal capped at 1.6s (the interior.dev Text Reveal timings, no JS).
const leadWords = String(d.lTitle || '').trim().split(/\s+/).filter(Boolean);
const revealStep = leadWords.length > 1 ? Math.min(0.055, 1.0 / (leadWords.length - 1)) : 0;

const pad = (n: number) => String(n).padStart(2, '0');
const half = Math.ceil(d.briefCountries.length / 2);
const countryCols = [d.briefCountries.slice(0, half), d.briefCountries.slice(half)];
const hasGround = d.groundPosts.length > 0;
// Ticker links that fall back to the desk's own map anchor must leave this page.
const wireHtml = d.tickerHtml.replaceAll('href="#front-page"', 'href="/desk#front-page"');
const NUM = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];
const movesTitle = `${NUM[d.briefMoves.length] ?? d.briefMoves.length} ${d.briefMoves.length === 1 ? 'move' : 'moves'} this cycle`;
const spy = [
  { id: 'brief-lead', label: 'Lead' },
  { id: 'brief-moves', label: 'This cycle' },
  ...(hasGround ? [{ id: 'brief-ground', label: 'Ground' }] : []),
  { id: 'brief-index', label: 'Countries' },
];
const paletteCountries = d.briefCountries.map((c) => ({ name: c.country, href: c.href, status: c.status }));
---
<Base title="Abeng — the Caribbean morning brief" description={`A live desk for the Caribbean. What changed, who should act. This cycle: ${d.lTitle}`}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  </Fragment>

<header class="bm-mast" id="bm-mast">
  <div class="bm-mast-inner">
    <a class="bm-wordmark" href="/" aria-label="Abeng, morning brief"><span class="bm-wordmark-word">Abeng</span><span class="bm-wordmark-tag">What changed. Who should act.</span></a>
    <nav class="bm-links" aria-label="Sections">
      <a href="/desk" class="bm-link">Full desk</a>
      <a href="/desk#regional-news" class="bm-link">News wire</a>
      <a href="/market-momentum" class="bm-link">Markets</a>
      <a href="/regional-connections" class="bm-link">Connections</a>
    </nav>
    <Palette client:idle countries={paletteCountries} />
    <span class="bm-edition" title={`Cycle ${d.cycleId}`}>{d.nowStr}</span>
  </div>
  <div class="bm-progress" aria-hidden="true"><span id="bm-progress-bar"></span></div>
</header>

<div class="bm-wire" role="marquee" aria-label="Latest signals from this cycle" style={`--lw-dur:${Math.max(30, d.tickerItemCount * 7)}s`}>
  <span class="bm-wire-label">The wire</span>
  <div class="bm-wire-track">
    <div class="bm-wire-rail"><Fragment set:html={wireHtml} /></div>
    <div class="bm-wire-rail" aria-hidden="true" inert><Fragment set:html={wireHtml} /></div>
  </div>
</div>

<section class="bm-hero" id="main-content" aria-labelledby="bm-lead-title">
  <div class="bm-map-wrap">
    <div id="bm-map" role="application" aria-label="Map of the 23 watched Caribbean markets. Each pulse is a signal; bigger pulses are stronger. Select a country to see what the desk found."></div>
    <div class="bm-map-card" id="bm-map-card" aria-live="polite" hidden></div>
  </div>
  <div class="bm-hero-inner">
    <div class="bm-hero-panel">
      <p class="bm-kicker"><span>The lead</span><span>{d.lCountry}</span><span>Briefing {d.cycleLabel}</span></p>
      <h1 class="bm-headline" id="bm-lead-title">
        <span class="sr-only">{d.lTitle}</span>
        <span aria-hidden="true">{leadWords.map((w, i) => (
          <><span class="bm-word" style={`--d:${(i * revealStep).toFixed(3)}s`}>{w}</span>{i < leadWords.length - 1 ? ' ' : ''}</>
        ))}</span>
      </h1>
      <p class="bm-standfirst">{d.lRankingBasis}</p>
      <a class="bm-go" href="#brief-lead">Read the briefing <span aria-hidden="true">↓</span></a>
      <ul class="bm-legend" aria-label="What the map pulses mean">
        <li style="--c:#2676A8">Investment</li>
        <li style="--c:#0D766E">Climate</li>
        <li style="--c:#B57A22">Procurement</li>
        <li style="--c:#6F5FA8">Market watch</li>
        <li style="--c:#7F8C83">Quiet</li>
        <li class="bm-legend-note">Larger pulses mark stronger signals. Select a country for what the desk found.</li>
      </ul>
    </div>
  </div>
</section>

<main class="bm-page">
  <div class="bm-column">

    <article class="bm-lead" id="brief-lead" aria-label={`The briefing: ${d.lTitle}`}>
      <p class="bm-kicker"><span>The briefing</span><span>{d.lCountry}</span></p>

      <div class="bm-trio">
        <section class="bm-block">
          <h2 class="bm-label">Why it matters</h2>
          <p>{d.leadRationale}</p>
        </section>
        <section class="bm-block">
          <h2 class="bm-label">The move · next {d.leadWindow}</h2>
          <p class="bm-move">{d.leadAction}</p>
          <p class="bm-fine">Best placed to act: <b>{d.leadOwner}</b></p>
        </section>
        <section class="bm-block">
          <h2 class="bm-label">Evidence</h2>
          <EvidenceMore client:load text={d.lEvidence} />
          <p class="bm-fine">How solid: <b>{d.lGrade}</b></p>
        </section>
      </div>

      <p class="bm-source">
        <span>A signal, not advice. Every claim is cited on the desk.</span>
        <a class="bm-go" href={d.leadHref}>Read the full briefing <span aria-hidden="true">›</span></a>
      </p>
    </article>

    <section class="bm-section" id="brief-moves" aria-labelledby="bm-moves-title">
      <div class="bm-section-head">
        <h2 class="bm-section-title" id="bm-moves-title">{movesTitle}</h2>
        <a class="bm-section-link" href="/desk#more-wire">The whole wire <span aria-hidden="true">›</span></a>
      </div>
      <ol class="bm-moves">
        {d.briefMoves.map((m, i) => (
          <li>
            <a class="bm-move-row" href={m.href}>
              <span class="bm-num" aria-hidden="true">{pad(i + 1)}</span>
              <span class="bm-move-text">
                <span class="bm-country">{m.country}</span>
                <span class="bm-move-title">{m.title}</span>
              </span>
              <span class="bm-chev" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ol>
      {d.briefWatchCount > 0 && <p class="bm-fine bm-watchnote">Plus {d.briefWatchCount} markets with an early signal and no detail yet. <a href="/desk#more-wire">See them on the wire</a></p>}
    </section>

    {hasGround && (
      <section class="bm-section" id="brief-ground" aria-labelledby="bm-ground-title">
        <div class="bm-section-head">
          <h2 class="bm-section-title" id="bm-ground-title">From the ground</h2>
          <span class="bm-section-note">Instagram, regional accounts</span>
        </div>
        <ul class="bm-ground">
          {d.groundPosts.map((p) => (
            <li class="bm-post">
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.image && <span class="bm-post-media"><img src={p.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-blur-up /></span>}
                <span class="bm-post-handle">{p.handle}{p.country && ` · ${p.country}`}</span>
                <span class="bm-post-caption">{p.caption}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="bm-section" id="brief-index" aria-labelledby="bm-index-title">
      <div class="bm-section-head">
        <h2 class="bm-section-title" id="bm-index-title">Where things stand</h2>
        <span class="bm-section-note">{d.briefCountries.length} markets and territories</span>
      </div>
      <div class="bm-index">
        {countryCols.map((col) => (
          <ul>
            {col.map((c) => (
              <li>
                <a class="bm-index-row" href={c.href} title={`${c.country}: ${c.status}, source ${c.freshness}`}>
                  <span class="bm-index-name">{c.country}</span>
                  <span class:list={['bm-status', { 'is-risk': c.risk, 'is-quiet': c.quiet }]}>{c.status}</span>
                  <span class="bm-chev" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  </div>

  <aside class="bm-rail" aria-label="Brief tools">
    <div class="bm-rail-inner">
      <nav class="bm-spy" aria-label="On this page">
        {spy.map((x) => <a href={`#${x.id}`} data-spy={x.id}>{x.label}</a>)}
      </nav>
      <AskDesk client:idle />
    </div>
  </aside>
</main>

<footer class="bm-foot">
  <div class="bm-foot-inner">
    <span>Abeng reads what Caribbean governments, development banks, central banks, tender portals, exchanges and storm services publish, every four hours. {d.nCountries} markets. No reporters, no opinions.</span>
    <nav aria-label="More">
      <a href="/desk">Full desk</a>
      <a href="/accuracy">Track record</a>
      <a href="/desk#for-agents">For agents</a>
    </nav>
  </div>
</footer>

<script is:inline define:vars={{ countries: paletteCountries, markers: JSON.parse(d.mapMarkersJson).map((m) => ({ country: m.country, lat: m.lat, lng: m.lng, kind: m.kind, confidence: m.confidence, summary: m.summary })) }}>
(() => {
  // ── Map hero. Same tiles, markers and sizing rule as the desk map, so the
  // two cannot disagree; tapping a country opens a card in place.
  const MAP_COLORS = { investment: '#2676A8', climate: '#0D766E', procurement: '#B57A22', market: '#6F5FA8', none: '#7F8C83' };
  const byName = Object.fromEntries(countries.map((c) => [c.name, c]));
  const card = document.getElementById('bm-map-card');
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  const showCard = (m) => {
    const c = byName[m.country] || { href: '/desk#front-page', status: 'Quiet' };
    card.innerHTML = `<button type="button" class="bm-card-close" aria-label="Close">×</button>
      <p class="bm-card-status" style="--c:${MAP_COLORS[m.kind] || MAP_COLORS.none}">${esc(c.status)}</p>
      <h2 class="bm-card-title">${esc(m.country)}</h2>
      <p class="bm-card-summary">${esc(m.summary || 'On the watchlist. No current signal.')}</p>
      <a class="bm-go" href="${esc(c.href)}">Read the briefing <span aria-hidden="true">›</span></a>`;
    card.hidden = false;
    card.querySelector('.bm-card-close').addEventListener('click', () => { card.hidden = true; });
  };
  const mapEl = document.getElementById('bm-map');
  if (typeof L === 'undefined') {
    mapEl.closest('.bm-hero').classList.add('no-map');
  } else {
    const map = L.map(mapEl, { minZoom: 3.5, maxZoom: 9, zoomSnap: 0.25, fadeAnimation: false, scrollWheelZoom: false, maxBounds: [[-25, -130], [50, -10]], maxBoundsViscosity: 0.8, zoomControl: true });
    // Bounds wider than the viewport: tiles outside maxBounds are never
    // refreshed, which drew a hairline box across the hero.
    const bounds = L.latLngBounds(markers.map((m) => [m.lat, m.lng])).pad(0.04);
    // On wide screens the lead panel covers the map's left side; push the
    // markers into the visible right-hand area instead of under the panel.
    const panel = document.querySelector('.bm-hero-panel');
    // Fit the pins into the map area the lead panel leaves free. If that area
    // is too narrow (or the page is still laying out), fit the whole map
    // instead: padding wider than the map makes Leaflet jump to max zoom.
    const frame = () => {
      map.invalidateSize();
      const left = innerWidth > 960 ? panel.getBoundingClientRect().right + 24 : 0;
      const room = mapEl.clientWidth - left - 24;
      map.fitBounds(bounds, room >= 320
        ? { paddingTopLeft: [left, 24], paddingBottomRight: [24, 24], maxZoom: 6 }
        : { padding: [12, 12], maxZoom: 6 });
    };
    frame();
    // The map's own size, not just the window's, decides the framing.
    new ResizeObserver(() => frame()).observe(mapEl);
    L.tileLayer('https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri', maxZoom: 9,
    }).addTo(map);
    markers.forEach((m, i) => {
      const conf = Math.max(0, Math.min(100, m.confidence || 0));
      const size = Math.round(14 + conf / 100 * 14);
      const quiet = m.kind === 'none' || conf === 0 ? ' quiet' : '';
      const icon = L.divIcon({ className: '', iconSize: [size, size], iconAnchor: [size / 2, size / 2],
        html: `<div class="bm-pin${quiet}" style="--c:${MAP_COLORS[m.kind] || MAP_COLORS.none};--delay:${(i % 3) * 0.85}s;width:${size}px;height:${size}px"><span class="bm-pin-ring"></span><span class="bm-pin-dot"></span></div>` });
      L.marker([m.lat, m.lng], { icon, keyboard: true, title: m.country, alt: m.country })
        .bindTooltip(`<strong>${esc(m.country)}</strong>${esc(byName[m.country]?.status || '')}`, { className: 'bm-tip', direction: 'top', offset: [0, -10] })
        .on('click', () => { showCard(m); map.flyTo([m.lat, m.lng], Math.max(map.getZoom(), 6), { duration: 0.7 }); })
        .addTo(map);
    });
  }


  // ── Plain pieces ────────────────────────────────────────
  // Reading progress through the briefing column + phone masthead hide. Both
  // are layout state, so not gated on reduced motion (only transitions are).
  const mast = document.getElementById('bm-mast');
  const bar = document.getElementById('bm-progress-bar');
  const column = document.querySelector('.bm-column');
  let lastY = scrollY;
  const onScroll = () => {
    const r = column.getBoundingClientRect();
    bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)))})`;
    const y = scrollY;
    mast.classList.toggle('is-hidden', innerWidth < 760 && y > lastY + 4 && y > 160);
    if (y < lastY - 4 || y <= 160) mast.classList.remove('is-hidden');
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  // Scroll spy: plain links; never moves focus or scrolls the page itself.
  const spyLinks = [...document.querySelectorAll('[data-spy]')];
  const spyIO = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) spyLinks.forEach((a) => a.toggleAttribute('aria-current', a.dataset.spy === e.target.id));
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  spyLinks.forEach((a) => { const el = document.getElementById(a.dataset.spy); if (el) spyIO.observe(el); });
  // Blur-up images; a broken image leaves the post text-first.
  document.querySelectorAll('img[data-blur-up]').forEach((img) => {
    const done = () => img.classList.add('is-loaded');
    const fail = () => img.closest('.bm-post-media')?.remove();
    if (img.complete) (img.naturalWidth ? done() : fail());
    else { img.addEventListener('load', done); img.addEventListener('error', fail); }
  });
})();
</script>

<style is:global>
  /* Tokens come from global.css. --gold measures 4.47:1 on paper, just under
     the 4.5 floor for small labels, so text uses a slightly deeper mix. */
  :root { --gold-text: #8F6313; } /* 5.06:1 on paper */

  /* ── Masthead: one row ─────────────────────────────── */
  /* Same masthead as every other page (desk, build, connections, signal):
     ink gradient, gold nameplate, gold→teal rule underneath. */
  .bm-mast { position: sticky; top: 0; z-index: 20; background-color: #1A1714; background-image: linear-gradient(160deg, #211D19, #14110E 88%); color: var(--bg); transition: transform .3s var(--fe-ease-out); }
  .bm-mast::after { content: ""; display: block; height: 2px; background: linear-gradient(90deg, var(--gold), var(--teal) 55%, transparent); opacity: .85; }
  .bm-mast.is-hidden { transform: translateY(-100%); }
  .bm-mast-inner { max-width: 1180px; margin: 0 auto; padding: 14px clamp(16px, 4vw, 40px); display: flex; align-items: center; gap: 32px; }
  .bm-wordmark { font-family: var(--serif); font-weight: 700; font-size: clamp(30px, 2.6vw, 38px); line-height: 1; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); }
  .bm-wordmark { display: grid; gap: 5px; }
  .bm-wordmark-tag { font: 500 11px var(--mono); letter-spacing: 1.2px; text-transform: uppercase; color: rgba(255,249,240,.72); }
  .bm-wordmark:hover { text-decoration: none; }
  .bm-wordmark:hover .bm-wordmark-word { color: var(--gold-on-ink); }
  .bm-links { display: flex; gap: 22px; }
  .bm-link, .bm-ask-btn, .bm-wordmark-tag, .bm-edition { white-space: nowrap; }
  @media (max-width: 1200px) { .bm-edition { display: none; } .bm-links { gap: 16px; } .bm-mast-inner { gap: 24px; } }
  .bm-link { font-size: 12px; font-weight: 500; letter-spacing: .8px; text-transform: uppercase; color: rgba(255,249,240,.72); text-underline-offset: 5px; }
  .bm-link:hover { color: var(--bg); text-decoration: underline; text-decoration-color: var(--gold-on-ink); }
  .bm-ask-btn { margin-left: auto; font: 500 13px var(--sans); color: var(--bg); background: transparent; border: 1px solid rgba(244,235,221,.38); border-radius: var(--r); padding: 6px 10px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .bm-ask-btn:hover { border-color: var(--bg); background: rgba(244,235,221,.08); }
  .bm-ask-btn kbd { font: 11px var(--mono); color: rgba(255,249,240,.70); }
  .bm-edition { font: 11px var(--mono); letter-spacing: .6px; text-transform: uppercase; color: rgba(255,249,240,.70); white-space: nowrap; }

  /* ── The wire: ticker, set as a ruled line ─────────── */
  .bm-wire { display: flex; align-items: center; border-bottom: 1px solid var(--border); background: var(--card); overflow: hidden; }
  .bm-wire-label { flex: none; font: 600 11px var(--mono); letter-spacing: 1.2px; text-transform: uppercase; color: var(--bg); background: var(--ink); padding: 10px 14px; }
  .bm-wire-track { display: flex; flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent); }
  .bm-wire-rail { display: flex; flex: none; animation: bm-wire var(--lw-dur, 60s) linear infinite; }
  .bm-wire:hover .bm-wire-rail, .bm-wire:focus-within .bm-wire-rail { animation-play-state: paused; }
  @keyframes bm-wire { to { transform: translateX(-100%); } }
  .bm-wire .lw-item { display: inline-flex; align-items: baseline; gap: 8px; padding: 9px 22px; white-space: nowrap; font-size: 14px; color: var(--ink); border-right: 1px solid var(--border); }
  .bm-wire .lw-item:hover { text-decoration: none; background: var(--card-alt); }
  .bm-wire .lw-item:hover span:last-child { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }
  .bm-wire .lw-item i { width: 7px; height: 7px; border-radius: 50%; flex: none; align-self: center; }
  .bm-wire .lw-kicker { font: 600 11px var(--sans); letter-spacing: 1px; text-transform: uppercase; color: var(--gold-text); }
  .bm-wire .lw-tag { font: 11px var(--mono); text-transform: uppercase; color: var(--sub); }
  .bm-wire .lw-watch { color: var(--sub); }


  /* ── Plain CSS for the light pieces (Jev: library only where it earns it) ── */
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bm-word { display: inline-block; animation: bm-word .6s var(--fe-ease-out) both; animation-delay: var(--d); }
  @keyframes bm-word { from { opacity: 0; transform: translateY(10px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  .bm-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; z-index: 1; }
  .bm-progress span { display: block; height: 100%; background: var(--teal); transform-origin: 0 50%; transform: scaleX(0); }
  /* Quiet spy (Jev 0.88): plain labels on a hairline, teal underline on the current one. */
  .bm-spy { display: flex; gap: 18px; border-bottom: 1px solid var(--border); }
  .bm-spy a { font-size: 14px; color: var(--sub); padding: 8px 0; margin-bottom: -1px; border-bottom: 2px solid transparent; text-decoration: none; transition: color .2s, border-color .2s; }
  .bm-spy a:hover { color: var(--ink); }
  .bm-spy a[aria-current] { color: var(--ink); border-bottom-color: var(--teal); }
  .bm-post-media img { width: 100%; height: 100%; object-fit: cover; filter: blur(14px); transform: scale(1.06); transition: filter .5s var(--fe-ease-out), transform .5s var(--fe-ease-out); }
  .bm-post-media img.is-loaded { filter: none; transform: none; }

  /* ── interior.dev components, re-skinned to Abeng ──────
     The components are unchanged library code styled with Tailwind; these
     unlayered rules beat Tailwind's layer and swap its neutral/blue skin for
     paper, ink and teal. */
  .bm-showmore { font-size: 16px; line-height: 1.6; color: var(--ink); }
  .bm-showmore > div:first-child > div:last-child { background: linear-gradient(to top, var(--bg), transparent); }
  .bm-showmore button { background: none; box-shadow: none; padding: 0; height: auto; color: var(--teal); font: 500 14px var(--sans); text-decoration: underline; text-underline-offset: 3px; }
  .bm-showmore button svg { color: var(--teal); }
  .bm-answer { font-size: 14px; line-height: 1.55; color: var(--ink); margin-top: 14px; }
  .bm-answer button { background: none; box-shadow: none; color: var(--teal); text-decoration: underline; }
  .bm-answer.is-busy { color: var(--sub); }
  .bm-palette input { font-family: var(--sans); color: var(--ink); }
  .bm-palette [role="dialog"], .bm-palette > div > div { background: var(--bg); border-radius: var(--r); }
  .bm-palette [aria-selected="true"] { background: var(--card-alt); box-shadow: inset 2px 0 0 var(--teal); }

  /* ── Map hero ──────────────────────────────────────── */
  .bm-hero { position: relative; border-bottom: 1px solid var(--border); }
  .bm-map-wrap { position: relative; }
  #bm-map { height: clamp(520px, 70vh, 680px); background: #D0CFD4; font-family: var(--sans); }
  /* Leaflet 1.9 blends tiles with plus-lighter; at fractional zoom the
     overlapping tile edges add up to white seams. Blend normally and let the
