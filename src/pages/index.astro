---
import Base from '../layouts/Base.astro';
import { loadDashboardData } from '../lib/data.ts';
const d = loadDashboardData();
---

<style is:global>
:root {
  --bg: #F4EBDD; --ink: #18251F; --card: #FFFCF4; --card-alt: #EDE8DF;
  --text: #18251F; --sub: #455A50; --muted: #5D6B62;
  --gold: #B57A22; --teal: #0D766E; --coral: #B94836; --sky: #2676A8;
  --lime: #B6C74E; --border: #D8CBB8; --border-dark: #AA9A82;
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Inter', -apple-system, system-ui, sans-serif;
  --mono: 'IBM Plex Mono', monospace;
  --r: 3px;
  --shadow-rest: 0 1px 2px rgba(24,37,31,.05), 0 1px 1px rgba(24,37,31,.03);
  --shadow-card: 0 2px 6px rgba(24,37,31,.06), 0 8px 20px rgba(24,37,31,.05);
  --shadow-raised: 0 6px 16px rgba(24,37,31,.09), 0 16px 40px rgba(24,37,31,.08);
  --shadow-hero: 0 10px 24px rgba(24,37,31,.10), 0 24px 56px rgba(24,37,31,.10);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--sans); background: var(--bg); background-image: radial-gradient(1100px 500px at 75% -120px, rgba(181,122,34,.06), transparent 70%), radial-gradient(900px 420px at -10% 30%, rgba(13,118,110,.04), transparent 70%); color: var(--text); line-height: 1.6; font-size: 15px; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a { color: var(--teal); text-decoration: none; }
a:hover { text-decoration: underline; }
.masthead { background: linear-gradient(155deg, var(--ink), #0F1912 88%); color: var(--bg); padding: 8px 0 14px; }
.mast-edition { max-width: 1140px; margin: 0 auto; padding: 0 24px 6px; display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 9px; letter-spacing: 1.2px; text-transform: uppercase; color: rgba(244,235,221,.45); border-bottom: 1px solid rgba(244,235,221,.12); margin-bottom: 6px; padding-bottom: 6px; }
.masthead::after { content: ""; display: block; height: 3px; margin-bottom: -3px; background: linear-gradient(90deg, var(--gold), var(--teal) 55%, transparent); opacity: .85; box-shadow: 0 4px 0 -2px rgba(244,235,221,.18); }
.front-lede h1 em { font-style: italic; color: var(--teal); }
.map-caption { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; padding: 10px 2px 0; font-family: var(--mono); font-size: 11px; letter-spacing: .6px; text-transform: uppercase; color: var(--muted); }
.map-caption b { color: var(--gold); font-weight: 500; }
.map-finance-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
.map-finance-chip { background: rgba(255,252,244,.84); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; min-width: 0; }
.map-finance-chip span { display: block; font: 700 9px var(--mono); letter-spacing: .8px; text-transform: uppercase; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.map-finance-chip strong { display: block; font-size: 12px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.map-finance-chip.fx strong { color: var(--teal); }
.map-finance-chip.market strong { color: var(--gold); }
.mast-inner { max-width: 1140px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; }
.mast-name { font-family: var(--serif); font-size: 18px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
.mast-name em { font-style: normal; color: var(--gold); }
.mast-links { display: flex; gap: 20px; }
.mast-links a { color: color-mix(in srgb, var(--bg) 62%, transparent); font-size: 12px; letter-spacing: .5px; text-transform: uppercase; font-weight: 500; }
.mast-links a:hover { color: var(--bg); text-decoration: none; }
.btn { display: inline-block; padding: 10px 22px; border-radius: 5px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; font-family: var(--sans); letter-spacing: .3px; }
.btn-p { background: var(--ink); color: var(--bg); box-shadow: 0 2px 6px rgba(24,37,31,.18), 0 1px 2px rgba(24,37,31,.12); }
.btn-s { background: transparent; color: var(--text); border: 1px solid var(--border-dark); }
.btn-s:hover { border-color: var(--text); text-decoration: none; }
.proof-band { max-width: 1140px; margin: 0 auto; padding: 0 24px 36px; }
.proof-line { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 2px solid var(--ink); border-bottom: 1px solid var(--border); background: transparent; }
.proof-cell { padding: 12px 16px 12px 0; border-right: none; min-width: 0; }
.proof-cell + .proof-cell { border-left: 1px solid var(--border); padding-left: 16px; }
.proof-cell:last-child { border-right: none; }
.proof-k { display: block; font-family: var(--mono); font-size: 18px; line-height: 1.1; color: var(--ink); margin-bottom: 4px; }
.proof-v { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .8px; font-weight: 700; }
.sec { max-width: 1140px; margin: 0 auto; padding: 0 24px 40px; }
.sec-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 10px; font-weight: 600; }
.sec-title, .st { font-family: var(--serif); font-size: 28px; line-height: 1.08; font-weight: 700; margin-bottom: 8px; letter-spacing: 0; }
.sec-sub { font-size: 14px; color: var(--sub); margin-bottom: 20px; max-width: 520px; }
.ss { font-size: 14px; color: var(--sub); margin-bottom: 20px; max-width: 560px; }
.lead-risk { background: rgba(201,76,76,.07); border: 1px solid rgba(201,76,76,.15); border-radius: 6px; padding: 10px 14px; font-size: 13px; color: var(--coral); margin: 12px 0; }
.lead-disclaimer { font-size: 11px; color: var(--muted); margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border); }
.lead-disclaimer strong { color: var(--gold); }
.decision-shell { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(300px,.75fr); gap: 16px; align-items: start; }
.decision-main, .decision-side { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); }
.decision-main { padding: 30px; box-shadow: var(--shadow-hero); }
.decision-side { box-shadow: var(--shadow-card); }
.decision-kicker { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 18px; }
.decision-id { font-family: var(--mono); font-size: 10px; color: var(--muted); }
.decision-status { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: .7px; }
.decision-status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }
.decision-main h2 { font-family: var(--serif); font-size: clamp(30px,4vw,48px); line-height: 1; margin-bottom: 14px; }
.decision-summary { color: var(--sub); font-size: 15px; max-width: 720px; margin-bottom: 22px; }
.decision-call { background: linear-gradient(155deg, var(--ink), #0f1912 88%); color: var(--bg); padding: 22px 24px; border-radius: 8px; margin-bottom: 20px; border-left: 3px solid var(--gold); box-shadow: var(--shadow-raised); position: relative; overflow: hidden; }
.decision-call::before { content: ""; position: absolute; inset: 0; background: radial-gradient(340px 160px at 100% 0%, rgba(181,122,34,.14), transparent 70%); pointer-events: none; }
.decision-call label, .decision-fact label { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 1.1px; font-weight: 700; color: var(--lime); margin-bottom: 6px; }
.decision-call strong { display: block; font-family: var(--serif); font-size: 22px; line-height: 1.22; margin-bottom: 8px; letter-spacing: .2px; padding-left: 22px; position: relative; }
.decision-call strong::before { content: '\201C'; position: absolute; left: -4px; top: -14px; font-family: var(--serif); font-size: 46px; font-style: normal; color: var(--gold); line-height: 1; opacity: .85; }
.decision-call p { color: rgba(244,235,221,.7); font-size: 12.5px; line-height: 1.55; position: relative; }
.decision-facts { display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px; }
.decision-fact { padding: 13px 12px 13px 0; }
.decision-fact + .decision-fact { border-left: 1px solid var(--border); padding-left: 12px; }
.decision-fact label { color: var(--muted); }
.decision-fact strong { display: block; font-size: 13px; line-height: 1.35; }
.check-title { font-family: var(--serif); font-size: 18px; margin-bottom: 3px; }
.check-sub { color: var(--muted); font-size: 12px; margin-bottom: 12px; }
.checklist { display: grid; gap: 7px; }
.check-item { display: grid; grid-template-columns: 25px 1fr; gap: 10px; align-items: start; padding: 11px 0; border-top: 1px solid var(--border); cursor: pointer; }
.check-box { width: 20px; height: 20px; border: 1px solid var(--border-dark); display: grid; place-items: center; font-size: 12px; color: transparent; transition: .15s ease; }
.check-item.done .check-box { background: var(--teal); border-color: var(--teal); color: var(--card); }
.check-item.done strong, .check-item.done span { opacity: .48; text-decoration: line-through; }
.check-item strong { display: block; font-size: 13px; margin-bottom: 2px; }
.check-item span { display: block; font-size: 11px; color: var(--muted); }
.decision-side { overflow: hidden; }
.side-head { padding: 18px; border-bottom: 1px solid var(--border); }
.side-head span { display: block; font-size: 10px; color: var(--gold); text-transform: uppercase; letter-spacing: 1.1px; font-weight: 700; margin-bottom: 5px; }
.side-head h3 { font-family: var(--serif); font-size: 20px; }
.route-lane { padding: 16px 18px; border-bottom: 1px solid var(--border); position: relative; }
.route-lane:last-child { border-bottom: none; }
.route-lane div { padding-right: 70px; margin-bottom: 8px; }
.route-lane strong { display: block; font-size: 13px; }
.route-lane div span { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
.route-lane p { font-size: 12px; color: var(--sub); line-height: 1.5; }
.route-state { position: absolute; right: 18px; top: 17px; font-family: var(--mono); font-size: 9px; color: var(--teal); text-transform: uppercase; }
.decision-note { padding: 16px 18px; background: var(--card-alt); font-size: 12px; color: var(--sub); }
.decision-note strong { color: var(--text); }
.vpack { margin-top: 22px; border: 1px solid var(--border-dark); border-radius: 7px; overflow: hidden; box-shadow: var(--shadow-card); }
.vpack-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 14px 16px; background: var(--card-alt); }
.vpack-head div span { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: 1.1px; font-weight: 700; color: var(--gold); margin-bottom: 4px; }
.vpack-head h3 { font-family: var(--serif); font-size: 18px; }
.vpack-verdict { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; padding: 5px 10px; border-radius: 4px; }
.vpack-verdict.advance { color: var(--teal); background: rgba(31,122,110,.1); }
.vpack-verdict.hold { color: var(--gold); background: rgba(176,137,52,.12); }
.vpack-verdict.reject { color: var(--coral); background: rgba(201,76,76,.1); }
.vpack-reason { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 12px; color: var(--sub); line-height: 1.55; }
.vpack-grid { display: grid; grid-template-columns: 1fr 1fr; }
.vpack-col { padding: 14px 16px; border-top: 1px solid var(--border); min-width: 0; }
.vpack-col + .vpack-col { border-left: 1px solid var(--border); }
.vpack-col h4 { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; color: var(--muted); margin-bottom: 9px; }
.vpack-col ul { list-style: none; display: grid; gap: 7px; }
.vpack-col li { font-size: 12px; line-height: 1.45; color: var(--sub); overflow-wrap: anywhere; }
.vpack-col li strong { color: var(--text); font-weight: 600; }
.vpack-col li em { display: block; font-style: normal; font-size: 10.5px; color: var(--muted); }
.vpack-col a { color: var(--teal); text-decoration: none; border-bottom: 1px solid rgba(31,122,110,.3); }
.vpack-tag { font-family: var(--mono); font-size: 9px; color: var(--muted); text-transform: uppercase; margin-left: 5px; }
.vpack-questions { padding: 12px 16px; border-top: 1px solid var(--border); background: var(--card-alt); }
.vpack-questions h4 { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; color: var(--muted); margin-bottom: 8px; }
.vpack-questions li { font-size: 11.5px; color: var(--sub); line-height: 1.5; margin-left: 16px; margin-bottom: 4px; }
.vpack-freshness { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; padding: 10px 16px; border-top: 1px solid var(--border); background: rgba(31,122,110,.04); }
.freshness-pill { font-family: var(--mono); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; padding: 4px 8px; border-radius: 4px; }
.freshness-pill.refreshing { color: var(--teal); background: rgba(31,122,110,.12); }
.freshness-pill.aging { color: var(--gold); background: rgba(176,137,52,.14); }
.freshness-pill.stale { color: var(--coral); background: rgba(201,76,76,.12); }
.freshness-pill.unknown { color: var(--muted); background: rgba(24,37,31,.06); }
.freshness-meta { font-size: 11px; color: var(--sub); }
.freshness-meta strong { color: var(--text); font-weight: 600; }
.freshness-meta em { color: var(--muted); font-style: normal; }
.hyp-status { display: inline-block; font-family: var(--mono); font-size: 8px; text-transform: uppercase; letter-spacing: .6px; padding: 2px 6px; border-radius: 3px; margin-left: 6px; vertical-align: middle; }
.hyp-status.corroborated { color: var(--teal); background: rgba(31,122,110,.1); }
.hyp-status.unconfirmed { color: var(--muted); background: rgba(24,37,31,.06); }
.hyp-status.data_available { color: var(--gold); background: rgba(176,137,52,.12); }
.hyp-status.macro_signal { color: var(--sub); background: rgba(24,37,31,.05); }
.vpack-tag.closing { color: var(--coral); }
.sig-list { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 18px; box-shadow: var(--shadow-card); }
.risk-tag { font-size: 11px; color: var(--coral); background: rgba(201,76,76,.07); padding: 3px 8px; border-radius: 4px; max-width: 100%; overflow-wrap: anywhere; }
.market-watch { padding-top: 4px; }
.market-head { display: flex; justify-content: space-between; gap: 18px; align-items: end; margin-bottom: 16px; flex-wrap: wrap; }
.market-head .ss { margin-bottom: 0; max-width: 660px; }
.market-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.market-card { background: var(--card); border: 1px solid var(--border); border-top: 2px solid var(--gold); border-radius: 0 0 var(--r) var(--r); padding: 18px; min-height: 226px; display: flex; flex-direction: column; gap: 8px; box-shadow: var(--shadow-rest); transition: transform .18s ease, box-shadow .18s ease; }
.market-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-raised); }
.market-card.proxy { border-color: rgba(181,122,34,.55); background: linear-gradient(180deg, rgba(181,122,34,.07), var(--card) 42%); }
.market-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 4px; }
.market-code { font-family: var(--mono); font-size: 11px; color: var(--gold); font-weight: 700; letter-spacing: .8px; }
.market-status { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: .7px; color: var(--teal); background: rgba(13,118,110,.08); border: 1px solid rgba(13,118,110,.16); border-radius: 20px; padding: 3px 8px; white-space: nowrap; }
.market-card.proxy .market-status { color: var(--gold); background: rgba(181,122,34,.1); border-color: rgba(181,122,34,.2); }
.market-card h3 { font-family: var(--serif); font-size: 20px; line-height: 1.05; }
.market-exchange { font-size: 12px; color: var(--teal); font-weight: 600; font-style: italic; margin-bottom: 2px; }
.market-finance-row { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 7px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); font: 700 10px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }
.market-finance-row span:last-child { color: var(--teal); text-align: right; }
.market-card p { font-size: 12px; color: var(--sub); line-height: 1.45; }
.market-card p strong { color: var(--text); }
.market-note { margin-top: 12px; padding: 12px 14px; border-left: 2px solid var(--gold); background: rgba(181,122,34,.06); font-size: 12px; color: var(--sub); }
.regional-sources { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
.regional-sources span { font-size: 10px; color: var(--muted); border: 1px solid var(--border); border-radius: 20px; padding: 4px 9px; background: rgba(255,252,244,.55); }
.news-head { display:flex; justify-content:space-between; gap:18px; align-items:end; flex-wrap:wrap; margin-bottom:14px; }
.news-filters { display:flex; flex-wrap:wrap; gap:6px; margin:12px 0 16px; }
.news-filter { border:1px solid var(--border); background:var(--card); color:var(--sub); border-radius:20px; padding:5px 10px; font:600 10px var(--sans); text-transform:capitalize; cursor:pointer; }
.news-filter.active { background:var(--ink); border-color:var(--ink); color:var(--bg); }
.news-filter.country { border-style:dashed; }
.news-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.news-card { background:var(--card); border:1px solid var(--border); border-top:2px solid var(--teal); padding:16px; display:grid; gap:8px; box-shadow:var(--shadow-rest); }
.news-card.lead { grid-column:span 2; border-top-color:var(--gold); }
.news-card[hidden] { display:none; }
.news-meta { display:flex; gap:9px; flex-wrap:wrap; font:700 8px var(--mono); text-transform:uppercase; letter-spacing:.6px; color:var(--muted); }
.news-card h3 { font:700 18px/1.16 var(--serif); }
.news-card p { font-size:11.5px; line-height:1.5; color:var(--sub); }
.news-tags { display:flex; flex-wrap:wrap; gap:5px; }
.news-tags span { font:700 8px var(--mono); text-transform:uppercase; color:var(--teal); background:rgba(13,118,110,.08); padding:3px 6px; border-radius:3px; }
.news-tags span.topic { color:var(--gold); background:rgba(181,122,34,.08); }
.news-card footer { font:10px var(--mono); color:var(--muted); border-top:1px solid var(--border); padding-top:8px; }
.map-news-list { grid-column:1/-1; display:grid; gap:5px; padding-top:8px; border-top:1px solid var(--border); }
.map-news-list a { font-size:11px; line-height:1.35; }
.source-registry { margin-top: 14px; background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; display: grid; gap: 12px; box-shadow: var(--shadow-rest); }
.source-registry-head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.source-registry-head h3 { font-family: var(--serif); font-size: 19px; }
.source-registry-head span { font: 700 10px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .8px; }
.source-registry-group { display: grid; grid-template-columns: 170px 1fr; gap: 12px; padding-top: 10px; border-top: 1px solid var(--border); }
.source-registry-group strong { font-size: 12px; color: var(--text); }
.source-registry-group div { display: flex; flex-wrap: wrap; gap: 7px; }
.source-registry-group a { font-size: 10px; color: var(--sub); border: 1px solid var(--border); border-radius: 20px; padding: 4px 9px; background: rgba(255,252,244,.6); text-decoration: none; }
.source-registry-group a:hover { border-color: var(--teal); color: var(--teal); }
.market-chart-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
.market-chart-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; display: grid; gap: 9px; box-shadow: var(--shadow-rest); transition: transform .18s ease, box-shadow .18s ease; }
.market-chart-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-card); }
.market-chart-card.proxy { border-color: rgba(181,122,34,.5); }
.market-chart-card h3 { font-family: var(--serif); font-size: 17px; line-height: 1.12; }
.market-chart-card p { font-size: 12px; color: var(--sub); line-height: 1.4; }
.market-chart-card p strong { color: var(--text); }
.candle-chart-shell { border: 1px solid var(--border); background: #FAF3E7; padding: 6px 7px 2px; overflow: hidden; }
.candle-chart { display: block; width: 100%; height: auto; min-height: 126px; }
.candle-grid-line { stroke: rgba(69,90,80,.14); stroke-width: .7; stroke-dasharray: 2 3; }
.candle-baseline { stroke: var(--ink); stroke-width: 1; opacity: .62; }
.candle-wick { stroke: currentColor; stroke-width: 1.15; vector-effect: non-scaling-stroke; }
.candle-body { fill: currentColor; stroke: currentColor; stroke-width: .7; shape-rendering: crispEdges; }
.candle.up { color: var(--teal); }
.candle.down { color: var(--coral); }
.candle:focus { outline: none; filter: drop-shadow(0 0 2px currentColor); }
.candle-latest-line { stroke: var(--gold); stroke-width: .8; stroke-dasharray: 4 3; opacity: .85; }
.candle-latest-dot { fill: var(--gold); stroke: #FAF3E7; stroke-width: 1.5; }
.candle-axis-label, .candle-index-label { fill: var(--muted); font-family: var(--mono); font-size: 7px; letter-spacing: .4px; }
.candle-index-label { fill: var(--ink); font-size: 6.8px; font-weight: 700; letter-spacing: .65px; }
.candle-chart-caption { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 8px; }
