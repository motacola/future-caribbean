---
import Base from '../layouts/Base.astro';
import { loadDashboardData } from '../lib/data.ts';
import '../styles/desk.css';
const d = loadDashboardData();
---


<Base title="Abeng — the full desk">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script is:inline src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/htm@3/dist/htm.js"></script>
  </Fragment>

<div id="scroll-progress" aria-hidden="true"></div>

<div class="masthead">
  <div class="mast-edition"><span>Vol. I · Caribbean Edition</span><span title="When this page was built">Built {d.nowStr}</span></div>
  <div class="mast-inner">
    <div class="mast-brand">
      <div class="mast-name"><em>ABENG</em></div>
      <div class="mast-tagline">What changed. Who should act.</div>
    </div>
    <div class="mast-links">
      <a href="#decision-workspace" title={`Cycle ${d.cycleId}`}><span style="color:var(--teal)">●</span> Signals: {d.cycleLabel} cycle</a>
      <a href="/">Morning brief</a>
      <a href="/build">Build your feed</a>
      <a href="/regional-connections">Regional Connections</a>
      <a href="javascript:void(0)" onclick="toggleDeep();return false;">Under the hood</a>
    </div>
  </div>
</div>

<div class="livewire" role="marquee" aria-label="Latest signals from this cycle">
  <span class="lw-label">Live wire</span>
  <div class="lw-track">
    <div class="lw-rail" id="lw-rail"><Fragment set:html={d.tickerHtml} /></div>
    <div class="lw-rail" aria-hidden="true"><Fragment set:html={d.tickerHtml} /></div>
  </div>
</div>

<nav class="desknav" aria-label="Desks">
  <div class="desknav-inner">
    <a href="#front-page" class="dn-item">Front Page</a>
    <a href="#decision-workspace" class="dn-item dn-invest">Investment Desk</a>
    <a href="#regional-news" class="dn-item">Regional News</a>
    <a href="#market-watch" class="dn-item">Market Watch</a>
    <a href="#ask-desk" class="dn-item">Ask the Desk</a>
  </div>
</nav>

<section class="map-hero" id="main-content" role="main" aria-labelledby="map-title">
  <div class="front-grid">
    <div class="front-lede">
      <p class="sec-label" title={`Cycle ${d.cycleId}`}>The front page · {d.cycleLabel}</p>
      <h1 id="map-title">Where Caribbean opportunity is moving <em>now.</em></h1>
      <!-- A reader who has never seen this before needs to know what it IS
           before being told how to read it. The old standfirst described the
           map ("the bigger the pulse, the stronger the signal") to someone who
           did not yet know what the page was for; that instruction now sits
           with the map, in the how-to below. -->
      <p class="front-standfirst">Every four hours, Abeng reads what Caribbean governments, development banks, central banks, tender portals, exchanges and storm services publish — and flags the places where something has actually changed. No reporters, no opinions: {d.nCountries} markets and territories, watched around the clock, with the source attached to every claim.</p>
      <!-- The hero used to point at the payoff; now it delivers a piece of it.
           Country, call, confidence, who it is for, and the move — then the
           link down for the evidence. -->
      <a class="lead-peek" href="#decision-workspace">
        <span class="lead-peek-eyebrow">Lead this cycle · {d.lCountry}</span>
        <strong class="lead-peek-title">{d.lTitle}</strong>
        <span class="lead-peek-move">{d.leadAction}</span>
        <span class="lead-peek-meta">
          <span class="lead-peek-fact"><b>Confidence</b>{d.lGrade}</span>
          <span class="lead-peek-fact"><b>Best placed to act</b>{d.leadOwner}</span>
        </span>
        <span class="front-cta lead-peek-go">Read the full briefing</span>
      </a>
      <div class="how-to">
        <span class="fp-head">New here? How to read this page</span>
        <p class="how-to-what">It is a wire service for one region. Public records go in; a short, cited call on where money and risk are moving comes out. You do not need to follow markets to use it — start with the briefing.</p>
        <ol>
          <li><strong>The map</strong> shows where money and risk moved this cycle. Larger pulses mark stronger signals. Select a country for what the desk found.</li>
          <li><strong>The briefing</strong> below tells you what to do about the strongest signal, with the evidence attached.</li>
          <li><strong>Ask the desk</strong> anything — every answer comes straight from the data, cited.</li>
        </ol>
      </div>
      <div class="front-pointers">
        <span class="fp-head">Also this cycle</span>
        <Fragment set:html={d.frontPointersHtml} />
      </div>
    </div>
    <div class="front-map" id="front-page">
      <div class="map-shell">
        <div id="leaflet-map" role="application" aria-label="Map of watched Caribbean countries and territories with confidence pulses"></div>
        <button type="button" class="map-expand" id="map-expand" aria-expanded="false" aria-controls="map-overlay">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 1H1v5M10 1h5v5M10 15h5v-5M6 15H1v-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
          Expand
        </button>
      </div>
      <div class="regional-movement" aria-label="Countries with active signals and their freshness state">
        <div class="regional-movement-head">
          <span class="regional-movement-label">Regional movement</span>
          <span class="regional-movement-sub">select a country for what the desk found</span>
        </div>
        <div class="track-filter" role="group" aria-label="Filter regional movement by track">
          <button type="button" class="track-btn is-active" data-track-filter="all">All</button>
          <button type="button" class="track-btn" data-track-filter="opportunity">Opportunities</button>
          <button type="button" class="track-btn" data-track-filter="risk">Dislocation / Risk</button>
        </div>
        <Fragment set:html={d.regionalMovementHtml} />
      </div>
      <div class="map-finance-strip" aria-label="FX and market indicators for selected islands">
        <div class="map-finance-chip fx"><span>FX layer</span><strong>USD pegs + floats</strong></div>
        <div class="map-finance-chip market"><span>Equity layer</span><strong>JSE · TTSE · BSE</strong></div>
        <div class="map-finance-chip market"><span>Financial centres</span><strong>BISX · CSX · ECSE</strong></div>
        <div class="map-finance-chip fx"><span>Select any island</span><strong>Currency + market watch</strong></div>
      </div>
      <div class="map-foot">
        <div class="map-legend" aria-label="Signal kinds">
          <span><i style="background:#1D5FD0"></i>Investment</span>
          <span><i style="background:#22A3D6"></i>Climate</span>
          <span><i style="background:#E07A2E"></i>Procurement</span>
          <span><i style="background:#7B5CD6"></i>Market watch</span>
          <span><i style="background:#8A94A6"></i>Quiet</span>
        </div>
        <div class="map-caption"><b>Live feed</b><span>World Bank</span><span>IDB</span><span>NOAA</span><span>NDBC</span><span>CARICOM</span><span>CDB</span><span>JSE</span><span>TTSE</span><span>BSE</span><span>BISX</span><span>CSX</span><span>ECSE</span><span>XE</span></div>
      </div>
    </div>
  </div>
  <div class="map-drill" id="map-drill" aria-live="polite">
    <p class="map-drill-empty">Select a country to see what the desk found.</p>
  </div>
</section>

<!-- Persistent reader preferences. The desk already routes the same signal
     differently per persona; this makes that choice the reader's, carries it
     across the page, and gives followed markets a home. localStorage only —
     no account, no backend. -->
<div class="sec deskbar" id="deskbar">
  <div class="deskbar-row">
    <div class="deskbar-lens">
      <label class="deskbar-label" for="lens-select">Reading as</label>
      <select id="lens-select" class="deskbar-select">
        <option value="">Anyone</option>
        <option value="Diaspora Investor">Diaspora Investor</option>
        <option value="Ecosystem Builder">Ecosystem Builder</option>
        <option value="Regional Founder/Operator">Founder / Operator</option>
        <option value="Procurement Watcher">Procurement Watcher</option>
        <option value="Policy/Media">Policy / Media</option>
        <option value="Operations/Resilience">Operations / Resilience</option>
      </select>
      <span class="deskbar-hint" id="lens-hint"></span>
    </div>
    <div class="deskbar-follows">
      <span class="deskbar-label">Following</span>
      <div class="deskbar-chips" id="follow-chips"><span class="deskbar-none">Select a country on the map, then Follow.</span></div>
    </div>
  </div>
</div>

<!-- Expanded map. The live .map-shell and #map-drill are moved in here on
     open and returned to their placeholders on close, so there is only ever
     one Leaflet instance and its markers, zoom and selection survive. -->
<div class="map-overlay" id="map-overlay" hidden>
  <div class="map-overlay-inner" role="dialog" aria-modal="true" aria-labelledby="map-overlay-title">
    <div class="map-overlay-bar">
      <div>
        <span class="map-overlay-kicker" title={`Cycle ${d.cycleId}`}>Front page · {d.cycleLabel}</span>
        <strong id="map-overlay-title">Where Caribbean opportunity is moving</strong>
      </div>
      <button type="button" class="map-overlay-close" id="map-overlay-close">Close <kbd>Esc</kbd></button>
    </div>
    <div class="map-overlay-stage" id="map-overlay-stage"></div>
  </div>
</div>

<section class="sec sec-major" id="regional-news" aria-labelledby="regional-news-title">
  <div class="news-head">
    <div><div class="sec-label">Regional News Desk</div><h2 class="st" id="regional-news-title">What is moving across the Caribbean</h2><div class="ss">Newest and most relevant first. Headlines link to the publisher.</div></div>
    <span class="market-status">{d.regionalNewsCount} articles tracked</span>
  </div>
  <div class="news-filters" id="news-filters"><Fragment set:html={d.newsFilterHtml} /></div>
  <div class="news-grid" id="news-grid"><Fragment set:html={d.newsHtml} /></div>
</section>

<div class="sec band band-paper sec-major" id="decision-workspace">
  <div class="sec-label">Today's call</div>
  <div class="decision-shell">
    <div class="decision-main">
      <div class="dateline"><span class="dl-desk">Investment Desk</span><span class="dl-by">By the Desk</span><span class="dl-when" title={`Cycle ${d.cycleId}`}>{d.nowStr}</span></div>
      <div class="decision-kicker">
        <span class="decision-id" title={`${d.leadDispatchId} · Cycle ${d.cycleId}`}>Briefing {d.cycleLabel}</span>
        <span class="decision-status">{d.leadDelivery}</span>
      </div>
      <h2>{d.lTitle}</h2>
      <p class="decision-summary">{d.lRankingBasis}</p>
      <div class="decision-call">
        <label>The move · next {d.leadWindow}</label>
        <strong>{d.leadAction}</strong>
        <p>{d.leadRationale}</p>
      </div>
      <div class="decision-facts">
        <div class="decision-fact"><label>Best placed to act</label><strong>{d.leadOwner}</strong></div>
        <div class="decision-fact"><label>How solid is this</label><strong>{d.lGrade}</strong></div>
        <div class="decision-fact"><label>What's happened so far</label><strong>{d.leadFeedback}</strong></div>
      </div>
      <details class="meta-disclose"><summary>Why this is top of the page</summary><div class="meta-disclose-body">{d.lRanking}</div></details>
      <h3 class="check-title">Three checks before you commit</h3>
      <p class="check-sub">The desk has already pulled the evidence below — tick each one off before you spend more time or money.</p>
      <div class="checklist" id="lead-checklist" role="group" aria-label="Three checks before you commit">
        <div class="check-item" data-check="sector" role="checkbox" tabindex="0" aria-checked="false"><span class="check-box">✓</span><div><strong>Pin down which industry is driving this</strong><span>Big numbers hide specifics. Find the sectors actually creating the opening.</span></div></div>
        <div class="check-item" data-check="operator" role="checkbox" tabindex="0" aria-checked="false"><span class="check-box">✓</span><div><strong>Find two people on the ground</strong><span>Who is already doing business there — and what do they know that the data doesn't?</span></div></div>
        <div class="check-item" data-check="pipeline" role="checkbox" tabindex="0" aria-checked="false"><span class="check-box">✓</span><div><strong>Check for a concrete way in</strong><span>A live tender, a project, a partnership — something with a date on it.</span></div></div>
      </div>
      <p class="check-progress" id="check-progress" aria-live="polite">0 of 3 done</p>
      <Fragment set:html={d.validationPackHtml} />
      <div id="risk-area"></div>
      <div class="lead-disclaimer"><strong>A signal, not advice.</strong> The data points; people on the ground confirm.</div>
    </div>
    <aside class="decision-side">
      <div class="side-head">
        <span>One story, three seats</span>
        <h3>Who gets this briefing</h3>
      </div>
      <Fragment set:html={d.leadRoutesHtml} />
      <div class="decision-note"><strong>The decision on the table:</strong> {d.lDecision}</div>
    </aside>
  </div>
</div>

<div class="sec market-watch band band-ink sec-major" id="market-watch">
  <div class="market-head">
    <div>
      <div class="sec-label">Caribbean Market Watch</div>
      <h2 class="st">Every listed market, and the news that moved it this cycle</h2>
      <div class="ss">Official exchanges, regulators, and central banks. Market intelligence, not brokerage advice.</div>
    </div>
  </div>
  <div class="market-grid"><Fragment set:html={d.marketWatchHtml} /></div>
  <div class="market-chart-grid" aria-label="Stock market data charts and market activity indicators"><Fragment set:html={d.marketChartHtml} /></div>
  <details class="sec-accordion" id="source-registry">
    <summary>
      <span class="sec-label">Sources</span>
      <strong>Where every number on this board comes from</strong>
      <em>{d.sourceRegistrySummary}</em>
    </summary>
    <div class="market-note"><strong>Source policy:</strong> exchange prices and notices come from official exchanges or regulators first. News outlets are used for context and validation; social posts are discovery leads only.{d.regionalSourceHtml && <Fragment> Regional context sources include: <span class="regional-sources"><Fragment set:html={d.regionalSourceHtml} /></span></Fragment>}</div>
    <div class="source-registry">
      <Fragment set:html={d.sourceRegistryHtml} />
    </div>
  </details>
</div>

<div class="sec sec-minor">
  <div class="sec-label" id="more-wire">More from the wire</div>
  <div class="verdict-filter" id="verdict-filter" role="group" aria-label="Filter signals by what the desk recommends">
    <label>Filter:</label>
    <button class="verdict-btn active" data-verdict="all">All <span class="verdict-count" id="count-all">0</span></button>
    <button class="verdict-btn verified" data-verdict="advance">Worth acting on <span class="verdict-count" id="count-advance">0</span></button>
    <button class="verdict-btn mixed" data-verdict="hold">Needs another look <span class="verdict-count" id="count-hold">0</span></button>
    <button class="verdict-btn unverified" data-verdict="reject">Set aside <span class="verdict-count" id="count-reject">0</span></button>
  </div>
  <div class="sig-list" id="sig-list"><Fragment set:html={d.secSignals} /></div>
</div>

<div class="proof-band">
  <div class="proof-line">
    <div class="proof-cell"><span class="proof-k">{d.nCountries}</span><span class="proof-v">Markets watched</span></div>
    <div class="proof-cell"><span class="proof-k">{d.nSources}/6</span><span class="proof-v">Core sources live</span></div>
    <div class="proof-cell"><span class="proof-k">{d.nClusters}</span><span class="proof-v">Live signals</span></div>
    <div class="proof-cell"><span class="proof-k">{d.nPersonas}</span><span class="proof-v">Briefings routed</span></div>
    <div class="proof-cell"><span class="proof-k">4h</span><span class="proof-v">Update rhythm</span></div>
  </div>
</div>

<section class="theater" id="theater" aria-labelledby="theater-title">
  <div class="live-grid">
  <details class="sec-pane sec-accordion" id="ask-desk">
    <summary>
      <span class="sec-label">Got a question?</span>
      <strong>Ask the desk</strong>
      <em>It answers from today's data — with receipts, not guesswork.</em>
    </summary>
    <div id="ask-desk-root"></div>
  </details>
  <details class="theater-shell sec-accordion">
    <summary>
      <span class="sec-label">Behind the desk</span>
      <strong id="theater-title">Watch the desk work</strong>
      <em>The cycle log, event by event, as the desk builds today's briefings.</em>
    </summary>
    <div class="theater-head">
      <div class="theater-title">
        <span class="stream-mode" id="stream-mode">LIVE</span>
      </div>
      <div class="cycle-clock" id="cycle-clock">
        <span class="clock-item"><span class="clock-label">Next cycle:</span><span class="clock-value" id="next-cycle">—</span></span>
        <span class="clock-item"><span class="clock-label">Last:</span><span class="clock-value" id="last-cycle">—</span></span>
      </div>
      <button class="theater-toggle" id="theater-toggle" type="button">Pause</button>
    </div>
    <div class="theater-feed" id="theater-feed" aria-live="polite">
      <div class="theater-event event-source"><span class="theater-time">waiting</span><p><span>Waiting for the next run ↻</span></p></div>
    </div>
  </details>
  </div>
</section>

<div class="sec band band-paper" id="receipts">
  <details class="sec-accordion">
    <summary>
      <span class="sec-label">The desk's receipts</span>
      <strong>What the desk said — and how responses reshape the next cycle</strong>
      <em>Every briefing is recorded. Responses change what the desk prioritises next.</em>
    </summary>
  <div class="receipts-table"><Fragment set:html={d.receiptsHtml} /></div>
  <div class="receipts-boosts"><span class="fp-head">Current priorities, shaped by responses</span><Fragment set:html={d.boostsHtml} /></div>
  <details class="meta-disclose"><summary>How the desk records and calibrates this</summary><div class="meta-disclose-body">
    <Fragment set:html={d.receiptsProvenanceHtml} />
    <Fragment set:html={d.calibrationCommitmentHtml} />
  </div></details>
  <p class="receipts-foot">Machine-readable record: <a href="/api/track-record">/api/track-record</a></p>
  </details>
</div>

<div class="sec">
  <div class="sec-label">Ready to forward</div>
  <h2 class="st">Written to travel</h2>
  <div class="ss">Live outputs from today's cycle — made to be forwarded, not filed.</div>
  <div class="out-tabs" id="out-tabs" role="tablist" aria-label="Forwardable outputs">
    <button type="button" class="out-tab active" role="tab" id="out-tab-tg" aria-controls="out-panel-tg" aria-selected="true" data-out="tg">Telegram<span>Channel</span></button>
    <button type="button" class="out-tab" role="tab" id="out-tab-memo" aria-controls="out-panel-memo" aria-selected="false" tabindex="-1" data-out="memo">Investor Memo<span>Email</span></button>
    <button type="button" class="out-tab" role="tab" id="out-tab-alert" aria-controls="out-panel-alert" aria-selected="false" tabindex="-1" data-out="alert">Message Alert<span>WhatsApp</span></button>
    <button type="button" class="out-tab" role="tab" id="out-tab-policy" aria-controls="out-panel-policy" aria-selected="false" tabindex="-1" data-out="policy">Policy Brief<span>Document</span></button>
  </div>
  <div class="out-stage">
    <div class="out-panel" id="out-panel-tg" role="tabpanel" aria-labelledby="out-tab-tg" data-out="tg">
      <div class="out-body">{`Abeng

Today's lead: ${d.lCountry}

${d.lTitle}

Why it matters:
${d.lDecision}

Who this is for:
${d.leadOwner} first, with the route list in the desk.

Next step:
${d.leadAction}

How solid: ${d.lGrade}
Based on: ${d.lEvidence}

A signal, not advice.`}</div>
    </div>
    <div class="out-panel" id="out-panel-memo" role="tabpanel" aria-labelledby="out-tab-memo" data-out="memo" hidden>
      <div class="out-body">{`Caribbean Capital Momentum Brief

Lead market: ${d.lCountry}
The signal: ${d.lEvidence}

Why it matters:
${d.lDecision}

What to do:
${d.leadAction}

Why this ranks high:
${d.lRanking}

Before you act:
This is a pointer, not a recommendation. Check the sector, the local risks, and the people you'd be working with.

Abeng`}</div>
    </div>
    <div class="out-panel" id="out-panel-alert" role="tabpanel" aria-labelledby="out-tab-alert" data-out="alert" hidden>
      <div class="out-body">{`${d.lCountry} — lead signal

${d.lEvidence}

Watch: source-backed market movement, tender/procurement paths, local operators, and sector-specific proof.

Next: ${d.leadAction}

Screening signal only. Not investment advice.

Full brief: [link]`}</div>
    </div>
    <div class="out-panel" id="out-panel-policy" role="tabpanel" aria-labelledby="out-tab-policy" data-out="policy" hidden>
      <div class="out-body">{`Regional Investment Signal

Capital momentum is concentrating in ${d.lCountry}, with secondary movement noted in the regional wire.

Implications:
• Procurement and infrastructure pipelines may accelerate
• Professional services demand likely to increase
• Cross-border logistics and energy coordination opportunities

Monitoring recommended:
CDB and IDB project pipelines, trade data, and where the investment is landing by sector.

Source: World Bank indicators, 2023 to 2024 comparison.`}</div>
    </div>
  </div>
  <div class="out-foot">
    <button type="button" class="btn out-copy" id="out-copy">Copy to clipboard</button>
  </div>
</div>

<div class="sec" id="about-abeng">
  <div class="sec-label">What is Abeng?</div>
  <p class="abeng-line">The engine under this page. It reads the region's public data every four hours and checks signals against each other before they become briefings.</p>
  <div class="coordination-strip">
  <div class="coordination-inner">
    <div class="coord-step"><span>01</span><strong>Watch</strong><p>We read the region's public data so you don't have to.</p></div>
    <div class="coord-arrow">-></div>
    <div class="coord-step"><span>02</span><strong>Sift</strong><p>Weak signals get checked against each other and graded.</p></div>
    <div class="coord-arrow">-></div>
    <div class="coord-step"><span>03</span><strong>Brief</strong><p>The right person gets a clear next move, not a chart.</p></div>
    <div class="coord-arrow">-></div>
    <div class="coord-step"><span>04</span><strong>Learn</strong><p>Your response shapes what the desk sends next.</p></div>
  </div>
  </div>
  <p class="abeng-foot">Want this engine on a different market? <a href="/build">Build your own feed →</a></p>
</div>

<div class="sec deep">
  <button class="deep-btn" id="db" onclick="toggleDeep()">▸ System audit</button>
  <div class="deep-c" id="dc">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:24px;margin-top:16px">
      <h3 style="font-family:var(--serif);font-size:18px;margin-bottom:4px">System audit</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Technical proof layer for reviewers.</p>
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px">
        <div>
          <h4 style="font-size:13px;margin-bottom:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">All themes ({d.nClusters})</h4>
          <Fragment set:html={d.allClustersHtml} />
        </div>
        <div>
          <h4 style="font-size:13px;margin-bottom:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">Counts</h4>
          <div style="font-size:13px;color:var(--sub);line-height:2">
            <div>Themes: {d.nClusters}</div>
            <div>Dispatches: {d.nPersonas}</div>
