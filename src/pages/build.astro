---
import Base from '../layouts/Base.astro';
import LollipopIsland from '../lib/charts/LollipopIsland.tsx';
import { opportunitiesFromDesk } from '../lib/charts/lollipop.ts';
import pipelineFixture from '../data/build-pipeline-fixture.json';
import dispatchDesk from '../../outbox/dispatch_desk.json';

// PIPELINE drives the interactive build-page walkthrough. It remains a
// labelled offline demo fixture; the ranked chart below reads the current
// published dispatch desk artifact instead.
// Sourced from
// src/data/build-pipeline-fixture.json so the in-script <script is:inline>
// block can also reference it (Astro frontmatter `const`s are not visible
// inside an inlined script).
const PIPELINE = pipelineFixture as any;
const _lollipop = opportunitiesFromDesk(dispatchDesk);
const lollipopData = {
  opportunities: _lollipop.opportunities,
  dataAsOf: _lollipop.dataAsOf,
  cycle: _lollipop.cycle,
};
---

<style is:global>
:root {
  --bg: #F4EBDD; --card: #FFFCF4; --card-alt: #EAF2EC;
  --ink: #18251F; --text: #18251F; --sub: #455A50; --muted: #7F8C83;
  --gold: #B57A22; --teal: #0D766E; --coral: #B94836; --sky: #2676A8; --lime: #B6C74E;
  --border: #D8CBB8; --border-dark: #AA9A82;
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Inter', -apple-system, system-ui, sans-serif;
  --mono: 'IBM Plex Mono', monospace;
  --r: 3px;
  /* caribbeanTheme tokens (mirrors src/lib/caribbean-theme.ts). */
  /* The chart island reads these from CSS custom properties so the */
  /* designer and the live site share the same palette. */
  --caribbean-bg: #FFFCF4;
  --caribbean-fg: #18251F;
  --caribbean-accent: #0c8ce9;
  --caribbean-inspect: #B57A22;
  /* sea / reef / sand / sun / storm — keep in sync with caribbean-theme.ts. */
  --caribbean-sea: #1dbdd3;
  --caribbean-reef: #36c98a;
  --caribbean-sand: #f2d94c;
  --caribbean-sun: #ff8a3d;
  --caribbean-storm: #315cff;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--sans); background: var(--bg); color: var(--text); line-height: 1.6; font-size: 15px; -webkit-font-smoothing: antialiased; }

.masthead { background: var(--ink); color: var(--bg); padding: 14px 0; }
.masthead::after { content: ""; display: block; height: 2px; margin-bottom: -2px; background: linear-gradient(90deg, var(--gold), var(--teal) 55%, transparent); opacity: .85; }
.mast-inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; }
.mast-name { font-family: var(--serif); font-size: 18px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--bg); text-decoration: none; }
.mast-name em { font-style: normal; color: var(--gold); }
.mast-links { display: flex; gap: 20px; align-items: center; }
.mast-links a { color: color-mix(in srgb, var(--bg) 62%, transparent); font-size: 12px; letter-spacing: .5px; text-transform: uppercase; font-weight: 500; text-decoration: none; }
.mast-links a:hover { color: var(--bg); }
.live-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #3fb950; font-weight: 600; }
.live-dot { width: 6px; height: 6px; border-radius: 50%; background: #3fb950; animation: pulse 2.4s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

.hero { max-width: 1100px; margin: 0 auto; padding: 52px 24px 40px; }
.hero-kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); font-weight: 600; margin-bottom: 14px; }
.hero-headline { font-family: var(--serif); font-size: clamp(30px, 4vw, 46px); font-weight: 700; line-height: 1.1; letter-spacing: -.5px; margin-bottom: 14px; }
.hero-headline em { font-style: italic; color: var(--teal); }
.hero-sub { font-size: 16px; color: var(--sub); max-width: 580px; line-height: 1.6; margin-bottom: 28px; }
.hero-stats { display: flex; gap: 28px; flex-wrap: wrap; }
.hero-stat { font-size: 12px; color: var(--muted); }
.hero-stat strong { color: var(--text); font-family: var(--mono); font-size: 13px; }

.builder-wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px 56px; }
.builder { display: grid; grid-template-columns: 380px 1fr; gap: 28px; align-items: start; }
@media(max-width:860px){ .builder { grid-template-columns: 1fr; } }

.controls { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 24px; position: sticky; top: 20px; }
.controls-title { font-family: var(--serif); font-size: 18px; font-weight: 700; margin-bottom: 20px; color: var(--text); }
.ctrl-group { margin-bottom: 20px; }
.ctrl-group:last-child { margin-bottom: 0; }
.ctrl-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); font-weight: 600; margin-bottom: 8px; display: block; }
.chips { display: flex; flex-wrap: wrap; gap: 7px; }
.chip { padding: 6px 13px; border-radius: 20px; font-size: 12px; font-weight: 500; cursor: pointer; border: 1px solid var(--border); background: var(--card); color: var(--sub); font-family: var(--sans); transition: all .12s; line-height: 1; }
.chip:hover { border-color: var(--teal); color: var(--teal); }
.chip.on { background: var(--teal); border-color: var(--teal); color: white; font-weight: 600; }
.chip-multi.on { background: rgba(14,124,123,.12); border-color: var(--teal); color: var(--teal); }

.preview-panel { display: flex; flex-direction: column; gap: 0; }
.preview-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px; }
.preview-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); font-weight: 600; }
.preview-meta { font-size: 12px; color: var(--teal); font-weight: 500; }
.preview-loading { display: none; font-size: 12px; color: var(--muted); padding: 8px 0; }

.device-wrap { border-radius: var(--r); overflow: hidden; border: 1px solid var(--border); min-height: 300px; }
.device-tg { background: #17212b; padding: 20px 16px; }
.device-tg .tg-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,.08); }
.device-tg .tg-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--teal); display: flex; align-items: center; justify-content: center; font-size: 14px; }
.device-tg .tg-name { font-size: 13px; font-weight: 600; color: #fff; }
.device-tg .tg-sub { font-size: 11px; color: #7d9ab5; }
.device-tg .tg-bubble { background: #2b5278; border-radius: 4px 12px 12px 12px; padding: 12px 14px; font-size: 13px; line-height: 1.65; color: #e8f0f8; white-space: pre-wrap; word-break: break-word; }
.device-tg .tg-time { font-size: 10px; color: #7d9ab5; text-align: right; margin-top: 6px; }
.device-wa { background: #0a1014; padding: 20px 16px; }
.device-wa .wa-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,.07); }
.device-wa .wa-avatar { width: 32px; height: 32px; border-radius: 50%; background: #25D366; display: flex; align-items: center; justify-content: center; font-size: 14px; }
.device-wa .wa-name { font-size: 13px; font-weight: 600; color: #e9edef; }
.device-wa .wa-sub { font-size: 11px; color: #8696a0; }
.device-wa .wa-bubble { background: #005c4b; border-radius: 4px 12px 12px 12px; padding: 12px 14px; font-size: 13px; line-height: 1.65; color: #e9edef; white-space: pre-wrap; word-break: break-word; }
.device-wa .wa-time { font-size: 10px; color: #8696a0; text-align: right; margin-top: 6px; }
.device-email { background: #f6f6f6; padding: 0; }
.device-email .email-chrome { background: #e8e8e8; padding: 8px 14px; font-size: 11px; color: #666; border-bottom: 1px solid #ddd; display: flex; gap: 6px; align-items: center; }
.device-email .email-chrome span { background: #fff; border: 1px solid #ccc; border-radius: 3px; padding: 2px 8px; font-size: 11px; color: #333; }
.device-email .email-body { background: #fff; padding: 24px; font-size: 13px; line-height: 1.7; color: #333; }
.device-email .email-subject { font-weight: 700; font-size: 15px; margin-bottom: 16px; color: #111; }
.device-email .email-from { font-size: 11px; color: #888; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px solid #eee; }
.device-email .email-text { white-space: pre-wrap; }
.device-memo { background: var(--card); padding: 28px; border-left: 3px solid var(--gold); }
.device-memo .memo-logo { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--gold); font-weight: 700; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
.device-memo .memo-text { font-family: var(--mono); font-size: 12px; line-height: 1.85; color: var(--text); white-space: pre-wrap; }

.signal-meta { background: var(--card-alt); border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--r) var(--r); padding: 14px 18px; display: flex; gap: 20px; flex-wrap: wrap; }
.meta-item { font-size: 11px; color: var(--muted); }
.meta-item strong { color: var(--text); font-size: 12px; }
.fallback-notice { background: rgba(199,154,59,.08); border: 1px solid rgba(199,154,59,.25); border-top: none; padding: 10px 18px; font-size: 12px; color: #8a6a1a; border-radius: 0 0 var(--r) var(--r); display: none; }

.cta-section { max-width: 1100px; margin: 0 auto; padding: 0 24px 64px; }
.cta-card { background: var(--text); border-radius: var(--r); padding: 32px 36px; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
.cta-copy h3 { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--bg); margin-bottom: 4px; }
.cta-copy p { font-size: 14px; color: var(--muted); max-width: 460px; line-height: 1.5; }
.cta-btns { display: flex; gap: 10px; flex-wrap: wrap; }
.btn-feed { padding: 11px 22px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: var(--sans); letter-spacing: .3px; transition: all .15s; white-space: nowrap; }
.btn-feed-primary { background: var(--gold); border: none; color: var(--text); }
.btn-feed-primary:hover { background: #d9a93f; }
.btn-feed-ghost { background: transparent; border: 1px solid rgba(255,255,255,.2); color: rgba(255,255,255,.75); }
.btn-feed-ghost:hover { border-color: rgba(255,255,255,.5); color: #fff; }

.engine-sec { max-width: 1100px; margin: 0 auto; padding: 0 24px 4px; }
.fresh-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 20px; }
.fresh-new { background: rgba(14,124,123,.14); color: var(--teal); }
.fresh-sustained { background: rgba(199,154,59,.16); color: #9a7a1f; }
.fresh-weakened { background: rgba(130,154,177,.18); color: var(--sub); }
.engine-head { margin-bottom: 22px; }
.engine-kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); font-weight: 600; margin-bottom: 8px; }
.engine-title { font-family: var(--serif); font-size: 26px; font-weight: 700; letter-spacing: -.3px; margin-bottom: 6px; }
.engine-sub { font-size: 15px; color: var(--sub); max-width: 660px; line-height: 1.6; }
.domain-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(188px,1fr)); gap: 12px; margin-bottom: 22px; }
.domain-card { text-align: left; background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; cursor: pointer; transition: all .15s; font-family: var(--sans); }
.domain-card:hover { border-color: var(--teal); transform: translateY(-2px); }
.domain-card.on { border-color: var(--teal); box-shadow: 0 0 0 1px var(--teal); background: var(--card-alt); }
.domain-name { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 8px; line-height: 1.3; }
.domain-badge { display: inline-block; font-size: 9px; text-transform: uppercase; letter-spacing: .8px; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
.badge-live { background: rgba(63,185,80,.14); color: #2f9e44; }
.badge-blueprint { background: rgba(130,154,177,.16); color: var(--sub); }
.domain-blurb { font-size: 12px; color: var(--muted); line-height: 1.5; margin-top: 8px; }
.domain-wired { font-family: var(--mono); font-size: 11px; color: var(--teal); margin-top: 8px; font-weight: 500; }
.instance-line code { font-family: var(--mono); font-size: 12px; background: var(--card-alt); border: 1px solid var(--border); padding: 1px 6px; border-radius: 4px; color: var(--text); }
.instance-line { font-size: 13px; color: var(--muted); margin-bottom: 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.instance-line .il-status { font-weight: 700; }
.il-live { color: #2f9e44; }
.il-blueprint { color: var(--sub); }
.pipeline { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; background: var(--card); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; margin-bottom: 8px; }
@media(max-width:760px){ .pipeline { grid-template-columns: 1fr; } .pipe-arrow { transform: rotate(90deg); padding: 8px 0; } }
.pipe-stage { padding: 20px; }
.pipe-num { font-family: var(--mono); font-size: 11px; color: var(--gold); font-weight: 600; letter-spacing: 1px; margin-bottom: 8px; }
.pipe-name { font-family: var(--serif); font-size: 17px; font-weight: 700; margin-bottom: 8px; }
.pipe-detail { font-size: 12.5px; color: var(--sub); line-height: 1.55; }
.pipe-arrow { display: flex; align-items: center; justify-content: center; color: var(--border-dark); font-size: 20px; padding: 0 4px; }
.reason-panel { background: var(--card-alt); border: 1px solid var(--border); border-left: 3px solid var(--gold); border-radius: var(--r); padding: 18px 20px; margin-top: 14px; }
.reason-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.reason-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--gold); font-weight: 600; }
.reason-engine { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .5px; padding: 2px 9px; border-radius: 20px; font-weight: 700; }
.reason-engine.eng-llm { background: rgba(14,124,123,.14); color: var(--teal); }
.reason-engine.eng-det { background: rgba(130,154,177,.16); color: var(--sub); }
.reason-thesis { font-size: 15px; color: var(--text); line-height: 1.6; margin-bottom: 12px; }
.reason-conns { list-style: none; display: flex; flex-direction: column; gap: 6px; }
.reason-conns li { font-size: 12.5px; color: var(--sub); padding-left: 16px; position: relative; line-height: 1.5; }
.reason-conns li::before { content: "→"; position: absolute; left: 0; color: var(--gold); }
.deploy-btn { margin-top: 14px; background: transparent; border: 1px dashed var(--border-dark); color: var(--teal); padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: var(--sans); transition: all .15s; }
.deploy-btn:hover { border-color: var(--teal); border-style: solid; background: rgba(14,124,123,.06); }
.wiz-field { margin-bottom: 12px; }
.wiz-field label { display: block; font-size: 11px; font-weight: 600; color: var(--sub); margin-bottom: 5px; }
.wiz-field input { width: 100%; background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 9px 12px; border-radius: 5px; font-size: 13px; font-family: var(--sans); }
.wiz-field input:focus { outline: none; border-color: var(--teal); }

.proof-section { max-width: 1100px; margin: 0 auto; padding: 0 24px 60px; }
.proof-toggle { background: transparent; border: 1px solid var(--border-dark); color: var(--muted); padding: 9px 18px; border-radius: 4px; font-size: 12px; cursor: pointer; font-family: var(--sans); letter-spacing: .3px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
.proof-toggle:hover { border-color: var(--text); color: var(--text); }
.proof-body { display: none; margin-top: 16px; background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 24px; }
.proof-body.open { display: block; }
.proof-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap: 12px; margin-bottom: 20px; }
.proof-stat { padding: 14px; background: var(--card-alt); border-radius: 6px; border: 1px solid var(--border); }
.proof-stat .ps-val { font-family: var(--mono); font-size: 22px; font-weight: 600; color: var(--text); margin-bottom: 2px; }
.proof-stat .ps-lbl { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .8px; }
.proof-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--teal); font-weight: 600; text-decoration: none; }
.proof-link:hover { text-decoration: underline; }
.src-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
.src-row:last-child { border-bottom: none; }
.src-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 8px; }
.src-ok { background: var(--teal); }
.src-off { background: var(--muted); }

.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 100; align-items: center; justify-content: center; }
.modal-overlay.open { display: flex; }
.modal-card { background: var(--card); border-radius: var(--r); padding: 36px; max-width: 460px; width: calc(100% - 32px); position: relative; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
.modal-card h3 { font-family: var(--serif); font-size: 22px; font-weight: 700; margin-bottom: 8px; }
.modal-card p { font-size: 14px; color: var(--sub); line-height: 1.6; margin-bottom: 20px; }
.modal-actions { display: flex; flex-direction: column; gap: 10px; }
.modal-btn { padding: 12px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1px solid var(--border); background: var(--card); color: var(--text); font-family: var(--sans); text-align: left; transition: all .12s; display: flex; align-items: center; gap: 10px; }
.modal-btn:hover { border-color: var(--teal); color: var(--teal); }
.modal-btn.primary { background: var(--text); border-color: var(--text); color: var(--bg); }
.modal-btn.primary:hover { background: #1a3a54; }
.modal-close { position: absolute; top: 16px; right: 16px; background: transparent; border: none; font-size: 18px; color: var(--muted); cursor: pointer; line-height: 1; padding: 4px; }
.modal-close:hover { color: var(--text); }
.modal-note { font-size: 11px; color: var(--muted); margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); line-height: 1.5; }

footer { border-top: 1px solid var(--border); padding: 24px; text-align: center; font-size: 11px; color: var(--muted); }

/* Live interventions — wired only when PUBLIC_PB_URL is configured. */
.pb-live-section { max-width: 1100px; margin: 0 auto; padding: 0 24px 32px; }
.pb-live-head { margin-bottom: 12px; }
.pb-live-label { font: 700 10px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: 1.3px; color: var(--gold, #b57a22); display: block; margin-bottom: 6px; }
.pb-live-head h3 { margin: 0 0 4px; font: 700 clamp(20px, 2.6vw, 28px)/1.1 'Cormorant Garamond', Georgia, serif; color: var(--ink, #18251f); }
.pb-live-sub { margin: 0; font-size: 12px; color: var(--muted, #455a50); line-height: 1.5; }
.pb-live-sub code { font-family: 'IBM Plex Mono', monospace; font-size: 11px; background: rgba(0,0,0,.04); padding: 1px 5px; border-radius: 3px; }
.pb-live-feed { min-height: 24px; }
.pb-live-feed:empty::before {
  content: "Awaiting live updates · static fallback active";
  display: block;
  padding: 14px 18px;
  background: rgba(0,0,0,.025);
  border: 1px dashed var(--border);
  border-radius: 6px;
  font: 700 11px 'IBM Plex Mono', monospace;
  letter-spacing: .5px;
  color: var(--muted);
  text-transform: uppercase;
}
.pb-live-item {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 6px;
  margin-bottom: 8px;
  background: rgba(255, 252, 244, .8);
}
.pb-live-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--gold, #b57a22); }
.pb-live-dot[data-status="verified"] { background: #2a8c5a; box-shadow: 0 0 0 3px rgba(42, 140, 90, .15); }
.pb-live-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.pb-live-body strong { font-weight: 600; font-size: 13px; color: var(--ink, #18251f); }
.pb-live-meta { font-size: 11px; color: var(--muted, #455a50); }

/* Ranked opportunity chart island (TanStack Charts, React island) */
.ranked-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px 36px;
}
.ranked-head { margin-bottom: 12px; }
.ranked-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: var(--gold, #b57a22);
  font-weight: 600;
  display: block;
  margin-bottom: 6px;
}
.ranked-section h2 {
  font-family: var(--serif, Georgia, serif);
  font-size: clamp(22px, 2.6vw, 30px);
  font-weight: 700;
  line-height: 1.15;
  margin-bottom: 6px;
  color: var(--text, #18251f);
}
.ranked-sub {
  font-size: 13px;
  color: var(--sub, #455a50);
  line-height: 1.55;
  margin-bottom: 14px;
}
.ranked-meta {
  font-family: var(--mono, monospace);
  font-size: 11px;
  color: var(--teal, #0d766e);
  background: rgba(13, 118, 110, .08);
  padding: 1px 5px;
  border-radius: 3px;
}
.ranked-foot {
