<script is:inline define:vars={{ PIPELINE }}>


const state = { persona:'investor', countries:['all'], signals:['all'], channel:'telegram', domain:'caribbean' };
let _previewText = '';

// lollipopData is computed in the frontmatter above and passed to the
// React island as serializable props. The chart definition is rebuilt
// client-side in src/lib/charts/LollipopIsland.tsx.
let _debounce = null;

function initChips(groupId, key, multi) {
  const group = document.getElementById(groupId);
  group.addEventListener('click', function(e) {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const val = chip.dataset.val;
    if (!multi) {
      group.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
      chip.classList.add('on');
      state[key] = val;
    } else {
      if (val === 'all') {
        group.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
        chip.classList.add('on');
        state[key] = ['all'];
      } else {
        const allChip = group.querySelector('[data-val="all"]');
        allChip && allChip.classList.remove('on');
        chip.classList.toggle('on');
        const active = [...group.querySelectorAll('.chip.on')].map(c => c.dataset.val);
        state[key] = active.length ? active : ['all'];
        if (!active.length) allChip && allChip.classList.add('on');
      }
    }
    schedulePreview();
    updateMeta();
  });
}
initChips('chips-persona','persona',false);
initChips('chips-countries','countries',true);
initChips('chips-signals','signals',false);
initChips('chips-channel','channel',false);

const PERSONA_LABELS = {investor:'Investor',founder:'Founder / Operator',policy:'Policy / Media',diaspora:'Diaspora'};
const CHANNEL_LABELS = {telegram:'Telegram',whatsapp:'WhatsApp',email:'Email',memo:'Briefing memo'};
function updateMeta() {
  const countries = state.countries.includes('all') ? 'All 13 countries' : state.countries.map(c => c.charAt(0).toUpperCase()+c.slice(1)).join(', ');
  document.getElementById('preview-meta').textContent = (PERSONA_LABELS[state.persona]||state.persona)+' · '+countries+' · '+(CHANNEL_LABELS[state.channel]||state.channel);
}

function schedulePreview() { clearTimeout(_debounce); _debounce = setTimeout(loadPreview, 220); }

function loadPreview() {
  const params = new URLSearchParams({persona:state.persona,countries:state.countries.join(','),signals:Array.isArray(state.signals)?state.signals.join(','):state.signals,channel:state.channel,domain:state.domain||'caribbean'});
  document.getElementById('preview-loading').style.display = 'block';
  fetch('/api/preview?'+params)
    .then(r => r.ok ? r.json() : null)
    .then(r => { document.getElementById('preview-loading').style.display='none'; if(r&&r.ok){renderPreview(r);}else{renderClientSide();} })
    .catch(() => { document.getElementById('preview-loading').style.display='none'; renderClientSide(); });
}

function renderPreview(r) {
  _previewText = r.formatted;
  renderDevice(state.channel, r.formatted, r.country);
  const meta = document.getElementById('signal-meta');
  meta.innerHTML = '<div class="meta-item"><strong>'+r.country+'</strong></div>'+'<div class="meta-item"><strong>'+r.confidence+'</strong></div>'+freshnessBadge(r.freshness)+'<div class="meta-item">'+r.source+'</div>'+(r.pct?'<div class="meta-item"><strong>'+r.pct+'</strong></div>':'')+(r.cycle_id?'<div class="meta-item">Cycle '+r.cycle_id+'</div>':'');
  const fn = document.getElementById('fallback-notice');
  if(r.fallback){fn.textContent='⚠ '+r.fallback_reason;fn.style.display='block';}else{fn.style.display='none';}
}

function renderClientSide() {
  const clusters = PIPELINE.clusters||[];
  if(!clusters.length){renderDevice(state.channel,'No signal data available.','Caribbean');return;}
  let working=clusters,fallback=false;
  if(!state.countries.includes('all')){const f=clusters.filter(c=>state.countries.some(co=>(c.country_cluster||'').toLowerCase().includes(co)));if(f.length)working=f;else fallback=true;}
  const sigTerms={investment:['investment','capital','fdi','surge'],procurement:['procurement','cdb','idb'],risk:['risk','vulnerability'],weather:['weather','marine','storm'],tourism:['tourism','logistics']};
  const sigs=Array.isArray(state.signals)?state.signals:[state.signals];
  if(!sigs.includes('all')){const terms=sigs.flatMap(s=>sigTerms[s]||[s]);const f=working.filter(c=>terms.some(t=>((c.title||'')+(c.evidence||'')).toLowerCase().includes(t)));if(f.length)working=f;}
  const c=working[0];
  const pTerms={investor:['investor','diaspora'],founder:['founder','operator','ecosystem'],policy:['policy','media'],diaspora:['diaspora']};
  const pts=pTerms[state.persona]||[state.persona];
  let pr=(c.personas||[]).find(p=>pts.some(t=>(p.persona||'').toLowerCase().includes(t)));
  if(!pr&&c.personas?.length)pr=c.personas[0];
  const country=c.country_cluster||'Caribbean';
  const ce=country.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  let ev=(c.evidence||'').replace(new RegExp('^\\s*'+ce+'\\s*:\\s*'),'').replace(new RegExp('\\s*:\\s*'+ce+'\\s*\\.?\\s*$'),'').replace(/\bWB\b/,'World Bank').replace(/FDI surge detected/,'FDI inflows rising').replace(/detected:\s*/,'').replace(/FDI surge/,'FDI movement').trim();
  const pct=(c.title||'').match(/([+\-]?\d+\.?\d*)%/)?.[0]||'';
  const action=(pr?.action||c.decision||'').slice(0,200);
  const grade=(c.evidence_grade||'C')[0].toUpperCase();
  const conf={A:'High confidence',B:'Moderate confidence',C:'Early signal'}[grade]||'Early signal';
  const pl={investor:'Diaspora Investor',founder:'Regional Founder',policy:'Policy / Media',diaspora:'Diaspora'}[state.persona]||state.persona;
  const pstr=pct?' ('+pct+')':'';
  let text='';
  if(state.channel==='telegram'){text='*Caribbean Opportunity Signal*\n\n*'+country+'* — '+conf+'\n\n'+ev+pstr+'\n\n*What to do ('+pl+'):*\n'+action+'\n\n_Screening signal only. Not investment advice._';}
  else if(state.channel==='whatsapp'){text='🌴 Caribbean Signal\n\n'+country+': '+ev+pstr+'\n\n'+action.slice(0,160)+'\n\nScreening signal only.';}
  else if(state.channel==='email'){text='Subject: '+country+' — '+conf.toLowerCase()+' market signal\n\n'+ev+pstr+'\n\nFor '+pl+':\n'+action+'\n\nSource: World Bank / IDB\nConfidence: '+conf+'\n\nScreening signal, not investment advice.\nSignal Fabric';}
  else{text='CARIBBEAN OPPORTUNITY BRIEF\n'+'─'.repeat(36)+'\nCountry:    '+country+'\nConfidence: '+conf+'\nAudience:   '+pl+'\n\nSIGNAL\n'+ev+pstr+'\n\nRECOMMENDED ACTION\n'+action+'\n\n'+'─'.repeat(36)+'\nScreening signal only. Not investment advice.\nSignal Fabric';}
  _previewText=text;
  renderDevice(state.channel,text,country);
  document.getElementById('signal-meta').innerHTML='<div class="meta-item"><strong>'+country+'</strong></div>'+'<div class="meta-item"><strong>'+conf+'</strong></div>'+'<div class="meta-item">World Bank / IDB / NOAA</div>'+(pct?'<div class="meta-item"><strong>'+pct+'</strong></div>':'');
  const fn=document.getElementById('fallback-notice');
  fn.style.display=fallback?'block':'none';
  if(fallback)fn.textContent='⚠ No exact match for selected countries this cycle. Showing nearest available signal.';
}

function renderDevice(channel,text,country) {
  const wrap=document.getElementById('device-wrap');
  const now=new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
  if(channel==='telegram'){
    wrap.className='device-wrap device-tg';
    wrap.innerHTML='<div class="tg-bar"><div class="tg-avatar">🌴</div><div><div class="tg-name">Signal Fabric</div><div class="tg-sub">Signal channel · '+(PIPELINE.n_sources||5)+'/6 sources live</div></div></div><div class="tg-bubble">'+fmtTg(text)+'</div><div class="tg-time">'+now+'</div>';
  }else if(channel==='whatsapp'){
    wrap.className='device-wrap device-wa';
    wrap.innerHTML='<div class="wa-bar"><div class="wa-avatar">🌴</div><div><div class="wa-name">Caribbean Signals</div><div class="wa-sub">Broadcast channel</div></div></div><div class="wa-bubble">'+esc(text)+'</div><div class="wa-time">'+now+'</div>';
  }else if(channel==='email'){
    const lines=text.split('\n');const subj=lines[0].replace('Subject: ','');const body=lines.slice(2).join('\n');
    wrap.className='device-wrap device-email';
    wrap.innerHTML='<div class="email-chrome"><span>From: Signal Fabric &lt;signal@cod.caribbean&gt;</span></div><div class="email-body"><div class="email-subject">'+esc(subj)+'</div><div class="email-from">Signal Fabric · '+now+'</div><div class="email-text">'+esc(body)+'</div></div>';
  }else{
    wrap.className='device-wrap device-memo';
    wrap.innerHTML='<div class="memo-logo">Signal Fabric — Intelligence Brief</div><div class="memo-text">'+esc(text)+'</div>';
  }
}

function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function fmtTg(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\*([^*]+)\*/g,'<strong>$1</strong>').replace(/_([^_]+)_/g,'<em>$1</em>');}

function openModal(){document.getElementById('modal').classList.add('open');}
function closeModal(){document.getElementById('modal').classList.remove('open');}
function openWizard(){document.getElementById('wizard').classList.add('open');}
function closeWizard(){document.getElementById('wizard').classList.remove('open');}

function submitWizard() {
  const btn=document.getElementById('wiz-submit'),status=document.getElementById('wiz-status');
  const payload={name:(document.getElementById('wiz-name').value||'').trim(),watch:(document.getElementById('wiz-watch').value||'').trim(),reason:(document.getElementById('wiz-reason').value||'').trim(),distribute:(document.getElementById('wiz-distribute').value||'').trim()};
  if(payload.name.length<3){status.textContent='⚠ Give the domain a name (3+ characters).';return;}
  btn.disabled=true;btn.textContent='Creating…';
  fetch('/api/domains/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(r=>r.json())
    .then(r=>{
      if(r&&r.ok&&r.domain){status.innerHTML='✓ Created <code style="font-family:var(--mono)">domains/'+r.domain.id+'.json</code> — added to the switcher.';loadDomains();setTimeout(()=>{closeWizard();activeDomain=r.domain.id;loadDomains();document.querySelector('.engine-sec').scrollIntoView({behavior:'smooth'});},900);}
      else{status.textContent='⚠ '+((r&&r.error)||'Could not create domain.');}
    })
    .catch(()=>{status.textContent='⚠ Could not reach the API.';})
    .finally(()=>{btn.disabled=false;btn.textContent='Create domain →';});
}

function copyBriefing() {
  if(!_previewText)return;
  navigator.clipboard.writeText(_previewText).then(()=>{const btn=event?.target;if(btn){const orig=btn.textContent;btn.textContent='✓ Copied';setTimeout(()=>btn.textContent=orig,2000);}}).catch(()=>alert(_previewText));
}

function toggleProof() {
  const body=document.getElementById('proof-body'),btn=document.getElementById('proof-btn');
  const open=body.classList.toggle('open');
  btn.querySelector('span').textContent=open?'▾':'▸';
}

// Astro scopes scripts that use define:vars. Keep a deliberately small
// public surface for the legacy inline controls rather than relying on
// function declarations leaking onto window.
Object.assign(window, { openModal, closeModal, openWizard, closeWizard, submitWizard, copyBriefing, toggleProof });

const SRC_VIEW=[{label:'World Bank Indicators',key:'world_bank'},{label:'IDB Open Data',key:'idb'},{label:'NOAA Weather Alerts',key:'noaa'},{label:'NDBC Marine Buoys',key:'ndbc'},{label:'CARICOM Statistics',key:'tier2'},{label:'CDB Procurement Feed',key:'tier2'}];
function setText(id,val){const el=document.getElementById(id);if(el&&val!=null)el.textContent=val;}

function pollStatus() {
  fetch('/api/status').then(r=>r.ok?r.json():null).then(s=>{
    if(!s)return;
    const sources=s.sources||{};
    const okCount=SRC_VIEW.filter(v=>sources[v.key]&&sources[v.key].ok).length;
    const ratio=okCount+'/6';
    setText('mast-sources',ratio);setText('hs-sources',ratio);
    if(s.n_clusters){setText('hs-signals',s.n_clusters);setText('pb-signals',s.n_clusters);}
    if(s.n_dispatches)setText('pb-dispatches',s.n_dispatches);
    const rows=document.getElementById('src-rows');
    if(rows&&Object.keys(sources).length){rows.innerHTML=SRC_VIEW.map(v=>{const ok=sources[v.key]&&sources[v.key].ok;return'<div class="src-row"><span><span class="src-dot '+(ok?'src-ok':'src-off')+'"></span>'+v.label+'</span><span style="font-size:12px;color:'+(ok?'var(--teal)':'var(--muted)')+'>'+(ok?'Live':'Offline')+'</span></div>';}).join('');}
    _lastCycleAt=s.generated_at?new Date(s.generated_at.replace(' ','T').replace(' UTC','Z')):null;
    _cadenceMs=(s.cadence_hours||4)*3600000;
    tickHeartbeat();
  }).catch(()=>{});
}

function freshnessBadge(f) {
  if(!f)return'';
  const map={new:['fresh-new','🆕 New this cycle'],sustained:['fresh-sustained','↗ Sustained'],weakened:['fresh-weakened','↘ Weakening']};
  const m=map[f];if(!m)return'';
  return'<div class="meta-item"><span class="fresh-badge '+m[0]+'">'+m[1]+'</span></div>';
}

let _lastCycleAt=null,_cadenceMs=4*3600000;
function tickHeartbeat() {
  if(!_lastCycleAt)return;
  const now=Date.now();
  const sinceMin=Math.max(0,Math.floor((now-_lastCycleAt.getTime())/60000));
  setText('hb-last',sinceMin<1?'just now':(sinceMin<60?sinceMin+'m ago':Math.floor(sinceMin/60)+'h '+(sinceMin%60)+'m ago'));
  let remain=_lastCycleAt.getTime()+_cadenceMs-now;
  if(remain<0)remain=0;
  const h=Math.floor(remain/3600000),m=Math.floor((remain%3600000)/60000),sec=Math.floor((remain%60000)/1000);
  setText('hb-next',(h?h+'h ':'')+m+'m '+String(sec).padStart(2,'0')+'s');
}
setInterval(tickHeartbeat,1000);
pollStatus();setInterval(pollStatus,30000);

let DOMAINS=[
  {id:'caribbean',name:'Caribbean Economic Signals',status:'live',blurb:'The live instance. 6 public sources, refreshed every 4 hours.',counts:{sources:6,sources_wired:6,signals:9,recipients:8},pipeline:{watch:'World Bank, IDB, NOAA, NDBC, NHC, CARICOM & CDB feeds across 13 Caribbean countries.',reason:'Detects FDI surges, procurement windows, risk flags & marine hazards. Each signal scored, graded, cross-validated.',distribute:'Routes role-specific briefings to investors, founders, policy & diaspora — Telegram, WhatsApp, email or memo.'}},
  {id:'climate',name:'Climate & Catastrophe Risk',status:'blueprint',blurb:'Reuses the marine & weather watchers already wired for the Caribbean.',counts:{sources:4,sources_wired:3,signals:3,recipients:3},pipeline:{watch:'NOAA, NDBC, NHC & hazard feeds — storms, surge, marine conditions in real time.',reason:'Scores exposure and escalates as an event develops toward a threshold.',distribute:'Briefs insurers, reinsurers & resilience planners before impact.'}},
  {id:'compliance',name:'Cross-Jurisdiction Compliance',status:'blueprint',blurb:'Same engine, pointed at regulatory data.',counts:{sources:2,sources_wired:0,signals:2,recipients:2},pipeline:{watch:'Regulatory gazettes, sanctions lists & policy releases across jurisdictions.',reason:'Maps new obligations to each entity and scores compliance risk as rules change.',distribute:'Alerts compliance & legal owners the moment an obligation shifts.'}},
  {id:'trade',name:'Supply Chain & Trade Flows',status:'blueprint',blurb:'Fragmented trade data unified into routed intelligence.',counts:{sources:3,sources_wired:1,signals:3,recipients:2},pipeline:{watch:'Port throughput, customs, shipping & trade-statistic feeds.',reason:'Detects volume shifts and bottlenecks, flags route & supplier risk.',distribute:'Alerts operators & logistics planners to disruption ahead.'}},
  {id:'capital',name:'Caribbean Capital Flows',status:'blueprint',blurb:'Cross-border capital momentum across Caribbean markets.',counts:{sources:2,sources_wired:1,signals:3,recipients:2},pipeline:{watch:'Caribbean public economic indicators at scale.',reason:'Detects cross-border capital momentum & convergence across markets.',distribute:'Dispatches to allocators & funds on the channels they use.'}},
];
let activeDomain='caribbean';

function renderDomains() {
  const strip=document.getElementById('domain-strip');
  strip.innerHTML=DOMAINS.map(d=>{
    const c=d.counts||{};
    const badge=d.status==='live'?'<span class="domain-badge badge-live">● Live</span>':'<span class="domain-badge badge-blueprint">Blueprint</span>';
    const wired=(c.sources_wired!=null)?'<div class="domain-wired">'+c.sources_wired+'/'+c.sources+' sources wired</div>':'';
    return'<button class="domain-card'+(d.id===activeDomain?' on':'')+'" data-domain="'+d.id+'"><div class="domain-name">'+d.name+'</div>'+badge+'<div class="domain-blurb">'+(d.blurb||'')+'</div>'+wired+'</button>';
  }).join('');
  strip.querySelectorAll('.domain-card').forEach(c=>c.addEventListener('click',()=>selectDomain(c.dataset.domain)));
}

function selectDomain(id) {
  const d=DOMAINS.find(x=>x.id===id)||DOMAINS[0];
  activeDomain=d.id;
  document.querySelectorAll('.domain-card').forEach(c=>c.classList.toggle('on',c.dataset.domain===d.id));
  const p=d.pipeline||{};
  document.getElementById('pipe-watch').textContent=p.watch||'';
  document.getElementById('pipe-reason').textContent=p.reason||'';
  document.getElementById('pipe-distribute').textContent=p.distribute||'';
  const c=d.counts||{};
  const line=document.getElementById('instance-line');
  if(d.status==='live'){
    line.innerHTML='<span class="il-status il-live">● Running now</span> — '+d.name+' is a live instance: '+c.sources_wired+'/'+c.sources+' sources wired, '+c.signals+' signal rules, '+c.recipients+' recipient roles. The preview below is generated from its real dispatches.';
    state.domain=d.id;loadPreview();
  }else{
    line.innerHTML='<span class="il-status il-blueprint">○ Config-ready</span> — '+d.name+' is defined by <code>domains/'+d.id+'.json</code> on the identical engine ('+c.sources_wired+'/'+c.sources+' sources wired). Not live in production yet; the preview stays on the Caribbean instance.';
    state.domain='caribbean';loadPreview();
  }
}

function loadDomains() {
  fetch('/api/domains').then(r=>r.ok?r.json():null).then(d=>{
    if(d&&d.ok&&Array.isArray(d.domains)&&d.domains.length){
      DOMAINS=d.domains;if(!DOMAINS.find(x=>x.id===activeDomain))activeDomain=DOMAINS[0].id;
      renderDomains();selectDomain(activeDomain);
    }
  }).catch(()=>{});
}

function loadReasoning() {
  fetch('/api/reasoning').then(r=>r.ok?r.json():null).then(r=>{
    if(!r||!r.ok)return;
    const eng=document.getElementById('reason-engine');const isLlm=r.engine==='llm';
    eng.className='reason-engine '+(isLlm?'eng-llm':'eng-det');
    eng.textContent=isLlm?('⚡ '+(r.model||'LLM')):'deterministic';
    document.getElementById('reason-thesis').textContent=r.thesis||'';
    const ul=document.getElementById('reason-conns');
    ul.innerHTML=(r.connections||[]).map(c=>'<li>'+c.replace(/</g,'&lt;')+'</li>').join('');
  }).catch(()=>{});
}

renderDomains();selectDomain('caribbean');loadDomains();loadReasoning();
updateMeta();loadPreview();
</script>

</Base>
