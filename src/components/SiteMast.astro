---
// The one masthead every inner page wears (BRAND.md §6): ink bar, gold
// nameplate with the tagline under it, gold→teal rule, the same sections in
// the same order. The homepage and /desk carry richer versions of the same
// bar; this is the shared one. Page-specific extras go in the slot.
interface Props { current?: string }
const { current = '' } = Astro.props;
const links = [
  ['/', 'Morning brief'],
  ['/desk', 'Full desk'],
  ['/desk#regional-news', 'News wire'],
  ['/market-momentum', 'Markets'],
  ['/regional-connections', 'Connections'],
];
---
<header class="site-mast">
  <div class="site-mast-inner">
    <a href="/" class="site-mast-name" aria-label="Abeng, morning brief">
      <span class="site-mast-word">Abeng</span>
      <span class="site-mast-tag">What changed. Who should act.</span>
    </a>
    <nav class="site-mast-links" aria-label="Sections">
      {links.map(([href, label]) => (
        <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>
      ))}
      <slot />
    </nav>
  </div>
</header>

<style>
  .site-mast { background-color: #0F1B2D; background-image: linear-gradient(160deg, #14243B, #0A1424 88%); color: var(--bg); }
  .site-mast::after { content: ""; display: block; height: 2px; background: linear-gradient(90deg, var(--gold), var(--teal) 55%, transparent); opacity: .85; }
  .site-mast-inner { max-width: 1180px; margin: 0 auto; padding: 14px clamp(16px, 4vw, 40px); display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .site-mast-name { display: grid; gap: 5px; text-decoration: none; }
  .site-mast-name:hover { text-decoration: none; }
  .site-mast-word { font-family: var(--serif); font-weight: 700; font-size: clamp(28px, 2.4vw, 34px); line-height: 1; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); }
  .site-mast-name:hover .site-mast-word { color: var(--gold-on-ink); }
  .site-mast-tag { font: 500 11px var(--mono); letter-spacing: 1.2px; text-transform: uppercase; color: rgba(241,244,249,.72); }
  .site-mast-links { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .site-mast-links a { font-size: 12px; font-weight: 500; letter-spacing: .8px; text-transform: uppercase; color: rgba(241,244,249,.72); text-decoration: none; text-underline-offset: 5px; }
  .site-mast-links a:hover, .site-mast-links a[aria-current] { color: var(--bg); text-decoration: underline; text-decoration-color: var(--gold-on-ink); }
  @media (max-width: 760px) {
    .site-mast-inner { flex-direction: column; align-items: flex-start; gap: 10px; }
    .site-mast-links { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; gap: 18px; scrollbar-width: none; }
    .site-mast-links a { white-space: nowrap; padding: 12px 0; }
  }
</style>
