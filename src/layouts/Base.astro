---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Signal Fabric — see where the region is moving', description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2318251F'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23B57A22'/%3E%3Ccircle cx='16' cy='16' r='10' fill='none' stroke='%23B57A22' stroke-opacity='.45' stroke-width='2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<slot name="head" />
</head>
<body>
<slot />

<script>
  // fe-site-motion: shared scroll-reveal for every page.
  // Marks direct section children as reveal targets; harmless without JS
  // because hiding only applies when .fe-reveal is present.
  (() => {
    if (!('IntersectionObserver' in window)) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;
    // Subpages use .masthead/.hero/.builder-wrap/.cards etc as top-level blocks.
    const SEL = '.hero, .sec, .builder-wrap, .cards, .proof-band, .sig-wrap, .receipts-table, .out-grid, .source-registry, .rmv-strip, .coordination-inner, .decision-shell, .hero-stats';
    const targets = document.querySelectorAll(SEL);
    if (!targets.length) return;
    targets.forEach((el, i) => {
      el.classList.add('fe-reveal');
      el.style.setProperty('--fe-d', Math.min(i, 6) * 0.06 + 's');
    });
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        e.target.classList.add('fe-in');
        io.unobserve(e.target);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
    targets.forEach(t => io.observe(t));
    setTimeout(() => document.querySelectorAll('.fe-reveal').forEach(el => el.classList.add('fe-in')), 1500);
  })();
</script>
</body>
</html>
