---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Signal Fabric — see where the region is moving', description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2318251F'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23B57A22'/%3E%3Ccircle cx='16' cy='16' r='10' fill='none' stroke='%23B57A22' stroke-opacity='.45' stroke-width='2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
