# Copy to /etc/abeng.env and chmod 600 — it holds the write-API token.
#   install -m 600 deploy/abeng.env.example /etc/abeng.env

# Port the server listens on.
PORT=8080

# Keep this on loopback when a reverse proxy terminates TLS in front.
# Set 0.0.0.0 only if the server itself faces the internet.
HOST=127.0.0.1

# REQUIRED behind a reverse proxy. Bound to loopback, the server rejects any
# request whose Host header is not loopback or listed here — a DNS-rebinding
# guard. Without your real domain in this list every request through the proxy
# answers 403 "Host is not allowed".
ABENG_CORS_ORIGINS=https://abeng.example.org

# Enables the approval-gated write endpoints (/api/feedback/apply,
# /api/delivery/*, /api/history/archive). Unset, they return 503 and the site
# stays entirely read-only. Present it per request as
# `Authorization: Bearer <token>` or `X-Desk-Admin-Token: <token>`.
DESK_ADMIN_TOKEN=

# Optional: live Telegram delivery. Sending is dry-run until both are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
