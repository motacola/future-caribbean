{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/mcp",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Mcp-Session-Id, MCP-Protocol-Version"
      },
      "dest": "/api/mcp.py"
    },
    {
      "src": "/api/tools.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/tools.py"
    },
    {
      "src": "/api/validation-packs/(.+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/validation-packs.py?id=$1"
    },
    {
      "src": "/api/community-brief/(.+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/community-brief.py?format=$1"
    },
    {
      "src": "/api/coordination-opportunities/(.+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/coordination-opportunities.py?id=$1"
    },
    {
      "src": "/api/capability-matches",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/procurement-outcomes.py?view=capability_matches"
    },
    {
      "src": "/api/reasoning",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/artifact.py?doc=reasoning"
    },
    {
      "src": "/api/track-record",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/artifact.py?doc=track-record"
    },
    {
      "src": "/api/calibration",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/artifact.py?doc=calibration"
    },
    {
      "src": "/api/map-data",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/artifact.py?doc=map-data"
    },
    {
      "src": "/api/([^/]+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/$1.py"
    },
    {
      "src": "/dashboard.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/configurator.html",
      "status": 301,
      "headers": {
        "Location": "/build"
      }
    },
    {
      "src": "/build",
      "dest": "/build/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/signal/(.*)",
      "dest": "/signal/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [],
  "regions": [
    "iad1"
  ]
}
