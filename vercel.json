{
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "dist/**", "use": "@vercel/static" },
    { "src": "dashboard.html", "use": "@vercel/static" },
    { "src": "configurator.html", "use": "@vercel/static" },
    { "src": "dashboard/**", "use": "@vercel/static" },
    { "src": "outbox/**", "use": "@vercel/static" },
    { "src": "data/history/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/tools.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/tools.py"
    },
    {
      "src": "/api/validation-packs/(.+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/validation-packs.py?id=$1"
    },
    {
      "src": "/api/community-brief/(.+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/community-brief.py?format=$1"
    },
    {
      "src": "/api/([^/]+)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "dest": "/api/$1.py"
    },
    { "src": "/build", "dest": "/dist/build/index.html" },
    { "src": "/", "dest": "/dist/index.html" },
    { "src": "/dashboard.html", "dest": "/dashboard.html" },
    { "src": "/configurator.html", "dest": "/configurator.html" },
    { "src": "/feed.xml", "dest": "/outbox/feed.xml" },
    { "src": "/data/history/(.*)", "dest": "/data/history/$1" },
    { "src": "/llms.txt", "dest": "/llms.txt" },
    { "src": "/agents.md", "dest": "/agents.md" },
    { "src": "/(.*)", "dest": "/dist/$1" }
  ],
  "crons": [],
  "regions": ["iad1"]
}
