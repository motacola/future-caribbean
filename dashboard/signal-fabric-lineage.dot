  src_eccb -> w_eccb [label="fetches", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
  src_noaa -> w_noaa [label="fetches", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
  src_ndbc -> w_ndbc [label="fetches", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
  w_wb -> merger [label="normalized JSON", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
  w_idb -> merger [label="normalized JSON", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
  w_tier2 -> merger [label="normalized JSON", style=solid, fontname="Inter", fontsize=8, color="#7F8C83", penwidth=1.2];
