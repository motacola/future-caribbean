    "@tanstack/react-charts": "^0.11.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.0.0",
    "d3-scale": "^4.0.2",
    "hono": "^4.10.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^1.2.0"
