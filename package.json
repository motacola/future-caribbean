{
  "name": "future-caribbean",
  "private": true,
  "type": "module",
  "scripts": {
    "flue:dev": "flue dev --target node",
    "flue:build": "flue build --target node",
    "flue:run-cycle": "flue run run-cycle --target node --payload '{}'",
    "flue:ask": "flue run ask-dispatch --target node --payload",
    "flue:brief": "flue run generate-brief --target node --payload",
    "flue:artifacts": "flue run list-artifacts --target node --payload '{}'",
    "flue:notebook": "flue run open-notebook-sync --target node --payload",
    "flue:apply-feedback": "flue run apply-feedback --target node --payload '{}'",
    "flue:prepare-delivery": "flue run prepare-delivery --target node --payload",
    "flue:approve-delivery": "flue run approve-delivery --target node --payload",
    "flue:send-approved": "flue run send-approved --target node --payload",
    "flue:history": "flue run cycle-history --target node --payload",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:types": "tsc -p tsconfig.charts.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@flue/runtime": "^0.9.1",
    "@tanstack/charts": "^0.11.2",
    "@tanstack/charts-scales": "^0.11.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.0.0",
    "hono": "^4.13.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "^0.9.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "fast-xml-parser": "5.10.1",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "svgo": "4.0.2"
    }
  }
}
