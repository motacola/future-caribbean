# Abeng — delivery credentials
# Copy this to .env and fill in your values. .env is gitignored.

# ── Telegram ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → follow prompts
# 2. Add the bot to your channel as admin
# 3. Get the chat ID: message @userinfobot or check t.me/<channel>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Write API ─────────────────────────────────────────────
# Required to enable the approval-gated write endpoints
# (/api/feedback/apply, /api/delivery/*, /api/history/archive).
# Unset = writes are disabled and return 503. Present it per request as
# `Authorization: Bearer <token>` or `X-Desk-Admin-Token: <token>`.
DESK_ADMIN_TOKEN=
