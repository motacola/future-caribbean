# Future Caribbean Flue environment
# Copy values into your runtime environment or a local .env file.
# Never commit real secrets.

# Required if exposing Flue beyond localhost.
# Protects /agents, /workflows, and /runs routes.
FLUE_API_TOKEN=change-me

# Optional: model used by the dispatch-desk conversational agent endpoint.
# Deterministic workflows do not need an LLM model.
FLUE_MODEL=openai/gpt-5.5

# Optional Open Notebook bridge.
# Required only when Open Notebook auth is enabled.
OPEN_NOTEBOOK_API_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_TOKEN=change-me
# Or use OPEN_NOTEBOOK_PASSWORD instead of OPEN_NOTEBOOK_TOKEN.

# Optional live Telegram sending.
# send-approved defaults to dryRun=true; live sends require approval + dryRun=false.
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
