dist-flue/
dist/
node_modules/
.astro/

# Temp error logs
syntax_errors.log
syntax_errors.txt
ts_errors.log
ts_errors.txt

# Credentials — never commit
.env

# State files generated by delta distributors — not committed
.sent_*.json

# Python cache
__pycache__/
*.pyc

# Python packages installed by vercel build into project root
*.dist-info/
werkzeug/
urllib3/
certifi/
charset_normalizer/
idna/
requests/
*.so

# Per-source raw data/signal state — regenerated by pipeline, not needed for deploy
data/*/latest.json
signals/*/latest.md
.vercel

# Wizard-created domains (ephemeral demo instances)
domains/user-*.json

# Agent verification screenshots — not committed
output/

# Tender portal raw snapshots — regenerated each cycle
data/tenders/raw/

# Agent worktrees — scratch, never committed
.worktrees/

# Per-fetch RSS snapshots — regenerated each cycle
data/regional_news/raw/
